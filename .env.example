# Copy this file to .env and fill in the values before running docker compose.
#
# Or don't: `entkube-install` writes this file for you, generates the secrets, and starts the
# stack. See docs/installing.md. This file is the reference for doing it by hand.
#
# Only three values below have no default and must be set: DOMAIN, ACME_EMAIL and VAULT__ROOTKEY.

# --- Domain / TLS ---
# Public domain pointing at this server. Caddy will obtain a Let's Encrypt
# certificate automatically on first start. Port 80 and 443 must be reachable.
DOMAIN=entkube.example.com

# Email used for Let's Encrypt account registration and expiry notices.
ACME_EMAIL=admin@example.com

# --- Registry ---
# Registry to pull the entkube image from. entit.azurecr.io is public — pulls
# need no authentication and no `docker login`. Only override these if you host
# the image in your own registry.
#
# The published image is built for linux/amd64 AND linux/arm64, so an amd64 or an
# arm64 server both work. A "no matching manifest" pull error therefore means a tag
# that predates that, or a mirror built for one architecture only.
REGISTRY=entit.azurecr.io
IMAGE_TAG=latest

# Credentials for a PRIVATE registry. Leave unset for a public one — EntKube then
# pulls anonymously rather than refusing.
#
# One credential, two consumers:
#   1. EntKube pulls the Helm chart for EntKube-published components — helm runs
#      inside the entkube container and logs in with these.
#   2. The managed cluster pulls the image — EntKube writes a dockerconfigjson
#      Secret into the release namespace, because the cluster's kubelet does that
#      pull and EntKube's own session does not reach it.
# See docs/releasing.md.
# REGISTRY_USERNAME=
# REGISTRY_PASSWORD=

# --- Postgres ---
# Password used by both the postgres service and the app connection string.
#
# Postgres applies this only when the volume is FIRST initialised. Changing it
# later does not change the server's password — it only breaks the connection,
# with an authentication error that points at neither.
POSTGRES_PASSWORD=changeme

# --- Vault encryption ---
# 32-byte base64 key for secret encryption.
# Generate with: openssl rand -base64 32
#
# Back this up somewhere other than this host. It encrypts every secret in the
# vault, and without this exact key a restored database is unreadable — there is
# no recovery path and no way to re-derive it. Replacing it does not fail loudly:
# the app starts normally and every stored credential decrypts to nothing.
VAULT__ROOTKEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# --- Native telemetry / observability ---
# Logs, traces and RUM are indexed by the built-in segment engine; metrics are
# served by Prometheus. There is no telemetry database — Telemetry__PublicIngestUrl
# is derived from DOMAIN in docker-compose.yml, so override it there if clusters
# reach this server on another URL.
#
# Days of telemetry to retain before old sealed segments are dropped.
TELEMETRY_RETENTION_DAYS=14

# --- Object storage for sealed telemetry segments — optional ---
# Priority: a StorageLink registered in the app > the flat config in
# docker-compose.yml > local disk under /app/Data.
#
# The PRIMARY production answer is a StorageLink (AWS S3 / Cleura S3), whose
# credentials live in the vault rather than in this file.
#
# The bundled MinIO below is a self-hosted alternative on this same host. It is
# behind a compose profile, so it only starts if you ask for it:
#   docker compose --profile objectstore up -d
# Uncomment the Telemetry__ObjectStorage__* block in docker-compose.yml to use it.
#
# MinIO bakes these into its volume on first start, so the same caveat as
# POSTGRES_PASSWORD applies: changing them later does not change what MinIO expects.
# MINIO_ROOT_USER=entkube
# MINIO_ROOT_PASSWORD=changeme-minio
# TELEMETRY_BUCKET=entkube-telemetry

# --- Single sign-on (OIDC) — optional ---
# Leave OIDC_ENABLED=false (or unset) and none of this matters: no OIDC scheme is
# registered and the login page is unchanged. See docs/sso.md for the group->tenant
# mapping, which is configured in the UI under Admin -> Single sign-on.
#
# Register https://<DOMAIN>/signin-oidc as the redirect URI with your provider.
OIDC_ENABLED=false
# Issuer URL. Discovery is done from here.
#   Keycloak: https://keycloak.example.com/realms/entkube
#   Entra ID: https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_AUTHORITY=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Label on the login button.
OIDC_DISPLAY_NAME=Single sign-on
# Claim carrying group membership. Keycloak and Entra use "groups"; Entra emits
# group OBJECT IDS rather than names, and mappings must match exactly.
OIDC_GROUPS_CLAIM=groups
# Extra scope needed to receive that claim.
OIDC_SCOPE=groups
# false refuses a user whose groups map to no tenant, rather than signing them in
# with no access. Leave false unless you deliberately want the whole directory in.
OIDC_ALLOW_UNMAPPED=false

# --- Email / SMTP — optional, and a fallback ---
# An SMTP provider configured IN THE APP (Tenants -> <tenant> -> Notification
# providers) takes priority. These are used only when no SMTP provider is enabled
# there, so they are a reasonable way to get alert email working before any tenant
# exists. Configure either, or neither — with no host set, email notifications are
# skipped with a warning rather than failing.
#
# These are read from the app's configuration, not from this file directly: add them
# to the entkube service's environment in docker-compose.yml as Smtp__Host and so on.
# Smtp__Host=smtp.example.com
# Smtp__Port=587
# Smtp__Username=
# Smtp__Password=
# Smtp__FromAddress=alerts@entkube.io
