# Copy this file to .env and fill in the values before running docker compose.

# --- Domain / TLS ---
# Public domain pointing at this server. Caddy will obtain a Let's Encrypt
# certificate automatically on first start. Port 80 and 443 must be reachable.
DOMAIN=entkube.example.com

# Email used for Let's Encrypt account registration and expiry notices.
ACME_EMAIL=admin@example.com

# --- Registry ---
# Registry to pull the entkube image from. entit.azurecr.io is public — pulls
# need no authentication and no `docker login`. Only override these if you host
# the image in your own registry.
REGISTRY=entit.azurecr.io
IMAGE_TAG=latest

# --- Postgres ---
# Password used by both the postgres service and the app connection string.
POSTGRES_PASSWORD=changeme

# --- Native telemetry / observability ---
# Password for the dedicated postgres-telemetry instance backing the native
# telemetry store (Logs / Traces / Metrics / Dashboards / RUM). Keep it distinct
# from POSTGRES_PASSWORD. If unset, the Telemetry connection stays enabled but
# the two DBs share nothing else. Telemetry__PublicIngestUrl is derived from DOMAIN
# in docker-compose.yml; override there if clusters reach this server on another URL.
TELEMETRY_POSTGRES_PASSWORD=changeme
# Days of telemetry to retain before old daily partitions are dropped.
TELEMETRY_RETENTION_DAYS=14

# --- Vault encryption ---
# 32-byte base64 key for secret encryption.
# Generate with: openssl rand -base64 32
VAULT__ROOTKEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# --- Single sign-on (OIDC) — optional ---
# Leave OIDC_ENABLED=false (or unset) and none of this matters: no OIDC scheme is
# registered and the login page is unchanged. See docs/sso.md for the group->tenant
# mapping, which is configured in the UI under Admin -> Single sign-on.
#
# Register https://<DOMAIN>/signin-oidc as the redirect URI with your provider.
OIDC_ENABLED=false
# Issuer URL. Discovery is done from here.
#   Keycloak: https://keycloak.example.com/realms/entkube
#   Entra ID: https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_AUTHORITY=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Label on the login button.
OIDC_DISPLAY_NAME=Single sign-on
# Claim carrying group membership. Keycloak and Entra use "groups"; Entra emits
# group OBJECT IDS rather than names, and mappings must match exactly.
OIDC_GROUPS_CLAIM=groups
# Extra scope needed to receive that claim.
OIDC_SCOPE=groups
# false refuses a user whose groups map to no tenant, rather than signing them in
# with no access. Leave false unless you deliberately want the whole directory in.
OIDC_ALLOW_UNMAPPED=false
