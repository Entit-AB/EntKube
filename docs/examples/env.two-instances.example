# .env for docker-compose.two-instances.yml — copy to `.env` next to it.
#
# ⚠️ Everything here is installation-wide. There is no per-instance .env, and there must not be:
# the three app containers read ONE shared environment anchor on purpose (see the compose file).
# The only per-instance setting in the whole deployment is Workers__RunSingletonWork, and it is
# written into the service blocks rather than taken from here, so it cannot be set once by mistake.

# ── Required ─────────────────────────────────────────────────────────────────────────────────────

# The public hostname. Caddy orders a certificate for it and clusters ship telemetry to it.
DOMAIN=entkube.example.com
ACME_EMAIL=ops@example.com

POSTGRES_PASSWORD=

# ⭐ The vault. One root key + one database = one vault, shared by every instance. Generate ONCE,
# for the installation, not once per container:
#     openssl rand -base64 32
# Losing it loses every stored secret; changing it on one container breaks that container only,
# and breaks it by failing to decrypt rather than by failing to start.
VAULT__ROOTKEY=

# ── Image ────────────────────────────────────────────────────────────────────────────────────────
# One tag for all three containers. Every instance runs EF migrations at boot, so two tags against
# one database is a migration race between different migration sets.
REGISTRY=entit.azurecr.io
IMAGE_TAG=latest
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# ── Telemetry object storage ─────────────────────────────────────────────────────────────────────
# Mandatory at two instances: sealed segments are the only tier every instance can read.
MINIO_ROOT_USER=entkube
MINIO_ROOT_PASSWORD=
TELEMETRY_BUCKET=entkube-telemetry
TELEMETRY_RETENTION_DAYS=14

# ── Auth ─────────────────────────────────────────────────────────────────────────────────────────
# Leave false once the first admin exists.
AUTH_ALLOW_REGISTRATION=false

# ── Single sign-on (optional; docs/sso.md) ───────────────────────────────────────────────────────
OIDC_ENABLED=false
OIDC_AUTHORITY=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=Single sign-on
OIDC_GROUPS_CLAIM=groups
OIDC_SCOPE=groups
OIDC_ALLOW_UNMAPPED=false
