<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
      <!-- Opts in to the System.Security.Cryptography.Pkcs pin (CVE-2026-84008); MailKit pulls it. -->
    <UsesMailKit>true</UsesMailKit>
</PropertyGroup>

  <ItemGroup>
    <!-- Mirrors EntKube.Web: the segment engine now lives in EntKube.Telemetry. -->
    <Using Include="EntKube.Telemetry" />
    <Using Include="EntKube.TelemetryNode" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.14.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EntKube.Web\EntKube.Web.csproj" />
    <ProjectReference Include="..\..\src\EntKube.TelemetryNode\EntKube.TelemetryNode.csproj" />
    <ProjectReference Include="..\..\src\EntKube.Agent\EntKube.Agent.csproj" />
    <ProjectReference Include="..\..\src\EntKube.Mcp\EntKube.Mcp.csproj" />
    <ProjectReference Include="..\..\src\EntKube.Cli\EntKube.Cli.csproj" />
    <ProjectReference Include="..\..\src\EntKube.Installer.Core\EntKube.Installer.Core.csproj" />
    <ProjectReference Include="..\..\src\EntKube.Installer\EntKube.Installer.csproj" />
    <ProjectReference Include="..\..\src\EntKube.Installer.Gui\EntKube.Installer.Gui.csproj" />
  </ItemGroup>


  <!--
    CVE-2025-6965 (GHSA-2m69-gcr7-jv3q, high): SQLitePCLRaw.lib.e_sqlite3 <= 2.1.11 ships a
    vulnerable SQLite, and it arrives here transitively through Microsoft.Data.Sqlite. The advisory
    records no patched package version and the nuspecs name no SQLite version, so the versions were
    read out of the shipped native libraries rather than inferred:

        2.1.11 -> SQLite 3.49.1   (vulnerable; the fix is in 3.50.2)
        2.1.14 -> SQLite 3.54.0   (fixed)
        3.50.3 -> SQLite 3.50.3   (fixed, but the 3.x line renumbers the package to track SQLite)

    2.1.14 keeps the native library on the same package line as the managed SQLitePCLRaw.core and
    bundle that Microsoft.Data.Sqlite depends on, so nothing else has to move.

    This bump is what exposed the AlertRoutingRules rebuild in
    20260611122519_AddClusterServers (SQLite); the two changes belong together, because the pin
    without that repair breaks every fresh SQLite install.
  -->
  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>
</Project>