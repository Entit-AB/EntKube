<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EntKube.Mcp</RootNamespace>
    <AssemblyName>entkube-mcp</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Like the egress agent, this ships as a single self-contained binary so a
         user can point an MCP client at one file with no runtime to install.
         The RuntimeIdentifier is set at publish time, not here. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../EntKube.ApiClient/EntKube.ApiClient.csproj" />
  </ItemGroup>

</Project>
