<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EntKube.Installer</RootNamespace>
    <AssemblyName>entkube-install</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Ships as a single self-contained binary, like the agent and the CLI. This one runs on a
         freshly provisioned server before EntKube exists, so it cannot assume a .NET runtime is
         present — installing one first would be the very step the installer exists to remove.
         RuntimeIdentifier is set at publish time, not here. See docs/installing.md. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../EntKube.Installer.Core/EntKube.Installer.Core.csproj" />
  </ItemGroup>

</Project>
