@using EntKube.Web.Data
@using EntKube.Web.Services
@using EntKube.Web.Services.Tickets
@using EntKube.Web.Services.Support
@using Microsoft.AspNetCore.Components.Authorization
@inject TicketService Tickets
@inject TicketOverviews Overviews
@inject TicketBulkService Bulk
@inject SupportDutyService Duty
@inject CurrentActor ActorService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject ToastService Toasts

@* ═══════════════════════════════════════════════════════════════════
   The open queue, worst first, with every §14.4 clock shown as time
   remaining rather than as a timestamp — what an operator needs to know
   is which one runs out first.

   Either one customer's tickets or a whole tenant's. The tenant-wide
   shape is the one an operator works from: one person answers every
   customer, and "which ticket runs out first" is a question that only has
   an answer across all of them.
   ═══════════════════════════════════════════════════════════════════ *@

@if (selectedTicketId is not null)
{
    <TicketDetail TenantId="DetailTenantId"
                  TicketId="selectedTicketId.Value"
                  TenantSlug="@TenantSlug"
                  OnBack="BackToQueue"
                  OnChanged="LoadAsync" />
}
else
{
<LoadingPanel Loading="@loading" Error="@error">
@if (!loading)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h6 class="mb-0">Open tickets</h6>
            <div class="text-muted small">
                Response and resolution times run inside each application's support window (§14.4).
            </div>
        </div>
        <div class="d-flex gap-2 align-items-center">
            @* Only when there is something to narrow. A queue that is already one customer's has
               nothing to choose between, and a filter offering one option is furniture. *@
            @if (spansCustomers && customers.Count > 1)
            {
                <select class="form-select form-select-sm" style="width: auto"
                        value="@(customerFilter?.ToString() ?? "")"
                        @onchange="OnCustomerFilterChanged">
                    <option value="">All customers (@queue.Count)</option>
                    @foreach ((Guid id, string name, int count) in customers)
                    {
                        <option value="@id">@name (@count)</option>
                    }
                </select>
            }
            <button class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh
            </button>
        </div>
    </div>

    @if (overviews is not null)
    {
        <ul class="nav nav-pills nav-sm mb-3 small" data-test="overviews">
            @foreach (TicketOverview o in Enum.GetValues<TicketOverview>())
            {
                <li class="nav-item">
                    <button class="nav-link py-1 px-2 @(o == overview ? "active" : "")" @onclick="() => ChooseOverview(o)">
                        @OverviewLabel(o)
                        <span class="badge @(o == overview ? "bg-light text-dark" : "bg-secondary") ms-1">@overviews[o].Count</span>
                    </button>
                </li>
            }
        </ul>
    }

    @if (selected.Count > 0)
    {
        <div class="border rounded p-2 mb-3 bg-light small d-flex flex-wrap gap-2 align-items-center" data-test="bulk-bar">
            <strong>@selected.Count selected</strong>
            <select class="form-select form-select-sm w-auto" @bind="bulkAction">
                <option value="">Change…</option>
                <option value="assign">Hand to</option>
                <option value="unassign">Put back in the queue</option>
                <option value="tag">Add tag</option>
                <option value="untag">Remove tag</option>
                <option value="remind">Set reminder</option>
                <option value="priority">Priority</option>
                <option value="note">Add a note</option>
                <option value="close">Close the resolved ones</option>
            </select>
            @switch (bulkAction)
            {
                case "assign":
                    @if (roster is { Count: > 0 })
                    {
                        <select class="form-select form-select-sm w-auto" @bind="bulkAssignee">
                            <option value="">— who —</option>
                            @foreach (SupportTechnician t in roster)
                            {
                                <option value="@t.UserId">@t.Name</option>
                            }
                        </select>
                    }
                    else
                    {
                        <span class="text-muted">Nobody is on the support rota.</span>
                    }
                    break;
                case "tag" or "untag":
                    <input class="form-control form-control-sm w-auto" placeholder="tag" @bind="bulkText" />
                    break;
                case "remind":
                    <input class="form-control form-control-sm w-auto" type="datetime-local" @bind="bulkWhen" />
                    break;
                case "priority":
                    <select class="form-select form-select-sm w-auto" @bind="bulkPriority">
                        @foreach (TicketPriority p in Enum.GetValues<TicketPriority>())
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                    <input class="form-control form-control-sm" style="min-width: 16rem" placeholder="Reason — §14.3 requires it" @bind="bulkText" />
                    break;
                case "note":
                    <input class="form-control form-control-sm" style="min-width: 16rem" placeholder="The note" @bind="bulkText" />
                    <div class="form-check m-0">
                        <input class="form-check-input" type="checkbox" id="bulk-visible" @bind="bulkVisible" />
                        <label class="form-check-label" for="bulk-visible">The customer sees this</label>
                    </div>
                    break;
            }
            @if (!string.IsNullOrEmpty(bulkAction))
            {
                <AsyncButton CssClass="btn-sm btn-primary" OnClick="ApplyBulkAsync">Apply</AsyncButton>
            }
            <button class="btn btn-sm btn-link ms-auto" @onclick="() => selected.Clear()">Clear selection</button>
        </div>
    }

    @if (visible.Count == 0)
    {
        <EmptyState Icon="bi-check2-circle" Title="Nothing open"
                    Message="@(queue.Count == 0 ? "No tickets are waiting." : "No tickets are waiting for this customer.")" />
    }
    else
    {
        @if (breaching.Count > 0)
        {
            <div class="alert alert-danger py-2 small mb-3">
                <span class="bi bi-exclamation-octagon me-1"></span>
                <strong>@breaching.Count</strong>
                @(breaching.Count == 1 ? "ticket has" : "tickets have") missed a response time that
                carries §14.6's penalty — 10% of the window fee each, up to three a year.
            </div>
        }

        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 1.5rem">
                            <input class="form-check-input" type="checkbox" aria-label="Select all"
                                   checked="@(visible.Count > 0 && visible.All(v => selected.Contains(v.Ticket.Id)))"
                                   @onchange="ToggleAll" />
                        </th>
                        <th>#</th>
                        <th>Prio</th>
                        <th>Ticket</th>
                        @if (spansCustomers)
                        {
                            <th>Customer</th>
                        }
                        <th>Status</th>
                        <th>Response</th>
                        <th>Resolution</th>
                        <th>Update</th>
                        <th>Escalation</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (TicketSlaStatus row in visible)
                    {
                        <tr class="@RowClass(row)" style="cursor: pointer"
                            @onclick="() => Open(row.Ticket)">
                            <td @onclick:stopPropagation="true">
                                <input class="form-check-input" type="checkbox" aria-label="@($"Select #{row.Ticket.Number}")"
                                       checked="@selected.Contains(row.Ticket.Id)"
                                       @onchange="e => ToggleOne(row.Ticket.Id, e)" />
                            </td>
                            <td class="text-muted small">@row.Ticket.Number</td>
                            <td>
                                <span class="badge @PriorityClass(row.Ticket.Priority)">@row.Ticket.Priority</span>
                                @if (row.Ticket.PriorityConfirmedAt is null)
                                {
                                    <div class="text-muted" style="font-size: .7rem"
                                         title="§14.3: the customer's view stands until the first assessment">
                                        unconfirmed
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold small">
                                    @row.Ticket.Title
                                    @if (TicketOverviews.ReminderDue(row.Ticket, now))
                                    {
                                        <i class="bi bi-alarm text-danger ms-1" title="@($"Reminder due{(row.Ticket.ReminderNote is null ? "" : $": {row.Ticket.ReminderNote}")}")"></i>
                                    }
                                    else if (row.Ticket.ReminderAt is not null)
                                    {
                                        <i class="bi bi-alarm text-muted ms-1" title="A reminder is set"></i>
                                    }
                                </div>
                                @if (row.Ticket.Tags.Count > 0)
                                {
                                    <div>
                                        @foreach (TicketTag tag in row.Ticket.Tags.OrderBy(t => t.Name, StringComparer.Ordinal))
                                        {
                                            <span class="badge bg-light text-muted border me-1" style="font-size: .65rem">@tag.Name</span>
                                        }
                                    </div>
                                }
                                <div class="text-muted" style="font-size: .75rem">
                                    @row.Ticket.SupportWindow
                                    @if (row.Ticket.Channel == TicketChannel.Monitoring)
                                    {
                                        <span class="ms-1" title="Opened by monitoring (§14.3)">
                                            <i class="bi bi-activity"></i>
                                        </span>
                                    }
                                    @if (row.Ticket.IsCallout)
                                    {
                                        <span class="badge bg-warning text-dark ms-1"
                                              title="P1 outside the bought window — call-out (§13)">call-out</span>
                                    }
                                </div>
                            </td>
                            @if (spansCustomers)
                            {
                                <td class="small">@(row.Ticket.Customer?.Name ?? "—")</td>
                            }
                            <td>
                                <span class="badge @StatusClass(row.Ticket.Status)">@row.Ticket.Status</span>
                                @if (row.Ticket.Assignee is string holder)
                                {
                                    <span class="badge bg-light text-dark border ms-1"
                                          title="@($"{holder} is working on this")">
                                        <i class="bi bi-person-check me-1"></i>@holder
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border ms-1"
                                          title="Nobody has taken this yet">unclaimed</span>
                                }
                            </td>
                            <td>@ClockCell(row.Response, "responded")</td>
                            <td>@ClockCell(row.Resolution, "resolved")</td>
                            <td class="small">
                                @if (row.UpdateDue is null)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else if (row.UpdateOverdue(now))
                                {
                                    <span class="badge bg-danger"
                                          title="@($"§14.4: the customer has heard nothing since {row.LastUpdateAt.ToLocalTime():MMM d HH:mm}")">
                                        update due
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">@Remaining(row.UpdateDue)</span>
                                }
                            </td>
                            <td class="small">
                                @if (row.EscalationDue is not null)
                                {
                                    <span class="@(row.EscalationDue <= now ? "text-danger fw-semibold" : "text-muted")">
                                        @Remaining(row.EscalationDue)
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
</LoadingPanel>
}

@code {
    /// <summary>One customer's queue. Leave unset and <see cref="TenantId"/> is used instead.</summary>
    [Parameter] public Guid? CustomerId { get; set; }

    /// <summary>
    /// Every customer's queue, for the tenant. Ignored when <see cref="CustomerId"/> is set.
    /// </summary>
    [Parameter] public Guid? TenantId { get; set; }

    /// <summary>
    /// The tenant's slug. Given, the open ticket lives in the address (<c>?ticket=N</c>), so it
    /// can be linked to, copied, bookmarked and reached with the back button.
    /// </summary>
    [Parameter] public string? TenantSlug { get; set; }

    /// <summary>The ticket to open, by number — from the address.</summary>
    [Parameter] public int? FocusTicketNumber { get; set; }

    /// <summary>
    /// The tenant the detail view acts as. Every ticket operation is scoped to it now, so the
    /// queue has to name one rather than letting the detail derive it from the ticket it loaded.
    ///
    /// <para>⚠️ Throws rather than guessing in the <see cref="CustomerId"/>-only mode. That mode
    /// has no caller in any markup — this component is rendered once, from TenantExplorer, always
    /// with a tenant — and a customer's queue cannot name a tenant without another lookup. If it
    /// is ever wired up, this says so instead of silently opening a ticket as nobody.</para>
    /// </summary>
    private Guid DetailTenantId => TenantId
        ?? throw new InvalidOperationException(
            "TicketQueue needs a TenantId to open a ticket: the CustomerId-only mode cannot "
            + "resolve one for the detail view.");

    private bool loading = true;
    private string? error;
    private DateTime now = DateTime.UtcNow;
    private List<TicketSlaStatus> queue = [];
    private Guid? selectedTicketId;

    /// <summary>Which customer's rows to show, when the queue spans several. Null is all of them.</summary>
    private Guid? customerFilter;

    /// <summary>Whose ticket each row is only needs saying when the rows are not all one customer's.</summary>
    private bool spansCustomers => CustomerId is null && TenantId is not null;

    private List<TicketSlaStatus> visible
    {
        get
        {
            IEnumerable<TicketSlaStatus> rows = overviews is not null ? overviews[overview] : queue;
            return customerFilter is Guid only ? [.. rows.Where(q => q.Ticket.CustomerId == only)] : [.. rows];
        }
    }

    // ---- Overviews and bulk changes (docs/helpdesk.md, phase 1) ----
    private Dictionary<TicketOverview, List<TicketSlaStatus>>? overviews;
    private TicketOverview overview = TicketOverview.Open;
    private HashSet<Guid> selected = [];
    private List<SupportTechnician>? roster;
    private string bulkAction = "";
    private string bulkText = "";
    private string bulkAssignee = "";
    private DateTime? bulkWhen;
    private bool bulkVisible;
    private TicketPriority bulkPriority = TicketPriority.P3;
    private int? openedNumber;

    private List<(Guid Id, string Name, int Count)> customers => [.. queue
        .GroupBy(q => q.Ticket.CustomerId)
        .Select(g => (g.Key, g.First().Ticket.Customer?.Name ?? "Unknown", g.Count()))
        .OrderBy(c => c.Item2, StringComparer.OrdinalIgnoreCase)];

    // Counted over what is shown: a filtered view claiming a breach that is not in it would send an
    // operator looking for a row that is not there.
    private List<TicketSlaStatus> breaching => [.. visible.Where(q => q.IsPenaltyDeviation)];

    private void OnCustomerFilterChanged(ChangeEventArgs e) =>
        customerFilter = Guid.TryParse(e.Value?.ToString(), out Guid id) ? id : null;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();

        // The address names a ticket: open it, if it is this tenant's. Only when the address
        // changed, so a reload after an action does not reopen one the operator just left.
        if (FocusTicketNumber != openedNumber)
        {
            openedNumber = FocusTicketNumber;
            selectedTicketId = FocusTicketNumber is int number && TenantId is Guid tenant
                ? await Tickets.FindByNumberAsync(tenant, number)
                : null;

            if (FocusTicketNumber is not null && selectedTicketId is null)
            {
                Toasts.Error($"There is no ticket #{FocusTicketNumber} here.");
            }
        }
    }

    private void Open(Ticket ticket)
    {
        if (TenantSlug is null)
        {
            selectedTicketId = ticket.Id;
            return;
        }

        Nav.NavigateTo(Nav.GetUriWithQueryParameter("ticket", ticket.Number));
    }

    private void BackToQueue()
    {
        if (TenantSlug is null)
        {
            selectedTicketId = null;
            return;
        }

        Nav.NavigateTo(Nav.GetUriWithQueryParameter("ticket", (int?)null));
    }

    private void ChooseOverview(TicketOverview o)
    {
        overview = o;
        selected.Clear();
    }

    private static string OverviewLabel(TicketOverview o) => o switch
    {
        TicketOverview.Open => "All open",
        TicketOverview.Mine => "Mine",
        TicketOverview.Unassigned => "Unassigned",
        TicketOverview.MyReminders => "My reminders due",
        TicketOverview.Reminders => "Reminders due",
        TicketOverview.Escalated => "Escalated",
        TicketOverview.Following => "Following",
        _ => o.ToString(),
    };

    private void ToggleOne(Guid id, ChangeEventArgs e)
    {
        if (e.Value is true) selected.Add(id); else selected.Remove(id);
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            selected.UnionWith(visible.Select(v => v.Ticket.Id));
        }
        else
        {
            selected.Clear();
        }
    }

    private async Task ApplyBulkAsync()
    {
        BulkChange? change = bulkAction switch
        {
            "assign" => roster?.Cast<SupportTechnician?>().FirstOrDefault(t => t!.Value.UserId == bulkAssignee) is { } to
                ? new BulkChange.Assign(to) : null,
            "unassign" => new BulkChange.Assign(null),
            "tag" => new BulkChange.AddTag(bulkText),
            "untag" => new BulkChange.RemoveTag(bulkText),
            "remind" => bulkWhen is DateTime local
                ? new BulkChange.Remind(TimeZoneInfo.ConvertTimeToUtc(
                    DateTime.SpecifyKind(local, DateTimeKind.Unspecified), BusinessCalendar.SwedishTime), null)
                : null,
            "priority" => new BulkChange.Prioritise(bulkPriority, bulkText),
            "note" => new BulkChange.Comment(bulkText, bulkVisible),
            "close" => new BulkChange.Close(),
            _ => null,
        };

        if (change is null)
        {
            Toasts.Error("Say what to change them to.");
            return;
        }

        try
        {
            string actor = await ActorService.NameAsync();
            List<BulkOutcome> outcomes = await Bulk.ApplyAsync(DetailTenantId, [.. selected], change, actor, DateTime.UtcNow);

            List<BulkOutcome> skipped = [.. outcomes.Where(o => o.Skipped is not null)];
            int done = outcomes.Count - skipped.Count;

            if (skipped.Count == 0)
            {
                Toasts.Success($"{done} ticket(s) changed.");
            }
            else
            {
                Toasts.Info($"{done} changed, {skipped.Count} left alone: "
                    + string.Join("; ", skipped.Take(5).Select(o => $"#{o.Number} — {o.Skipped}")));
            }

            selected.Clear();
            bulkAction = "";
            bulkText = "";
            await LoadAsync();
        }
        catch (ArgumentException ex)
        {
            Toasts.Error(ex.Message);
        }
    }

    private async Task<OverviewViewer> ViewerAsync()
    {
        AuthenticationState state = await AuthState.GetAuthenticationStateAsync();
        string? userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        return new OverviewViewer(userId, await ActorService.NameAsync());
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;

        try
        {
            now = DateTime.UtcNow;
            if (CustomerId is Guid customer)
            {
                queue = await Tickets.GetOpenQueueAsync(DetailTenantId, customer, now);
                overviews = null;
            }
            else if (TenantId is Guid tenant)
            {
                overviews = await Overviews.AllAsync(tenant, await ViewerAsync(), now);
                queue = overviews[TicketOverview.Open];
                roster ??= await Duty.GetActiveAsync(tenant);
                selected.IntersectWith(queue.Select(q => q.Ticket.Id));
            }
            else
            {
                queue = [];
                overviews = null;
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    /// <summary>
    /// A clock as an operator reads it: time left, or how far past it went. A paused clock
    /// says so rather than showing a deadline it does not have — §14.4 stops it while
    /// someone else is being waited on, and a paused ticket is not late.
    /// </summary>
    private RenderFragment ClockCell(ClockStatus clock, string metVerb) => builder =>
    {
        int seq = 0;

        if (!clock.Budget.Exists)
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "text-muted small");
            builder.AddAttribute(seq++, "title", "§14.4 sets no target for this priority");
            builder.AddContent(seq++, "no target");
            builder.CloseElement();
            return;
        }

        if (clock.MetAt is not null)
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", clock.Breached ? "text-danger small" : "text-success small");
            builder.AddContent(seq++, clock.Breached ? $"{metVerb} late" : metVerb);
            builder.CloseElement();
            return;
        }

        if (clock.Paused)
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "text-muted small");
            builder.AddAttribute(seq++, "title", "Waiting on another party — the clock is stopped (§14.4)");
            builder.AddContent(seq++, "paused");
            builder.CloseElement();
            return;
        }

        bool late = clock.Breached;

        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", late ? "text-danger fw-semibold small" : "small");
        builder.AddContent(seq++, Remaining(clock.Deadline));
        builder.CloseElement();
    };

    /// <summary>A deadline as time remaining, or how long ago it passed.</summary>
    private string Remaining(DateTime? deadline)
    {
        if (deadline is null)
        {
            return "—";
        }

        TimeSpan left = deadline.Value - now;
        string magnitude = Humanise(left.Duration());

        return left < TimeSpan.Zero ? $"{magnitude} over" : $"{magnitude} left";
    }

    private static string Humanise(TimeSpan span) => span switch
    {
        { TotalMinutes: < 60 } => $"{(int)span.TotalMinutes} min",
        { TotalHours: < 24 } => $"{(int)span.TotalHours} h",
        _ => $"{(int)span.TotalDays} d",
    };

    private string RowClass(TicketSlaStatus row) =>
        row.IsPenaltyDeviation ? "table-danger"
        : row.Response is { Breached: true } ? "table-warning"
        : "";

    private static string PriorityClass(TicketPriority priority) => priority switch
    {
        TicketPriority.P1 => "bg-danger",
        TicketPriority.P2 => "bg-warning text-dark",
        TicketPriority.P3 => "bg-info text-dark",
        _ => "bg-secondary",
    };

    private static string StatusClass(TicketStatus status) => status switch
    {
        TicketStatus.New => "bg-primary",
        TicketStatus.InProgress => "bg-info text-dark",
        TicketStatus.Waiting => "bg-secondary",
        TicketStatus.Resolved => "bg-success",
        TicketStatus.Rejected => "bg-dark",
        TicketStatus.Merged => "bg-dark",
        _ => "bg-light text-dark border",
    };
}
