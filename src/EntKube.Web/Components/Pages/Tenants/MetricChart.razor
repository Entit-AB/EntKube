@using EntKube.Web.Services

@* ═══════════════════════════════════════════════════════════════════════════
   MetricChart — a time-series as an SVG area chart with gradient fill.
   Purely server-rendered, no JS. With ShowAxes it grows a value scale (y) and
   a start/end time axis (x) plus faint gridlines — for full-size panels.
   Without it, it stays a compact sparkline (the default, for dashboard tiles).
   A non-finite value is a gap: its step keeps its place on the x axis and the
   line breaks there (see Segments).
   ═══════════════════════════════════════════════════════════════════════════ *@

<div class="metric-chart-container">
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="d-flex justify-content-between align-items-center mb-1">
            <small class="text-muted fw-medium">@Title</small>
            @if (LatestFinite is not null)
            {
                <small class="fw-bold @GetValueColorClass()">@CurrentValue</small>
            }
        </div>
    }

    @if (DataPoints.Count >= 2 && LatestFinite is not null)
    {
        <div style="@(ShowAxes ? $"display:grid;grid-template-columns:auto 1fr;grid-template-rows:{HeightPx}px auto;column-gap:6px;" : "")">
            @if (ShowAxes)
            {
                <div class="chart-axis-y" style="grid-column:1;grid-row:1;">
                    <span>@AxisLabel(MaxVal)</span>
                    <span>@AxisLabel(MaxVal / 2)</span>
                    <span>0</span>
                </div>
            }
            <div style="@(ShowAxes ? "grid-column:2;grid-row:1;min-width:0;" : "")">
                <svg viewBox="0 0 @Width @Height" preserveAspectRatio="none"
                     style="width: 100%; height: @(HeightPx)px; display: block;">
                    <defs>
                        <linearGradient id="@GradientId" x1="0%" y1="0%" x2="0%" y2="100%">
                            <stop offset="0%" style="stop-color: @Color; stop-opacity: 0.3;" />
                            <stop offset="100%" style="stop-color: @Color; stop-opacity: 0.02;" />
                        </linearGradient>
                    </defs>

                    @if (ShowAxes)
                    {
                        @* Recessive baseline / mid / top gridlines (non-scaling so they stay hairline). *@
                        @foreach (double gy in GridLines)
                        {
                            <line x1="0" y1="@gy.ToString("F1", Inv)" x2="@Width" y2="@gy.ToString("F1", Inv)"
                                  stroke="currentColor" stroke-opacity="0.12" stroke-width="1" vector-effect="non-scaling-stroke" />
                        }
                    }

                    @* Area fill below the line *@
                    <path d="@AreaPath" fill="url(#@GradientId)" />

                    @* The line itself: one polyline per run of finite points, so a gap stays a gap. *@
                    @foreach (string points in LinePaths)
                    {
                        <polyline points="@points" fill="none" stroke="@Color" stroke-width="1.5"
                                  stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
                    }
                </svg>
            </div>
            @if (ShowAxes)
            {
                <div class="chart-axis-x" style="grid-column:2;grid-row:2;">
                    <span>@TimeLabel(DataPoints[0].Timestamp)</span>
                    <span>@TimeLabel(DataPoints[^1].Timestamp)</span>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-2">
            <small class="text-muted">Insufficient data</small>
        </div>
    }
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public List<TimeSeriesDataPoint> DataPoints { get; set; } = [];
    [Parameter] public string Color { get; set; } = "#0d6efd";
    [Parameter] public string? Unit { get; set; }
    [Parameter] public int HeightPx { get; set; } = 60;
    [Parameter] public double? MaxValue { get; set; }
    /// <summary>Show a value (y) scale, a start/end time (x) axis, and gridlines. Off = bare sparkline.</summary>
    [Parameter] public bool ShowAxes { get; set; }

    private const int Width = 300;
    private const int Height = 80;
    private const int Padding = 2;

    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    /// <summary>
    /// ⭐ Every SVG coordinate this component emits goes through here. SVG is not localized: its
    /// number grammar only knows <c>.</c> as a decimal point, and both the <c>points</c> list and
    /// the path data accept a comma <i>or</i> whitespace as the separator <i>between</i> numbers.
    ///
    /// <para>⚠️ The geometry used to be written with plain interpolation — <c>$"{x:F1},{y:F1}"</c>
    /// — which formats with <see cref="System.Globalization.CultureInfo.CurrentCulture"/>.
    /// EntKube.Web pins no culture (no RequestLocalization, no DefaultThreadCurrentCulture, and
    /// unlike Agent/Cli/Mcp/Installer no <c>InvariantGlobalization</c> in the csproj), so on this
    /// product's own Swedish hosts the pair <c>(2, 78)</c> came out as <c>"2,0,78,0"</c>. Nothing
    /// throws: the renderer reads four numbers where two were meant, every later pair shifts by
    /// one, and the result is a smooth line that was never plotted from the data — next to
    /// gridlines and axis labels that stayed correct because they already used <c>Inv</c>.
    /// Because <c>F1</c> always emits one decimal, a dot-culture host hides the bug completely and
    /// a comma-culture host breaks every point of it.</para>
    ///
    /// <para>This mirrors CostHistoryChart's <c>F()</c> and ResourceTreePanel's
    /// <c>FormattableString.Invariant</c> — invariant SVG geometry is the house rule.
    /// ⚠️ MultiSeriesChart.razor:111 still has the raw interpolation and the same bug; it is a
    /// different component and outside this change's unit.</para>
    /// </summary>
    private static string Coord(double value) => value.ToString("F1", Inv);

    private double[] GridLines => [Padding, Height / 2.0, Height - Padding];

    private string GradientId => $"grad-{Title?.GetHashCode():x}";

    // The value the top of the plot represents — an explicit MaxValue, else the peak of the
    // measured (finite) values, never ≤ 0. An infinite step as the peak would put every real
    // point on the floor and write "Infinity" on the axis.
    private double MaxVal
    {
        get
        {
            double[] finite = [.. DataPoints.Select(d => d.Value).Where(double.IsFinite)];
            double m = MaxValue ?? (finite.Length > 0 ? finite.Max() : 0);
            return m <= 0 ? 1 : m;
        }
    }

    /// <summary>The latest measured value, skipping trailing gaps; null when nothing was measured.</summary>
    private double? LatestFinite
    {
        get
        {
            for (int i = DataPoints.Count - 1; i >= 0; i--)
                if (double.IsFinite(DataPoints[i].Value)) return DataPoints[i].Value;
            return null;
        }
    }

    // Axis tick label: compact number + unit ("%" with no space, others spaced).
    private string AxisLabel(double v)
    {
        string s = v >= 100 ? v.ToString("F0") : v >= 10 ? v.ToString("F1") : v.ToString("F2");
        return string.IsNullOrEmpty(Unit) ? s : Unit == "%" ? s + "%" : $"{s} {Unit}";
    }

    private static string TimeLabel(DateTime t) => t.ToLocalTime().ToString("HH:mm");

    private string CurrentValue
    {
        get
        {
            if (LatestFinite is not double last)
            {
                return "";
            }

            string formatted = last >= 100 ? last.ToString("F0") : last.ToString("F1");
            return Unit is not null ? $"{formatted}{Unit}" : formatted;
        }
    }

    /// <summary>
    /// The plotted points, split into runs of consecutive finite values.
    ///
    /// <para>⚠️ Points are placed by list <b>index</b> — x = Padding + i·xStep over every step,
    /// gaps included. The p95 chart's NaN steps (histogram_quantile at a step with no requests)
    /// used to be dropped before they got here, which spread the surviving points over the whole
    /// width: the p95 line no longer lined up with the Requests and 5xx charts beside it, and a
    /// spike was drawn minutes away from the traffic that caused it. A non-finite value is kept as
    /// a step and ends the run; the next finite point starts a new one. Never NaN in an attribute:
    /// one NaN in an SVG coordinate list discards the rest of the shape.</para>
    /// </summary>
    private List<List<(double X, double Y)>> Segments()
    {
        List<List<(double X, double Y)>> segments = [];
        if (DataPoints.Count < 2) return segments;

        double maxVal = MaxVal;
        double xStep = (double)(Width - 2 * Padding) / (DataPoints.Count - 1);

        List<(double X, double Y)>? run = null;
        for (int i = 0; i < DataPoints.Count; i++)
        {
            double v = DataPoints[i].Value;
            if (!double.IsFinite(v))
            {
                run = null;
                continue;
            }

            if (run is null) segments.Add(run = []);
            double x = Padding + i * xStep;
            double y = Height - Padding - (v / maxVal * (Height - 2 * Padding));
            run.Add((x, y));
        }

        return segments;
    }

    /// <summary>
    /// One <c>points</c> list per run. A run of a single point — a measured step between two gaps
    /// — is written as a zero-length segment, which a round line cap renders as a dot; a
    /// one-point polyline would draw nothing and the measurement would vanish.
    /// </summary>
    private List<string> LinePaths =>
        [.. Segments().Select(run => run.Count == 1
            ? $"{Coord(run[0].X)},{Coord(run[0].Y)} {Coord(run[0].X)},{Coord(run[0].Y)}"
            : string.Join(" ", run.Select(p => $"{Coord(p.X)},{Coord(p.Y)}")))];

    /// <summary>
    /// The fill under the line: one closed subpath per run, from the baseline under its first
    /// point to the baseline under its last, so a gap is unfilled instead of bridged. With no
    /// gaps this is the single shape it always was, coordinate for coordinate.
    /// </summary>
    private string AreaPath
    {
        get
        {
            List<string> pathParts = [];
            foreach (List<(double X, double Y)> run in Segments())
            {
                pathParts.Add($"M {Coord(run[0].X)},{Coord(Height - Padding)}");
                foreach ((double x, double y) in run)
                    pathParts.Add($"L {Coord(x)},{Coord(y)}");
                pathParts.Add($"L {Coord(run[^1].X)},{Coord(Height - Padding)}");
                pathParts.Add("Z");
            }

            return string.Join(" ", pathParts);
        }
    }

    /// <summary>
    /// Red/amber/green for the header readout — ⭐ only for a chart that actually plots a
    /// percentage, i.e. one whose caller passed <c>Unit="%"</c>.
    ///
    /// <para>⚠️ The 90/70 cut-offs used to be applied to the raw last value of <i>any</i> series,
    /// which made the readout a health verdict about numbers that have no health. MetricsExplorer
    /// renders whatever metric the user picked out of Prometheus' <c>__name__</c> list with no
    /// Unit at all, so <c>jvm_memory_used_bytes</c> at 95 was danger red while
    /// <c>sum(rate(http_errors_total))</c> at 12 errors/s was success green; KeycloakMonitoringPanel's
    /// "Heap used" (Unit <c>B</c>) was red for any value above 90 bytes, i.e. always, and
    /// ClusterMonitoring's "Pod Count" turned red at 90 pods. Every other 90/70 comparison in the
    /// repo sits on a value whose name ends in Percent/pct; this was the one unconstrained site.</para>
    ///
    /// <para>Unitless and non-percent series now get the neutral readout that MultiSeriesChart —
    /// the sibling the explorer renders on the breakdown branch of the same <c>if</c> — has always
    /// used for an arbitrary series. The percent charts that meant to be coloured keep their
    /// colours: ClusterMonitoring's CPU and Memory pass <c>Unit="%" MaxValue="100"</c>.</para>
    /// </summary>
    private string GetValueColorClass()
    {
        if (LatestFinite is not double last || Unit != "%")
        {
            return "";
        }

        return last switch
        {
            >= 90 => "text-danger",
            >= 70 => "text-warning",
            _ => "text-success"
        };
    }
}
