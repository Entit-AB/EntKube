    private void CancelRestore()
    {
        restoreClusterId = null;
        restoreSnapshotName = null;
        restoreError = null;
        restoreLog = null;
    }

    private void ConfirmRestore(ElasticsearchCluster cluster)
    {
        // Side by side changes nothing that is live, so it runs on the button. In place replaces
        // data, and gets the same confirmation as any other destructive action here.
        if (!restoreInPlace)
        {
            _ = RunRestoreAsync(cluster);
            return;
        }

        pendingConfirm = new PendingConfirm(
            $"Restore \"{restoreSnapshotName}\" over the live indices matching \"{restoreIndexPattern}\" on \"{cluster.Name}\"? "
            + "They are closed and their contents replaced — anything written since the snapshot was taken is gone.",
            "Restore over live data",
            () => RunRestoreAsync(cluster));
    }

    private async Task RunRestoreAsync(ElasticsearchCluster cluster)
    {
        restoring = true;
        restoreError = null;
        restoreLog = null;
        try
        {
            string log = await Search.RestoreSnapshotAsync(
                TenantId, cluster.Id, restoreSnapshotName!, restoreIndexPattern,
                restoreInPlace ? ElasticsearchService.RestoreMode.InPlace : ElasticsearchService.RestoreMode.SideBySide,
                restorePrefix, restoreInPlace && restoreGlobalState, await Actor.NameAsync());

            // Show what Elasticsearch actually said rather than a claim that it worked.
            restoreLog = log;
            Toasts.Success($"Restored \"{restoreSnapshotName}\".");
        }
        catch (Exception ex)
        {
            restoreError = ex.Message;
        }
        finally { restoring = false; StateHasChanged(); }
    }

