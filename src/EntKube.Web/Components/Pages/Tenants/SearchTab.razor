    private static string PipelineSummary(ElasticsearchIngestPipeline p)
    {
        List<string> parts = [];
        if (!string.IsNullOrWhiteSpace(p.GrokPattern)) parts.Add($"grok on {p.GrokField}");
        if (!string.IsNullOrWhiteSpace(p.TimestampField)) parts.Add($"@timestamp from {p.TimestampField}");
        if (!string.IsNullOrWhiteSpace(p.RenameFields)) parts.Add("renames");
        if (!string.IsNullOrWhiteSpace(p.RemoveFields)) parts.Add("removals");
        if (!string.IsNullOrWhiteSpace(p.SetFields)) parts.Add("constants");
        if (!string.IsNullOrWhiteSpace(p.CustomProcessorsJson)) parts.Add("custom processors");
        return parts.Count == 0 ? "nothing yet" : string.Join(", ", parts);
    }

