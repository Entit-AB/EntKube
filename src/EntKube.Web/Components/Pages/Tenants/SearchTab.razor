    private sealed record PendingConfirm(string Message, string ConfirmText, Func<Task> Action);
    private PendingConfirm? pendingConfirm;
    private bool confirmBusy;

    private async Task RunPendingConfirmAsync()
    {
        if (pendingConfirm is null) return;
        confirmBusy = true;
        try { await pendingConfirm.Action(); }
        finally { confirmBusy = false; pendingConfirm = null; }
    }

    // ── Form model ────────────────────────────────────────────────────────────

    private sealed class TierEdit
    {
        public required string Key { get; init; }
        public required string Help { get; init; }
        public int Count { get; set; }
        public string Cpu { get; set; } = "";
        public string Memory { get; set; } = "";
        public string Storage { get; set; } = "";
    }

    private sealed class EsForm
    {
        public string Name { get; set; } = "";
        public Guid K8sClusterId { get; set; }
        public string Namespace { get; set; } = "search";
        public string Version { get; set; } = "9.5.0";
        public string? StorageClass { get; set; }
        public bool AllowMmap { get; set; } = true;
        public bool ZoneAware { get; set; }
        public bool KibanaEnabled { get; set; } = true;
        public int KibanaCount { get; set; } = 1;
        public string KibanaCpu { get; set; } = "500m";
        public string KibanaMemory { get; set; } = "1Gi";
        public bool Acknowledge { get; set; }
        public Guid Id { get; set; }

        public List<TierEdit> Tiers { get; init; } =
        [
            new TierEdit { Key = "master", Help = "Holds the cluster state and nothing else — the nodes whose health is the cluster's health.", Count = 3, Cpu = "500m", Memory = "2Gi", Storage = "5Gi" },
            new TierEdit { Key = "hot",    Help = "Takes every write, and holds the content indices Kibana's own state lives in.",              Count = 2, Cpu = "1",    Memory = "4Gi", Storage = "100Gi" },
            new TierEdit { Key = "warm",   Help = "Recent data that is still searched but no longer written to. 0 disables the tier.",          Count = 0, Cpu = "500m", Memory = "4Gi", Storage = "200Gi" },
            new TierEdit { Key = "cold",   Help = "Rarely searched data kept for retention rather than for speed. 0 disables the tier.",        Count = 0, Cpu = "500m", Memory = "2Gi", Storage = "500Gi" },
            new TierEdit { Key = "ingest", Help = "Dedicated ingest + coordinating nodes. 0 leaves the ingest role on the hot tier.",           Count = 0, Cpu = "1",    Memory = "2Gi", Storage = "1Gi" },
        ];

        public TierEdit Tier(string key) => Tiers.First(t => t.Key == key);

        public ElasticsearchCluster ToEntity() => new()
        {
            Id = Id,
            Name = (Name ?? "").Trim(),
            Namespace = (Namespace ?? "").Trim(),
            Version = (Version ?? "").Trim(),
            MasterCount = Tier("master").Count,
            MasterCpuRequest = Tier("master").Cpu,
            MasterMemory = Tier("master").Memory,
            MasterStorageSize = Tier("master").Storage,
            HotCount = Tier("hot").Count,
            HotCpuRequest = Tier("hot").Cpu,
            HotMemory = Tier("hot").Memory,
            HotStorageSize = Tier("hot").Storage,
            WarmCount = Tier("warm").Count,
            WarmCpuRequest = Tier("warm").Cpu,
            WarmMemory = Tier("warm").Memory,
            WarmStorageSize = Tier("warm").Storage,
            ColdCount = Tier("cold").Count,
            ColdCpuRequest = Tier("cold").Cpu,
            ColdMemory = Tier("cold").Memory,
            ColdStorageSize = Tier("cold").Storage,
            IngestCount = Tier("ingest").Count,
            IngestCpuRequest = Tier("ingest").Cpu,
            IngestMemory = Tier("ingest").Memory,
            IngestStorageSize = Tier("ingest").Storage,
            StorageClass = string.IsNullOrWhiteSpace(StorageClass) ? null : StorageClass!.Trim(),
            AllowMmap = AllowMmap,
            ZoneAware = ZoneAware,
            KibanaEnabled = KibanaEnabled,
            KibanaCount = KibanaCount,
            KibanaCpuRequest = KibanaCpu,
            KibanaMemory = KibanaMemory
        };
    }

    // The presets exist because the shape of a search cluster is a decision people get wrong once
    // and then live with: one node for a laptop-sized cluster, split roles for anything real.
    private static readonly (string Key, string Label, string Help)[] Presets =
    [
        ("single", "Single node (dev)", "One all-roles node. No redundancy, no tiers — fine for a development environment and nothing else."),
        ("small-ha", "Small HA", "Three dedicated masters and two hot data nodes. The smallest shape that survives losing a node."),
        ("hot-warm", "Hot / warm", "Masters, a hot tier for writes and a warm tier for data ILM ages into."),
        ("hot-warm-cold", "Hot / warm / cold", "Full tiering, plus dedicated ingest and coordinating nodes to keep pipelines off the data nodes.")
    ];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;

        Task<List<ElasticsearchCluster>> clustersTask = Search.GetClustersAsync(TenantId);
        Task<List<KubernetesCluster>> k8sTask = TenantService.GetClustersAsync(TenantId);
        Task<ElasticsearchOperatorStatus> operatorTask = Search.GetOperatorStatusAsync(TenantId);
        Task<List<StorageLink>> storageTask = StorageService.GetStorageLinksAsync(TenantId, EnvironmentId);
        Task<List<AppDeployment>> deploymentsTask = Search.GetTenantDeploymentsAsync(TenantId);

        await Task.WhenAll(clustersTask, k8sTask, operatorTask, storageTask, deploymentsTask);
        allDeployments = deploymentsTask.Result;

        clusters = clustersTask.Result;
        allK8sClusters = k8sTask.Result;
        operatorStatus = operatorTask.Result;
        // Only S3-shaped links can hold snapshots; a link with no bucket has nowhere to put them.
        storageLinks = [.. storageTask.Result.Where(l => !string.IsNullOrWhiteSpace(l.BucketName))];

        if (EnvironmentId.HasValue)
        {
            envClusterIds = allK8sClusters
                .Where(c => c.EnvironmentId == EnvironmentId.Value)
                .Select(c => c.Id)
                .ToHashSet();
            formK8sClusters = allK8sClusters.Where(c => envClusterIds.Contains(c.Id)).ToList();
            clusters = clusters.Where(c => envClusterIds.Contains(c.KubernetesClusterId)).ToList();
        }
        else
        {
            envClusterIds = null;
            formK8sClusters = allK8sClusters;
        }

        allPolicies.Clear();
        allUsers.Clear();
        allSpaces.Clear();
        allRemotes.Clear();
        allPipelines.Clear();
        allDataViews.Clear();
        allBindings.Clear();
        foreach (ElasticsearchCluster c in clusters)
        {
            allPolicies[c.Id] = await Search.GetPoliciesAsync(TenantId, c.Id);
            allUsers[c.Id] = await Search.GetUsersAsync(TenantId, c.Id);
            allSpaces[c.Id] = await Search.GetSpacesAsync(TenantId, c.Id);
            allRemotes[c.Id] = await Search.GetRemoteLinksAsync(TenantId, c.Id);
            allPipelines[c.Id] = await Search.GetPipelinesAsync(TenantId, c.Id);
            allDataViews[c.Id] = await Search.GetDataViewsAsync(TenantId, c.Id);
            allBindings[c.Id] = await Search.GetBindingsAsync(TenantId, c.Id);
        }

        loading = false;
    }

    // ── Create / edit ─────────────────────────────────────────────────────────

    private void ShowCreateForm()
    {
        editingId = null;
        formError = null;
        capacity = null;
        form = new EsForm
        {
            K8sClusterId = EnvironmentId.HasValue && formK8sClusters.Count == 1 ? formK8sClusters[0].Id : Guid.Empty
        };
        ApplyPreset(selectedPreset);
    }

    private void ShowEditForm(ElasticsearchCluster c)
    {
        editingId = c.Id;
        formError = null;
        capacity = null;
        form = new EsForm
        {
            Id = c.Id,
            Name = c.Name,
            Namespace = c.Namespace,
            Version = c.Version,
            K8sClusterId = c.KubernetesClusterId,
            StorageClass = c.StorageClass,
            AllowMmap = c.AllowMmap,
            ZoneAware = c.ZoneAware,
            KibanaEnabled = c.KibanaEnabled,
            KibanaCount = c.KibanaCount,
            KibanaCpu = c.KibanaCpuRequest,
            KibanaMemory = c.KibanaMemory
        };

        Set("master", c.MasterCount, c.MasterCpuRequest, c.MasterMemory, c.MasterStorageSize);
        Set("hot", c.HotCount, c.HotCpuRequest, c.HotMemory, c.HotStorageSize);
        Set("warm", c.WarmCount, c.WarmCpuRequest, c.WarmMemory, c.WarmStorageSize);
        Set("cold", c.ColdCount, c.ColdCpuRequest, c.ColdMemory, c.ColdStorageSize);
        Set("ingest", c.IngestCount, c.IngestCpuRequest, c.IngestMemory, c.IngestStorageSize);

        _ = RefreshCapacityAsync();

        void Set(string key, int count, string cpu, string memory, string storage)
        {
            TierEdit t = form!.Tier(key);
            t.Count = count; t.Cpu = cpu; t.Memory = memory; t.Storage = storage;
        }
    }

    private void CancelForm() { form = null; editingId = null; formError = null; capacity = null; }

    private void ApplyPreset(string key)
    {
        if (form is null) return;
        selectedPreset = key;

        void Set(string tier, int count, string cpu, string memory, string storage)
        {
            TierEdit t = form!.Tier(tier);
            t.Count = count; t.Cpu = cpu; t.Memory = memory; t.Storage = storage;
        }

        switch (key)
        {
            case "single":
                Set("master", 1, "1", "2Gi", "50Gi");
                Set("hot", 0, "1", "4Gi", "100Gi");
                Set("warm", 0, "500m", "4Gi", "200Gi");
                Set("cold", 0, "500m", "2Gi", "500Gi");
                Set("ingest", 0, "1", "2Gi", "1Gi");
                form.KibanaMemory = "1Gi";
                break;
            case "hot-warm":
                Set("master", 3, "500m", "2Gi", "5Gi");
                Set("hot", 2, "1", "4Gi", "100Gi");
                Set("warm", 2, "500m", "4Gi", "200Gi");
                Set("cold", 0, "500m", "2Gi", "500Gi");
                Set("ingest", 0, "1", "2Gi", "1Gi");
                break;
            case "hot-warm-cold":
                Set("master", 3, "500m", "2Gi", "5Gi");
                Set("hot", 3, "2", "8Gi", "200Gi");
                Set("warm", 2, "1", "4Gi", "500Gi");
                Set("cold", 2, "500m", "2Gi", "1Ti");
                Set("ingest", 2, "1", "2Gi", "1Gi");
                break;
            default: // small-ha
                Set("master", 3, "500m", "2Gi", "5Gi");
                Set("hot", 2, "1", "4Gi", "100Gi");
                Set("warm", 0, "500m", "4Gi", "200Gi");
                Set("cold", 0, "500m", "2Gi", "500Gi");
                Set("ingest", 0, "1", "2Gi", "1Gi");
                break;
        }

        _ = RefreshCapacityAsync();
    }

    private async Task RefreshCapacityAsync()
    {
        if (form is null || form.K8sClusterId == Guid.Empty) { capacity = null; return; }

        checkingCapacity = true;
        StateHasChanged();
        try
        {
            ElasticsearchCluster? existing = editingId is Guid id
                ? clusters.FirstOrDefault(c => c.Id == id)
                : null;
            capacity = await Search.CheckCapacityAsync(form.K8sClusterId, form.ToEntity(), existing);
        }
        catch (Exception ex)
        {
            formError = ex.Message;
        }
        finally
        {
            checkingCapacity = false;
            StateHasChanged();
        }
    }

    private async Task SaveFormAsync()
    {
        if (form is null) return;

        if (form.K8sClusterId == Guid.Empty)
        {
            formError = "Pick the Kubernetes cluster this runs on.";
            return;
        }

        saving = true;
        formError = null;
        try
        {
            ElasticsearchCluster entity = form.ToEntity();

            if (editingId is Guid id)
            {
                entity.Id = id;
                await Search.UpdateClusterAsync(TenantId, entity, form.Acknowledge);
                Toasts.Success($"Updated \"{entity.Name}\".");
            }
            else
            {
                entity.TenantId = TenantId;
                entity.KubernetesClusterId = form.K8sClusterId;
                await Search.CreateClusterAsync(entity, form.Acknowledge);
                Toasts.Success($"Creating \"{entity.Name}\" — the operator takes a few minutes to form the cluster.");
            }

            form = null;
            editingId = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            formError = ex.Message;
            // A refusal is nearly always a capacity one; show the numbers it was based on.
            await RefreshCapacityAsync();
        }
        finally { saving = false; }
    }

    private async Task DeleteClusterAsync(ElasticsearchCluster cluster)
    {
        try
        {
            await Search.DeleteClusterAsync(TenantId, cluster.Id);
            expandedId = null;
            await LoadAsync();
            Toasts.Success($"Deleted \"{cluster.Name}\".");
        }
        catch (Exception ex)
        {
            Toasts.Error($"Failed to delete \"{cluster.Name}\": {ex.Message}");
        }
    }

    // ── Detail ────────────────────────────────────────────────────────────────

    private async Task ToggleCluster(Guid id)
    {
        if (expandedId == id) { expandedId = null; expandedDetail = null; return; }
        expandedId = id;
        revealedPasswordFor = null;
        revealedPassword = null;
        await RefreshDetail(id);
    }

    private async Task RefreshDetail(Guid id)
    {
        expandedDetail = null;
        loadingDetail = true;
        StateHasChanged();
        expandedDetail = await Search.GetClusterDetailAsync(TenantId, id);
        loadingDetail = false;

        ElasticsearchCluster? c = clusters.FirstOrDefault(x => x.Id == id);
        if (c is not null && expandedDetail is not null)
        {
            if (expandedDetail.Ready) c.Status = ElasticsearchClusterStatus.Running;
            if (expandedDetail.Health is not null) c.Health = expandedDetail.Health;
        }
    }

    private async Task RevealPasswordAsync(Guid id)
    {
        if (revealedPasswordFor == id) { revealedPasswordFor = null; revealedPassword = null; return; }
        revealedPassword = await Search.GetElasticPasswordAsync(TenantId, id);
        revealedPasswordFor = id;
    }

    // ── Lifecycle policies ────────────────────────────────────────────────────

    private void ShowAddPolicy(ElasticsearchCluster cluster)
    {
        addPolicyClusterId = cluster.Id;
        policyName = "";
        policyPattern = "";
        policyDataStream = true;
        policyShards = 1;
        policyReplicas = cluster.HotCount > 1 ? 1 : 0;
        policyRolloverGb = 50;
        policyRolloverDays = 7;
        policyWarmDays = cluster.WarmCount > 0 ? 7 : 0;
        policyColdDays = cluster.ColdCount > 0 ? 30 : 0;
