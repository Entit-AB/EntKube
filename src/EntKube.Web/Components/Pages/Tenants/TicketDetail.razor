@using EntKube.Web.Data
@using EntKube.Web.Services
@using EntKube.Web.Services.Support
@using EntKube.Web.Services.Tickets
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject TicketService Tickets
@inject SupportDutyService Duty
@inject ToastService Toasts
@inject CurrentActor ActorService
@inject UserAccessService Access
@inject AuthenticationStateProvider AuthState
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject TicketWorkService Work
@inject TextModuleService TextModules
@inject MacroService Macros
@inject TicketReference References
@inject TicketDraftService Drafts
@inject EntKube.Web.Services.Time.TimeService Time
@inject IJSRuntime JS
@inject NavigationManager Nav

@* ═══════════════════════════════════════════════════════════════════
   One ticket, with the actions §14 actually defines and the history
   that §14.6 makes the record between the parties.
   ═══════════════════════════════════════════════════════════════════ *@

<LoadingPanel Loading="@loading" Error="@error">
@if (!loading && ticket is not null)
{
    <nav class="mb-3">
        <button class="btn btn-sm btn-link text-decoration-none p-0" @onclick="OnBack">
            <i class="bi bi-arrow-left me-1"></i>Back to the queue
        </button>
    </nav>

    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            @if (renaming)
            {
                <div class="input-group input-group-sm mb-1" style="max-width: 40rem">
                    <span class="input-group-text">#@ticket.Number</span>
                    <input class="form-control" @bind="renameTo" @onkeydown="OnRenameKeyAsync" aria-label="Title" />
                    <AsyncButton CssClass="btn-sm btn-primary" OnClick="RenameAsync">Save</AsyncButton>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => renaming = false">Cancel</button>
                </div>
            }
            else
            {
                <h5 class="mb-1">
                    <span class="text-muted">#@ticket.Number</span>
                    @ticket.Title
                    <button class="btn btn-sm btn-link text-muted p-0 ms-1" title="Rename — the customer sees the new title"
                            @onclick="StartRename"><i class="bi bi-pencil"></i></button>
                    <span class="dropdown d-inline-block">
                        <button class="btn btn-sm btn-link text-muted p-0 ms-1" data-bs-toggle="dropdown" title="Copy">
                            <i class="bi bi-clipboard"></i>
                        </button>
                        <ul class="dropdown-menu">
                            <li><button class="dropdown-item small" @onclick="() => CopyAsync(CopyText(1))">Number</button></li>
                            <li><button class="dropdown-item small" @onclick="() => CopyAsync(CopyText(2))">Number and title</button></li>
                            <li><button class="dropdown-item small" @onclick="() => CopyAsync(CopyText(3))">Number, title and link</button></li>
                        </ul>
                    </span>
                </h5>
            }
            <div class="small text-muted">
                Reported @ticket.ReportedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                via @ticket.Channel
                @if (ticket.RequestedBy is not null)
                {
                    <span>by @ticket.RequestedBy</span>
                }
                · window @ticket.SupportWindow
                @if (ticket.ClockStartsAt != ticket.ReportedAt)
                {
                    <span title="§9.1: arrived outside the window, so the clock starts at the next opening">
                        · clock from @ticket.ClockStartsAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                    </span>
                }
            </div>
        </div>
        <div class="text-end">
            <span class="badge @PriorityClass(ticket.Priority) fs-6">@ticket.Priority</span>
            <span class="badge bg-light text-dark border ms-1">@ticket.Status</span>
            @if (ticket.IsCallout)
            {
                <div class="badge bg-warning text-dark mt-1"
                     title="P1 outside the bought window — call-out (§13), minimum two hours">call-out</div>
            }
        </div>
    </div>

    @if (ticket.Status == TicketStatus.Merged && mergedInto is { } into)
    {
        <div class="alert alert-secondary py-2 small">
            <i class="bi bi-intersect me-1"></i>
            Merged into <a href="@TicketHref(into.Number)">#@into.Number</a> — the matter is followed there.
            This ticket's own clocks and history stand as they were.
        </div>
    }

    <div class="row">
    <div class="col-xl-9">

    @* ───────────── Clocks ───────────── *@
    <div class="row g-3 mb-4">
        <div class="col-md-4">@ClockCard("Response time", status.Response, "§14.6 pays 10% of the window fee for a missed P1/P2 response")</div>
        <div class="col-md-4">@ClockCard("Resolution time", status.Resolution, "§14.4 calls this a goal — overrunning it is not a penalty")</div>
        <div class="col-md-4">
            <div class="border rounded p-3 h-100">
                <div class="small text-muted">Next update (§14.4)</div>
                @if (status.UpdateDue is DateTime updateDue)
                {
                    <div class="fs-6 fw-semibold @(status.UpdateOverdue(now) ? "text-danger" : "")">
                        @updateDue.ToLocalTime().ToString("MMM d HH:mm")
                    </div>
                    <div class="small text-muted">
                        @if (status.UpdateOverdue(now))
                        {
                            @* ⚠️ With the day on it, not a bare time. LastUpdateAt is the last
                               thing the customer was actually told, and §14.4's deadline walks
                               over closed hours and pauses — so the gap this line exists to
                               describe can be days wide. It used to print "since 16:40", which
                               on a Monday morning reads as this afternoon when it was Friday,
                               and the operator deprioritises the most overdue obligation on
                               the ticket. The non-overdue line below it, and the same sentence
                               in the queue (TicketQueue.razor), have always carried the day. *@
                            <span>overdue — the customer has heard nothing since
                                @status.LastUpdateAt.ToLocalTime().ToString("MMM d HH:mm")</span>
                        }
                        else
                        {
                            <span>last told @status.LastUpdateAt.ToLocalTime().ToString("MMM d HH:mm")</span>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted">—</div>
                    <div class="small text-muted">no fixed interval at this priority</div>
                }
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="border rounded p-3 h-100">
                <div class="small text-muted">Escalation (§14.5)</div>
                @if (status.EscalationDue is not null)
                {
                    <div class="fs-6 fw-semibold @(status.EscalationDue <= now ? "text-danger" : "")">
                        @status.EscalationDue.Value.ToLocalTime().ToString("MMM d HH:mm")
                    </div>
                    <div class="small text-muted">to level 2</div>
                }
                else
                {
                    <div class="fs-6 text-muted">—</div>
                }
                @if (status.IncidentReportDue is DateTime reportDue)
                {
                    @if (ticket.IncidentReportDeliveredAt is DateTime delivered)
                    {
                        <div class="small mt-2 text-success">
                            <i class="bi bi-file-earmark-check me-1"></i>
                            P1 report delivered @delivered.ToLocalTime().ToString("MMM d")
                        </div>
                    }
                    else
                    {
                        <div class="small mt-2 @(status.IncidentReportOverdue(now) ? "text-danger" : "text-warning")">
                            <i class="bi bi-file-earmark-text me-1"></i>
                            P1 report @(status.IncidentReportOverdue(now) ? "overdue since" : "due")
                            @reportDue.ToLocalTime().ToString("MMM d")
                        </div>
                        <AsyncButton CssClass="btn-sm btn-outline-secondary mt-2"
                                     OnClick="RecordIncidentReportAsync">
                            <i class="bi bi-file-earmark-check me-1"></i>Report delivered
                        </AsyncButton>
                    }
                }
            </div>
        </div>
    </div>

    @if (ticket.ExcludedFromSla)
    {
        <div class="alert alert-secondary py-2 small">
            <i class="bi bi-shield-slash me-1"></i>
            <strong>Not counted as a deviation.</strong> @ticket.SlaExclusionReason
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(ticket.Description))
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="small text-muted mb-1">Description</div>
                <div style="white-space: pre-wrap">@ticket.Description</div>
            </div>
        </div>
    }

    @* ───────────── Actions ───────────── *@
    <div class="card mb-4">
        <div class="card-header bg-white py-2"><strong class="small">Actions</strong></div>
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2 mb-3">
                @if (ticket.FirstResponseAt is null)
                {
                    <AsyncButton CssClass="btn-sm btn-primary" OnClick="RespondAsync">
                        <i class="bi bi-reply me-1"></i>Record first response
                    </AsyncButton>
                }
                @if (IsOpen && !IsPaused)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => showPause = !showPause">
                        <i class="bi bi-pause-circle me-1"></i>Pause the clock
                    </button>
                }
                @if (IsPaused)
                {
                    <AsyncButton CssClass="btn-sm btn-outline-primary" OnClick="EndPauseAsync">
                        <i class="bi bi-play-circle me-1"></i>Resume — they answered
                    </AsyncButton>
                }
                @if (IsOpen)
                {
                    <button class="btn btn-sm btn-outline-success" @onclick="() => showResolve = !showResolve">
                        <i class="bi bi-check2 me-1"></i>Resolve
                    </button>
                    <button class="btn btn-sm btn-outline-dark" @onclick="() => showReject = !showReject">
                        <i class="bi bi-box-arrow-right me-1"></i>Reject (§14.4)
                    </button>
                }
                @if (ticket.Status == TicketStatus.Resolved)
                {
                    <AsyncButton CssClass="btn-sm btn-success" OnClick="CloseAsync">
                        <i class="bi bi-archive me-1"></i>Close
                    </AsyncButton>
                }
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => showPriority = !showPriority">
                    <i class="bi bi-flag me-1"></i>
                    @(ticket.PriorityConfirmedAt is null ? "Confirm priority" : "Reprioritise")
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleNoteAsync">
                    <i class="bi bi-chat-left-text me-1"></i>Add a note
                </button>
                @if (moveTargets.Count > 0)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleMove">
                        <i class="bi bi-signpost-split me-1"></i>Move it
                    </button>
                }
                @if (IsOpen)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => showMerge = !showMerge">
                        <i class="bi bi-intersect me-1"></i>Merge into…
                    </button>
                }
                @if (IsOpen && macros.Count > 0)
                {
                    <div class="input-group input-group-sm w-auto" data-test="macro-runner">
                        <select class="form-select form-select-sm" @bind="macroChoice" aria-label="Macro">
                            <option value="">Run a macro…</option>
                            @foreach (Macro m in macros)
                            {
                                <option value="@m.Id">@m.Name</option>
                            }
                        </select>
                        <AsyncButton CssClass="btn-sm btn-outline-secondary" OnClick="RunMacroAsync">Run</AsyncButton>
                    </div>
                }

                @* Claim, hand over, or put it back. *@
                @if (ticket.Assignee is null)
                {
                    <AsyncButton CssClass="btn-sm btn-outline-primary" OnClick="ClaimAsync">
                        <i class="bi bi-person-check me-1"></i>Take this
                    </AsyncButton>
                }
                else if (ticket.Assignee == Actor)
                {
                    <AsyncButton CssClass="btn-sm btn-outline-secondary" OnClick="ReleaseAsync">
                        <i class="bi bi-person-dash me-1"></i>Put it back
                    </AsyncButton>
                }
                else
                {
                    <AsyncButton CssClass="btn-sm btn-outline-warning" OnClick="ClaimAsync">
                        <i class="bi bi-person-up me-1"></i>Take it from @ticket.Assignee
                    </AsyncButton>
                }

                @* Hand it to somebody else. Only rendered once the roster has arrived: a
                   select takes its selection from options rendered in the same batch, so one
                   built before its options have loaded shows the placeholder and then quietly
                   disagrees with what the page thinks is chosen. *@
                @if (roster is not null && roster.Count > 0)
                {
                    <select class="form-select form-select-sm w-auto d-inline-block"
                            value="@(ticket.AssigneeUserId ?? "")"
                            @onchange="HandToAsync">
                        <option value="">Hand to…</option>
                        @foreach (SupportTechnician technician in roster)
                        {
                            <option value="@technician.UserId">@technician.Name</option>
                        }
                    </select>
                }
                else if (roster is not null)
                {
                    @* Said rather than left blank. Nobody on the rota is a normal state and a
                       missing control is indistinguishable from a broken one. *@
                    <span class="text-muted small align-self-center">
                        <i class="bi bi-person-slash me-1"></i>Nobody is on the support rota
                    </span>
                }
            </div>

            @if (sharedDraft is { } shared)
            {
                <div class="border rounded p-2 mb-2 small bg-light" data-test="shared-draft">
                    <i class="bi bi-file-earmark-text me-1"></i>
                    <strong>Draft available</strong>
                    <span class="text-muted">— left by @(shared.By ?? "somebody"), @shared.At.ToLocalTime().ToString("MMM d HH:mm")</span>
                    <button class="btn btn-sm btn-link p-0 ms-2" @onclick="() => previewShared = !previewShared">@(previewShared ? "Hide" : "Preview")</button>
                    @if (previewShared)
                    {
                        <div class="border rounded bg-white p-2 my-2" style="white-space: pre-wrap">@shared.Text</div>
                        <div class="text-muted mb-1">@(shared.CustomerVisible ? "Marked: the customer sees this." : "Marked: internal.")</div>
                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="LoadSharedDraftAsync">
                            @(loadOverwrites ? "Replace what you have typed" : "Load into the note")
                        </button>
                        <button class="btn btn-sm btn-link text-danger p-0" @onclick="DeleteSharedDraftAsync">Delete the draft</button>
                    }
                </div>
            }

            @if (timePrompt)
            {
                <div class="border rounded p-2 mb-2 small" data-test="time-prompt">
                    <div class="mb-1"><i class="bi bi-stopwatch me-1"></i>Time spent on this? <span class="text-muted">Optional.</span></div>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <input class="form-control form-control-sm" style="width: 6rem" type="number" min="1" max="1440" placeholder="minutes" @bind="timeMinutes" />
                        <select class="form-select form-select-sm w-auto" @bind="timeKind">
                            <option value="@EntKube.Web.Data.WorkKind.Management">Management</option>
                            <option value="@EntKube.Web.Data.WorkKind.IncidentAssessment">First assessment</option>
                            <option value="@EntKube.Web.Data.WorkKind.Development">Development (§15)</option>
                            <option value="@EntKube.Web.Data.WorkKind.Travel">Travel</option>
                        </select>
                        <input class="form-control form-control-sm flex-grow-1" style="min-width: 12rem" @bind="timeDescription" placeholder="What was done — the customer validates this (§20)" />
                        <AsyncButton CssClass="btn-sm btn-primary" OnClick="LogPromptedTimeAsync">Log</AsyncButton>
                        <button class="btn btn-sm btn-link" @onclick="() => timePrompt = false">Skip</button>
                    </div>
                </div>
            }

            @if (guardedAction is not null)
            {
                <div class="alert alert-warning py-2 small d-flex justify-content-between align-items-center" data-test="checklist-guard">
                    <span><i class="bi bi-list-check me-1"></i>@openChecklistItems checklist item(s) are still open.</span>
                    <span>
                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => guardedAction = null">Keep it open</button>
                        <AsyncButton CssClass="btn-sm btn-warning" OnClick="ContinueGuardedAsync">@guardedLabel anyway</AsyncButton>
                    </span>
                </div>
            }

            @if (showPriority)
            {
                <div class="border rounded p-3 mb-2">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label small text-muted">Priority</label>
                            <select class="form-select form-select-sm" @bind="formPriority">
                                @foreach (TicketPriority p in Enum.GetValues<TicketPriority>())
                                {
                                    <option value="@p">@p</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label small text-muted">
                                Reason — §14.3 requires this in writing
                            </label>
                            <input class="form-control form-control-sm" @bind="formReason" />
                        </div>
                        <div class="col-md-2 text-end">
                            <AsyncButton CssClass="btn-sm btn-primary" OnClick="ConfirmPriorityAsync">Save</AsyncButton>
                        </div>
                    </div>
                    @if (formPriority != ticket.Priority)
                    {
                        <div class="form-text small text-warning mt-2">
                            <i class="bi bi-info-circle me-1"></i>
                            Changing the priority restarts both targets from now (§14.3).
                        </div>
                    }
                </div>
            }

            @if (showPause)
            {
                <div class="border rounded p-3 mb-2">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label small text-muted">Waiting on</label>
                            <select class="form-select form-select-sm" @bind="formWaitingOn">
                                <option value="@WaitingOn.Customer">The customer</option>
                                <option value="@WaitingOn.CustomerVendor">The customer's supplier</option>
                                <option value="@WaitingOn.ThirdParty">A third party</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-muted">Who</label>
                            <input class="form-control form-control-sm" @bind="formParty" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted">What for</label>
                            <input class="form-control form-control-sm" @bind="formReason" />
                        </div>
                        <div class="col-md-2 text-end">
                            <AsyncButton CssClass="btn-sm btn-primary" OnClick="StartPauseAsync">Pause</AsyncButton>
                        </div>
                    </div>
                    <div class="form-text small mt-2">
                        §14.4 stops the resolution clock while another party is being waited on, and
                        requires the wait to be documented. The response clock keeps running.
                    </div>
                </div>
            }

            @if (showResolve)
            {
                <div class="border rounded p-3 mb-2">
                    <label class="form-label small text-muted">
                        What restored the service, or which workaround the customer accepted
                    </label>
                    <textarea class="form-control form-control-sm mb-2" rows="2" @bind="formReason"></textarea>
                    <div class="text-end">
                        <AsyncButton CssClass="btn-sm btn-success" OnClick="ResolveAsync">Resolve</AsyncButton>
                    </div>
                </div>
            }

            @if (showReject)
            {
                <div class="border rounded p-3 mb-2">
                    <label class="form-label small text-muted">
                        Which system outside the agreement the fault lay in
                    </label>
                    <textarea class="form-control form-control-sm mb-2" rows="2" @bind="formReason"></textarea>
                    <div class="form-text small mb-2">
                        §14.4: the time spent is still billable and this does not count as a deviation.
                    </div>
                    <div class="text-end">
                        <AsyncButton CssClass="btn-sm btn-dark" OnClick="RejectAsync">Reject</AsyncButton>
                    </div>
                </div>
            }

            @* Moving is the one action that can take a ticket out of the tenant the person
               is looking at. The pickers only offer tenants they can already reach — and
               because what a select posts is a browser-supplied string rather than one of the
               options we rendered, every posted id is checked against that same server-side
               list again before it is used. See CanMoveInto. *@
            @if (showMove)
            {
                <div class="border rounded p-3 mb-2">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label small text-muted">Tenant</label>
                            <select class="form-select form-select-sm" value="@moveTenantId"
                                    @onchange="OnMoveTenantChanged">
                                @foreach (Tenant t in moveTargets)
                                {
                                    <option value="@t.Id">@t.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted">Customer</label>
                            <select class="form-select form-select-sm" value="@moveCustomerId"
                                    @onchange="OnMoveCustomerChanged">
                                <option value="">&#8212; choose &#8212;</option>
                                @foreach (Customer c in moveCustomers)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted">Application</label>
                            <select class="form-select form-select-sm" value="@moveAppId"
                                    @onchange="e => moveAppId = e.Value?.ToString() ?? string.Empty">
                                <option value="">&#8212; none of them &#8212;</option>
                                @foreach (Data.App a in moveApps)
                                {
                                    <option value="@a.Id">@a.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small text-muted">Why it is being moved</label>
                            <textarea class="form-control form-control-sm" rows="2" @bind="moveReason"
                                      placeholder="What made it clear this belongs elsewhere"></textarea>
                        </div>
                    </div>
                    <div class="form-text small mt-2">
                        <strong>#@ticket.Number stays.</strong> The reporter has been told to quote it
                        for as long as the ticket is open, and their replies thread on it, so it
                        follows the ticket wherever it goes. What changes is the agreement it is
                        measured against: the support hours, whether §4.1's guaranteed response
                        applies, and whether a P1 is a §13 call-out all come from the destination
                        application. The reporting time, the history and the priority stand.
                    </div>
                    <div class="text-end mt-2">
                        <AsyncButton CssClass="btn-sm btn-primary" OnClick="MoveAsync">Move it</AsyncButton>
                    </div>
                </div>
            }

            @if (showMerge)
            {
                <div class="border rounded p-3 mb-2" data-test="merge-form">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label small text-muted">The original — merge #@ticket.Number into</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">#</span>
                                <input class="form-control" type="number" min="1" @bind="mergeTarget" />
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="merge-exclude" @bind="mergeExclude" />
                                <label class="form-check-label small" for="merge-exclude">
                                    Also exclude #@ticket.Number from SLA measurement
                                </label>
                            </div>
                            @if (mergeExclude)
                            {
                                <input class="form-control form-control-sm mt-1" @bind="mergeReason"
                                       placeholder="Why — §14.6 requires the reason" />
                            }
                        </div>
                    </div>
                    <div class="form-text small mt-2">
                        #@ticket.Number becomes <strong>merged</strong>: its clocks stop now and, if nobody has
                        answered it yet, the merge is recorded as its first response — being assessed as a
                        duplicate of a ticket that is being worked. A response that was already late stays late.
                        Its history stays with it and is shown on the original; replies quoting its number go
                        to the original. Excluding it from the SLA is a separate decision, made here with a reason.
                    </div>
                    @if (status.Response is { Breached: true })
                    {
                        <div class="form-text small text-danger mt-1">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            This ticket's response time has already been missed. Merging does not change that.
                        </div>
                    }
                    <div class="text-end mt-2">
                        <AsyncButton CssClass="btn-sm btn-primary" OnClick="MergeAsync">Merge</AsyncButton>
                    </div>
                </div>
            }

            @if (showNote)
            {
                <div class="border rounded p-3 mb-2">
                    <textarea class="form-control form-control-sm mb-2" rows="3" value="@formReason"
                              @oninput="OnNoteInputAsync" placeholder="A status update, or a working note"></textarea>
                    <div class="input-group input-group-sm mb-2" data-test="text-module-picker">
                        <span class="input-group-text"><i class="bi bi-card-text"></i></span>
                        <input class="form-control" placeholder="Insert a text module — type to find one" @bind="moduleQuery" @bind:event="oninput" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(moduleQuery))
                    {
                        <div class="list-group list-group-flush border rounded mb-2 small" style="max-height: 12rem; overflow-y: auto">
                            @foreach (TextModule m in MatchingModules())
                            {
                                <button type="button" class="list-group-item list-group-item-action py-1" @onclick="() => InsertModule(m)">
                                    <strong>@m.Name</strong> <span class="text-muted">@m.Keywords</span>
                                </button>
                            }
                            @if (!MatchingModules().Any())
                            {
                                <div class="list-group-item text-muted py-1">No text module matches.</div>
                            }
                        </div>
                    }
                    @if (colleagues is { Count: > 0 })
                    {
                        <div class="small text-muted mb-1">Mention colleagues — they are mailed the note and follow the ticket:</div>
                        <div class="d-flex flex-wrap gap-2 mb-2" data-test="mentions">
                            @foreach (SupportTechnician c in colleagues)
                            {
                                <div class="form-check form-check-inline small m-0">
                                    <input class="form-check-input" type="checkbox" id="@($"mention-{c.UserId}")"
                                           checked="@mentioned.Contains(c.UserId)"
                                           @onchange="e => ToggleMention(c.UserId, e)" />
                                    <label class="form-check-label" for="@($"mention-{c.UserId}")">@c.Name</label>
                                </div>
                            }
                        </div>
                    }
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="visible" @bind="formCustomerVisible" />
                            <label class="form-check-label small" for="visible">The customer sees this</label>
                        </div>
                        <span>
                            <button class="btn btn-sm btn-link" @onclick="ShareDraftAsync"
                                    title="Leave this note on the ticket for a colleague to finish">
                                @(confirmOverwrite ? "Replace the shared draft" : "Save as shared draft")
                            </button>
                            <AsyncButton CssClass="btn-sm btn-primary" OnClick="AddNoteAsync">Add</AsyncButton>
                        </span>
                    </div>
                    @if (draftSavedAt is DateTime savedAt)
                    {
                        <div class="form-text">Draft saved @savedAt.ToLocalTime().ToString("HH:mm:ss") — it is here if you come back.</div>
                    }
                </div>
            }

            @if (splitFrom is Guid splitEntry)
            {
                <div class="border rounded p-3 mb-2" data-test="split-form">
                    <label class="form-label small text-muted">Title of the new ticket</label>
                    <input class="form-control form-control-sm mb-2" @bind="splitTitle" />
                    <div class="form-text small mb-2">
                        Opened for the same customer and application, and reported at the time of that entry —
                        that is when it was raised, so its clocks count from there. The customer is sent a
                        receipt for it, and the two tickets are linked as parent and child.
                    </div>
                    <div class="text-end">
                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => splitFrom = null">Cancel</button>
                        <AsyncButton CssClass="btn-sm btn-primary" OnClick="() => SplitAsync(splitEntry)">Open the new ticket</AsyncButton>
                    </div>
                </div>
            }
        </div>
    </div>

    @* ───────────── Time ───────────── *@
    <div class="card mb-4">
        <div class="card-body">
            <TicketTimeLog Ticket="ticket" ActorName="Actor" OnChanged="OnChanged" />
        </div>
    </div>

    @* ───────────── History ───────────── *@
    <h6 class="mb-2">History</h6>
    <div class="text-muted small mb-3">
        §14.6 makes these timestamps the record between the parties. Entries are appended, never edited.
    </div>

    <div class="list-group">
        @foreach ((TicketEvent entry, int? fromNumber) in History())
        {
            <div class="list-group-item py-2 @(fromNumber is null ? "" : "bg-light")">
                <div class="d-flex justify-content-between">
                    <div class="small" style="white-space: pre-wrap">
                        @if (fromNumber is int from)
                        {
                            <a class="badge bg-secondary text-decoration-none me-1" href="@TicketHref(from)"
                               title="From a duplicate merged into this ticket">#@from</a>
                        }
                        <span class="badge @EventClass(entry.Kind) me-2">@entry.Kind</span>
                        @entry.Detail
                        @if (fromNumber is null && IsOpen && entry.Kind == TicketEventKind.Note)
                        {
                            <button class="btn btn-sm btn-link text-muted p-0 ms-2" style="font-size: .75rem"
                                    title="Open a new ticket from this entry" @onclick="() => StartSplit(entry)">
                                <i class="bi bi-box-arrow-up-right me-1"></i>split
                            </button>
                        }
                    </div>
                    <div class="text-muted text-nowrap ms-3" style="font-size: .75rem">
                        @entry.At.ToLocalTime().ToString("MMM d HH:mm")
                        @if (entry.Actor is not null)
                        {
                            <div>@entry.Actor</div>
                        }
                        @if (!entry.CustomerVisible)
                        {
                            <div><i class="bi bi-eye-slash" title="Internal — the customer does not see this"></i></div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    </div>
    <div class="col-xl-3">
        <TicketWorkPanel TenantId="TenantId" Ticket="ticket" TenantSlug="@TenantSlug" Actor="@Actor" OnChanged="ReloadAfterWorkAsync" />
        <TicketChecklistPanel TenantId="TenantId" TicketId="ticket.Id" Actor="@Actor" Editable="IsOpen"
                              OnOpenItems="n => openChecklistItems = n" />
        <TicketAttachmentsPanel TenantId="TenantId" TicketId="ticket.Id" TenantSlug="@TenantSlug" Actor="@Actor"
                                Editable="IsOpen" OnChanged="ReloadAfterWorkAsync" />
    </div>
    </div>
}
</LoadingPanel>

@code {
    [Parameter, EditorRequired] public Guid TenantId { get; set; }

    [Parameter, EditorRequired] public Guid TicketId { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    /// <summary>The tenant's slug, for the ticket's own address and links to other tickets.</summary>
    [Parameter] public string? TenantSlug { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool loading = true;
    private string? error;
    private Ticket? ticket;
    private TicketSlaStatus status;
    private DateTime now = DateTime.UtcNow;

    private bool showPriority, showPause, showResolve, showReject, showNote, showMove, showMerge;

    // ---- Phase 1 helpdesk work (docs/helpdesk.md) ----
    private bool renaming;
    private string renameTo = "";
    private int? mergeTarget;
    private bool mergeExclude;
    private string? mergeReason;
    private Guid? splitFrom;
    private string splitTitle = "";
    private List<MergedEntry> mergedEntries = [];
    private (int Number, Guid Id)? mergedInto;
    private List<SupportTechnician>? colleagues;
    private HashSet<string> mentioned = [];

    // ---- Phase 2a: text modules, macros, the checklist guard ----
    private List<TextModule> offeredModules = [];
    private string moduleQuery = "";
    private List<Macro> macros = [];
    private string macroChoice = "";
    private int openChecklistItems;
    private Func<Task>? guardedAction;
    private string guardedLabel = "";

    // ---- Phase 2b: drafts and the time prompt ----
    private string? userId;
    private NoteDraft? sharedDraft;
    private bool previewShared;
    private bool loadOverwrites;
    private bool confirmOverwrite;
    private bool fromSharedDraft;
    private DateTime? draftSavedAt;
    private CancellationTokenSource? autosave;
    private bool timePrompt;
    private int? timeMinutes;
    private EntKube.Web.Data.WorkKind timeKind = EntKube.Web.Data.WorkKind.Management;
    private string timeDescription = "";

    // ---- Moving it somewhere else ----
    //
    // The tenants this person can already reach, read once on the server. They are the only
    // ones offered, and — since the rendered options are not a boundary, see CanMoveInto —
    // the only ones accepted.
    private List<Tenant> moveTargets = [];
    private List<Customer> moveCustomers = [];
    private List<Data.App> moveApps = [];
    private string moveTenantId = "";
    private string moveCustomerId = "";
    private string moveAppId = "";
    private string moveReason = "";

    private TicketPriority formPriority = TicketPriority.P3;
    private string formReason = "";
    private string? formParty;
    private WaitingOn formWaitingOn = WaitingOn.Customer;
    private bool formCustomerVisible = true;

    private bool IsOpen => ticket is { Status: not (TicketStatus.Closed or TicketStatus.Rejected or TicketStatus.Merged) };

    private bool IsPaused => ticket?.Pauses.Any(p => p.EndedAt is null) == true;

    protected override async Task OnInitializedAsync()
    {
        resolvedActor = await ActorService.NameAsync();
        moveTargets = await ReachableTenantsAsync();
        userId = (await AuthState.GetAuthenticationStateAsync()).User
            .FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

    /// <summary>
    /// The tenants this person may move a ticket into: the ones they can already reach.
    ///
    /// <para>A global admin gets all of them. Anyone else gets what their memberships give
    /// them, which for most people is one — and one tenant with the ticket already in it
    /// means the button does not appear at all.</para>
    /// </summary>
    private async Task<List<Tenant>> ReachableTenantsAsync()
    {
        try
        {
            AuthenticationState state = await AuthState.GetAuthenticationStateAsync();

            string? userId = state.User.FindFirst(
                System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            return userId is null ? [] : await Access.GetAccessibleTenantsAsync(userId);
        }
        catch
        {
            // Never fails the page. Not being able to read the memberships means no move is
            // offered, which is the safe end of being wrong.
            return [];
        }
    }

    /// <summary>
    /// Opens the panel with the pickers already filled.
    ///
    /// <para>Filled <em>before</em> it renders, deliberately: a <c>select</c> takes its
    /// selection from the options present in the same render, so showing the panel first
    /// and loading afterwards leaves both boxes sitting on their placeholder with a value
    /// underneath that nobody chose.</para>
    /// </summary>
    private async Task ToggleMove()
    {
        if (showMove)
        {
            showMove = false;
            return;
        }

        moveTenantId = ticket!.TenantId.ToString();
        moveCustomerId = ticket.CustomerId.ToString();
        moveAppId = ticket.AppId?.ToString() ?? "";
        moveReason = "";

        await LoadMoveCustomersAsync(ticket.TenantId);
        await LoadMoveAppsAsync(ticket.CustomerId);

        showMove = true;
    }

    /// <summary>
    /// Whether a ticket may be moved into <paramref name="tenantId"/>: it has to be one
    /// <see cref="moveTargets"/> already holds.
    ///
    /// <para>⭐ The list is the authority, not the markup. <c>moveTargets</c> is read on the
    /// server from this person's memberships (<see cref="ReachableTenantsAsync"/>) and the
    /// browser cannot reach it; the rendered options are a convenience built from it.</para>
    ///
    /// <para>⚠️ A select's change payload is a string the browser puts on the circuit.
    /// Blazor Server validates the handler an event is addressed to, never the value that
    /// arrives with it, so nothing confines it to the options we rendered. This page used to
    /// claim in a comment that "the pickers only offer tenants they can already reach, so the
    /// control cannot express a move they would not be allowed to make" and then hand the
    /// posted id straight to <see cref="LoadMoveCustomersAsync"/> — which answers with
    /// another tenant's customer names — and the chosen customer straight to
    /// <see cref="TicketService.MoveAsync"/>, whose destination is deliberately unscoped (its
    /// own doc says so, and two service tests pin it that way). The service is right to stay
    /// unscoped: moving a ticket across tenants is the whole point of the action. That leaves
    /// this page as the only place the destination can be authorised, which is why it is
    /// authorised here.</para>
    ///
    /// <para>The caller this guards against is not somebody conjuring GUIDs out of nothing:
    /// it is somebody who knew the ids before their membership was taken away, and whose
    /// picker no longer offers them.</para>
    /// </summary>
    private bool CanMoveInto(Guid tenantId) => moveTargets.Any(t => t.Id == tenantId);

    private async Task OnMoveTenantChanged(ChangeEventArgs e)
    {
        moveCustomerId = "";
        moveAppId = "";
        moveApps = [];
        moveCustomers = [];

        if (!Guid.TryParse(e.Value?.ToString(), out Guid tenantId) || !CanMoveInto(tenantId))
        {
            // Refused rather than queried. The Customer picker is built FROM this value, so a
            // tenant we never offered would be answered with its customers' names.
            moveTenantId = "";
            Toasts.Error("That is not a tenant you can move a ticket into.");
            return;
        }

        moveTenantId = tenantId.ToString();
        await LoadMoveCustomersAsync(tenantId);
    }

    private async Task OnMoveCustomerChanged(ChangeEventArgs e)
    {
        moveAppId = "";

        // The same reasoning as the tenant above, one level down: moveApps is loaded FROM this
        // id, and moveCustomers is the server-side list the options were rendered from. No
        // toast, because the empty value is the "choose" placeholder and picking it is not a
        // mistake.
        if (!Guid.TryParse(e.Value?.ToString(), out Guid customerId)
            || moveCustomers.All(c => c.Id != customerId))
        {
            moveCustomerId = "";
            moveApps = [];
            return;
        }

        moveCustomerId = customerId.ToString();
        await LoadMoveAppsAsync(customerId);
    }

    private async Task LoadMoveCustomersAsync(Guid tenantId)
    {
        using ApplicationDbContext db = await DbFactory.CreateDbContextAsync();

        moveCustomers = await db.Customers.AsNoTracking()
            .Where(c => c.TenantId == tenantId)
            .OrderBy(c => c.Name)
            .ToListAsync();
    }

    private async Task LoadMoveAppsAsync(Guid customerId)
    {
        using ApplicationDbContext db = await DbFactory.CreateDbContextAsync();

        moveApps = await db.Apps.AsNoTracking()
            .Where(a => a.CustomerId == customerId)
            .OrderBy(a => a.Name)
            .ToListAsync();
    }

    private async Task MoveAsync()
    {
        // Not one of the customers we offered means no destination — whether nothing was
        // chosen, or the posted value never came from the control (see CanMoveInto). Checking
        // the customer is what carries the tenant check through to the move itself:
        // moveCustomers is only ever loaded for a tenant CanMoveInto allowed, and the
        // application is checked in the service, which refuses one belonging to anybody else.
        if (!Guid.TryParse(moveCustomerId, out Guid customerId)
            || moveCustomers.All(c => c.Id != customerId))
        {
            Toasts.Error("Choose the customer it belongs to.");
            return;
        }

        Guid? appId = Guid.TryParse(moveAppId, out Guid chosen) ? chosen : null;

        try
        {
            TicketService.TicketMove? moved = await Tickets.MoveAsync(
                TenantId, TicketId, customerId, appId, Actor, moveReason, DateTime.UtcNow);

            if (moved is not TicketService.TicketMove result)
            {
                Toasts.Error("That ticket no longer exists.");
                return;
            }

            Toasts.Success(result.WindowChanged
                ? $"Moved. It is now measured against {result.Ticket.SupportWindow} support hours."
                : "Moved.");

            showMove = false;

            // ⭐ A move can take the ticket out of the tenant this view is scoped to, and
            // when it does there is nothing here left to re-read. TenantId is a parameter,
            // bound by TicketQueue to the tenant the explorer has open and never updated by a
            // move; LoadAsync reads through it and Tickets.GetAsync filters on it. So
            // re-reading in place — which is what this used to do — handed back null, and the
            // entire body below (including "Back to the queue", which sits inside the same
            // @if) rendered as nothing immediately after a success toast: the move had
            // happened, and the screen said the ticket was gone with no way out of the blank
            // state but a page reload.
            //
            // Leaving is also what the other detail views do when an action takes the entity
            // out of the page's scope: AppDetail's unregister and the cluster delete finish
            // with OnDeleted, and TenantExplorer clears the selection rather than keeping a
            // detail view that can no longer resolve its row. OnBack first, so the panel is
            // never rendered against a tenant that cannot resolve the ticket.
            if (result.Ticket.TenantId != TenantId)
            {
                await OnBack.InvokeAsync();
                await OnChanged.InvokeAsync();
                return;
            }

            await LoadAsync();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            // The refusals here are things a person can act on — a number already taken on
            // the other side, an application belonging to somebody else — so they are shown
            // as they are written rather than as "something went wrong".
            Toasts.Error(ex.Message);
        }
    }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        error = null;

        try
        {
            now = DateTime.UtcNow;
            ticket = await Tickets.GetAsync(TenantId, TicketId);

            if (ticket is not null)
            {
                status = TicketService.StatusOf(ticket, now);
                formPriority = ticket.Priority;

                // Loaded here rather than on initialisation, because whose rota applies is
                // the ticket's tenant and that is not known until it has been read. Reloaded
                // with the ticket too, which is what a move to another tenant needs.
                roster = await Duty.GetActiveAsync(ticket.TenantId);

                mergedEntries = await Work.GetMergedHistoryAsync(TenantId, ticket.Id);
                offeredModules = await TextModules.OfferedAsync(TenantId, ticket.CustomerId);
                sharedDraft = await Drafts.GetSharedNoteAsync(TenantId, ticket.Id);
                macros = await Macros.ListAsync(TenantId, activeOnly: true);
                mergedInto = await MergedIntoAsync();

                // Anybody in the tenant with an address can be mentioned — not only who is on
                // the rota this week. Leaving out oneself: mentioning yourself mails yourself.
                colleagues = [.. (await Duty.GetRosterAsync(ticket.TenantId))
                    .Where(c => !string.IsNullOrWhiteSpace(c.Email) && c.Name != Actor)];
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task AfterChangeAsync(string message)
    {
        showPriority = showPause = showResolve = showReject = showNote = showMerge = false;
        formReason = "";
        formParty = null;

        Toasts.Success(message);
        await LoadAsync();
        await OnChanged.InvokeAsync();
    }

    /// <summary>
    /// §14.6 wants a written report within five working days of closing a P1. This records
    /// that it went — it does not write it, and nothing here pretends to.
    /// </summary>
    private async Task RecordIncidentReportAsync()
    {
        await Tickets.RecordIncidentReportAsync(TenantId, TicketId, Actor, DateTime.UtcNow);
        Toasts.Success("Recorded. §14.6's report is no longer outstanding for this ticket.");
        await LoadAsync();
        await OnChanged.InvokeAsync();
    }

    /// <summary>
    /// Takes the ticket.
    ///
    /// <para>Matched against the roster by name, because that is what the actor is — the
    /// signed-in user's name, which <see cref="SupportTechnician.Name"/> is built from. The
    /// point of finding them is the address: claiming a ticket should put the same repliable
    /// mail in your inbox that being handed one does, since replying to it is how the
    /// customer gets answered.</para>
    /// </summary>
    private async Task ClaimAsync()
    {
        SupportTechnician? me = roster?
            .Cast<SupportTechnician?>()
            .FirstOrDefault(t => t!.Value.Name == Actor);

        await Tickets.AssignAsync(TenantId, TicketId, Actor, Actor, DateTime.UtcNow, me?.UserId, me?.Email);

        Toasts.Success(
            me?.Email is null
                ? "Yours. You are not on the support rota, so nothing was mailed to you."
                : "Yours — the ticket is in your inbox, and replying to it answers the customer.");

        await LoadAsync();
        await OnChanged.InvokeAsync();
    }

    /// <summary>Hands it to somebody else on the rota, who is told by mail.</summary>
    private async Task HandToAsync(ChangeEventArgs e)
    {
        string? userId = e.Value?.ToString();

        if (string.IsNullOrWhiteSpace(userId) || roster is null)
        {
            return;
        }

        SupportTechnician? to = roster
            .Cast<SupportTechnician?>()
            .FirstOrDefault(t => t!.Value.UserId == userId);

        if (to is not { } technician)
        {
            return;
        }

        await Tickets.AssignAsync(TenantId, TicketId, technician.Name, Actor, DateTime.UtcNow,
            technician.UserId, technician.Email);

        Toasts.Success($"{technician.Name} has it, and has been told by mail.");
        await LoadAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task ReleaseAsync()
    {
        await Tickets.AssignAsync(TenantId, TicketId, null, Actor, DateTime.UtcNow);
        Toasts.Info("Back in the queue.");
        await LoadAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task RespondAsync()
    {
        await Tickets.RecordResponseAsync(TenantId, TicketId, Actor, DateTime.UtcNow);
        await AfterChangeAsync("Response recorded.");
    }

    private async Task ConfirmPriorityAsync()
    {
        if (string.IsNullOrWhiteSpace(formReason))
        {
            Toasts.Error("§14.3 requires a written reason for the priority.");
            return;
        }

        await Tickets.ConfirmPriorityAsync(TenantId, TicketId, formPriority, formReason, Actor, DateTime.UtcNow);
        await AfterChangeAsync("Priority recorded.");
    }

    private async Task StartPauseAsync()
    {
        if (string.IsNullOrWhiteSpace(formReason))
        {
            Toasts.Error("§14.4 requires the wait to be documented.");
            return;
        }

        await Tickets.StartPauseAsync(TenantId, TicketId, formWaitingOn, formParty, formReason, Actor, DateTime.UtcNow);
        await AfterChangeAsync("Clock paused.");
    }

    private async Task EndPauseAsync()
    {
        await Tickets.EndPauseAsync(TenantId, TicketId, Actor, DateTime.UtcNow);
        await AfterChangeAsync("Clock resumed.");
    }

    private async Task ResolveAsync()
    {
        if (string.IsNullOrWhiteSpace(formReason))
        {
            Toasts.Error("Say what resolved it — the customer sees this.");
            return;
        }

        if (Guard("Resolve", ResolveAsync))
        {
            return;
        }

        await Tickets.ResolveAsync(TenantId, TicketId, formReason, Actor, DateTime.UtcNow);
        await AfterChangeAsync("Resolved.");
    }

    private async Task RejectAsync()
    {
        if (string.IsNullOrWhiteSpace(formReason))
        {
            Toasts.Error("§14.4 requires the investigation to be documented.");
            return;
        }

        await Tickets.RejectAsync(TenantId, TicketId, formReason, Actor, DateTime.UtcNow);
        await AfterChangeAsync("Rejected and handed back.");
    }

    private async Task CloseAsync()
    {
        if (Guard("Close", CloseAsync))
        {
            return;
        }

        await Tickets.CloseAsync(TenantId, TicketId, Actor, DateTime.UtcNow);
        await AfterChangeAsync("Closed.");
    }

    private async Task AddNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(formReason))
        {
            return;
        }

        List<TicketWorkService.Mentioned> named = [.. (colleagues ?? [])
            .Where(c => mentioned.Contains(c.UserId))
            .Select(c => new TicketWorkService.Mentioned(c.UserId, c.Name, c.Email!))];

        autosave?.Cancel();
        PromptForTime(formReason);

        // Not conditional on knowing who this is: a shared draft the note was made from goes
        // either way, and an empty id simply matches no personal draft.
        await Drafts.NoteAddedAsync(TenantId, TicketId, userId ?? "", fromSharedDraft);

        fromSharedDraft = false;
        draftSavedAt = null;

        if (named.Count == 0)
        {
            await Tickets.AddEventAsync(TenantId, TicketId, TicketEventKind.Note, formReason, Actor, DateTime.UtcNow, formCustomerVisible);
            await AfterChangeAsync("Note added.");
            return;
        }

        List<string>? reached = await Work.AddNoteMentioningAsync(
            TenantId, TicketId, formReason, formCustomerVisible, named, Actor, DateTime.UtcNow);

        mentioned.Clear();

        List<string> missed = [.. named.Select(n => n.Name).Except(reached ?? [])];

        await AfterChangeAsync(missed.Count == 0
            ? $"Note added; {string.Join(", ", named.Select(n => n.Name))} told."
            : $"Note added. Could not mail {string.Join(", ", missed)} — they follow the ticket but have not been told.");
    }

    /// <summary>Opens the note form, bringing back what this person was typing here last time.</summary>
    private async Task ToggleNoteAsync()
    {
        showNote = !showNote;

        if (showNote && string.IsNullOrWhiteSpace(formReason) && userId is not null
            && await Drafts.GetPersonalNoteAsync(TenantId, TicketId, userId) is { } mine)
        {
            formReason = mine.Text;
            formCustomerVisible = mine.CustomerVisible;
            draftSavedAt = mine.At;
        }
    }

    /// <summary>
    /// Saves the note as it is typed, a second after the last keystroke — on the server, so it
    /// survives a reload, a dropped connection or a move to another instance.
    /// </summary>
    private Task OnNoteInputAsync(ChangeEventArgs e)
    {
        formReason = e.Value?.ToString() ?? "";
        return NoteTypedAsync();
    }

    private async Task NoteTypedAsync()
    {
        if (!showNote || userId is null)
        {
            return;
        }

        autosave?.Cancel();
        autosave = new CancellationTokenSource();
        CancellationToken token = autosave.Token;

        try
        {
            await Task.Delay(TimeSpan.FromSeconds(1), token);
            await Drafts.SavePersonalNoteAsync(TenantId, TicketId, userId, formReason, formCustomerVisible, token);
            draftSavedAt = string.IsNullOrWhiteSpace(formReason) ? null : DateTime.UtcNow;
        }
        catch (OperationCanceledException)
        {
            // A newer keystroke took over.
        }
    }

    private async Task ShareDraftAsync()
    {
        try
        {
            await Drafts.ShareNoteAsync(TenantId, TicketId, formReason, formCustomerVisible, Actor, overwrite: confirmOverwrite);
            confirmOverwrite = false;
            sharedDraft = await Drafts.GetSharedNoteAsync(TenantId, TicketId);
            Toasts.Success("Left on the ticket as a shared draft.");
        }
        catch (InvalidOperationException ex)
        {
            // Overwriting is final, so the first press only asks.
            confirmOverwrite = true;
            Toasts.Info($"{ex.Message} Press again to replace it.");
        }
        catch (ArgumentException ex)
        {
            Toasts.Error(ex.Message);
        }
    }

    private async Task LoadSharedDraftAsync()
    {
        if (sharedDraft is not { } shared)
        {
            return;
        }

        // Loading over what you have typed is asked about first.
        if (!string.IsNullOrWhiteSpace(formReason) && formReason != shared.Text && !loadOverwrites)
        {
            loadOverwrites = true;
            return;
        }

        loadOverwrites = false;
        showNote = true;
        formReason = shared.Text;
        formCustomerVisible = shared.CustomerVisible;
        fromSharedDraft = true;
        previewShared = false;
        await NoteTypedAsync();
    }

    private async Task DeleteSharedDraftAsync()
    {
        await Drafts.DeleteSharedNoteAsync(TenantId, TicketId);
        sharedDraft = null;
        previewShared = false;
        Toasts.Info("Shared draft deleted.");
    }

    /// <summary>Zammad's time accounting: after a note, ask — optionally — how long it took.</summary>
    private void PromptForTime(string note)
    {
        timePrompt = true;
        timeMinutes = null;
        string first = note.Split('\n', 2)[0].Trim();
        timeDescription = first.Length > 120 ? first[..120] : first;
    }

    private async Task LogPromptedTimeAsync()
    {
        if (timeMinutes is not int minutes || minutes < 1 || minutes > 24 * 60)
        {
            Toasts.Error("Say how many minutes, or skip.");
            return;
        }

        if (string.IsNullOrWhiteSpace(timeDescription))
        {
            Toasts.Error("§20 wants the work described so the customer can validate it.");
            return;
        }

        DateTime end = DateTime.UtcNow;

        try
        {
            await Time.LogAsync(TenantId, ticket!.CustomerId, ticket.AppId, ticket.Id,
                end.AddMinutes(-minutes), end, timeKind, timeDescription.Trim(), Actor);

            timePrompt = false;
            Toasts.Success($"{minutes} min logged.");
            await LoadAsync();
        }
        catch (ArgumentException ex)
        {
            Toasts.Error(ex.Message);
        }
    }

    private void ToggleMention(string userId, ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            mentioned.Add(userId);
        }
        else
        {
            mentioned.Remove(userId);
        }
    }

    // ───────────── Rename, copy, merge, split ─────────────

    private void StartRename()
    {
        renameTo = ticket!.Title;
        renaming = true;
    }

    private async Task OnRenameKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await RenameAsync();
        }
        else if (e.Key == "Escape")
        {
            renaming = false;
        }
    }

    private async Task RenameAsync()
    {
        try
        {
            await Work.RenameAsync(TenantId, TicketId, renameTo, Actor, DateTime.UtcNow);
            renaming = false;
            await AfterChangeAsync("Renamed.");
        }
        catch (ArgumentException ex)
        {
            Toasts.Error(ex.Message);
        }
    }

    private string TicketHref(int number) =>
        TenantSlug is null ? "" : $"/tenants/{TenantSlug}?section=tickets&ticket={number}";

    /// <summary>Zammad's ".", ".." and "...": the number, then the title, then the address.</summary>
    private string CopyText(int level)
    {
        string text = $"#{ticket!.Number}";

        if (level >= 2)
        {
            text += $": {ticket.Title}";
        }

        if (level >= 3 && TenantSlug is not null)
        {
            text += $"\n{Nav.ToAbsoluteUri(TicketHref(ticket.Number))}";
        }

        return text;
    }

    private async Task CopyAsync(string text)
    {
        try
        {
            await using IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/tickets.js");
            bool copied = await module.InvokeAsync<bool>("copy", text);

            if (copied)
            {
                Toasts.Info("Copied.");
            }
            else
            {
                Toasts.Error("The browser would not let us copy.");
            }
        }
        catch (JSException)
        {
            Toasts.Error("The browser would not let us copy.");
        }
    }

    private async Task<(int Number, Guid Id)?> MergedIntoAsync()
    {
        if (ticket?.MergedIntoTicketId is not Guid targetId)
        {
            return null;
        }

        Ticket? target = await Tickets.GetAsync(TenantId, targetId);
        return target is null ? null : (target.Number, target.Id);
    }

    private async Task MergeAsync()
    {
        if (mergeTarget is not int number)
        {
            Toasts.Error("Which ticket is the original?");
            return;
        }

        try
        {
            TicketWorkService.MergeResult? result = await Work.MergeAsync(
                TenantId, TicketId, number, mergeExclude, mergeReason, Actor, DateTime.UtcNow);

            if (result is not { } merged)
            {
                Toasts.Error("That ticket no longer exists.");
                return;
            }

            mergeTarget = null;
            mergeExclude = false;
            mergeReason = null;

            await AfterChangeAsync(merged.RecordedAsResponse
                ? $"Merged into #{merged.Target.Number}. Recorded as this ticket's first response{(merged.ResponseWasLate ? " — late" : "")}."
                : $"Merged into #{merged.Target.Number}.");
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            Toasts.Error(ex.Message);
        }
    }

    private void StartSplit(TicketEvent entry)
    {
        splitFrom = entry.Id;
        string first = entry.Detail.Split('\n', 2)[0].Trim();
        splitTitle = first.Length > 80 ? first[..80] : first;
    }

    private async Task SplitAsync(Guid entryId)
    {
        try
        {
            Ticket? created = await Work.SplitAsync(TenantId, TicketId, entryId, splitTitle, Actor, DateTime.UtcNow);
            splitFrom = null;

            if (created is null)
            {
                Toasts.Error("That entry is no longer on this ticket.");
                return;
            }

            await AfterChangeAsync($"#{created.Number} opened and linked as this ticket's child.");
        }
        catch (ArgumentException ex)
        {
            Toasts.Error(ex.Message);
        }
    }

    /// <summary>
    /// This ticket's history with the entries of duplicates merged into it, newest first —
    /// the whole matter in one list, without the duplicates' own records being rewritten.
    /// </summary>
    private IEnumerable<(TicketEvent Entry, int? FromNumber)> History() =>
        ticket!.Events.Select(e => (e, (int?)null))
            .Concat(mergedEntries.Select(m => (m.Event, (int?)m.FromNumber)))
            .OrderByDescending(x => x.Item1.At);

    /// <summary>
    /// Zammad's close guard: with checklist items still open, resolving or closing asks first.
    /// Returns true when it stopped to ask. The second time through — "anyway" — it lets go.
    /// </summary>
    private bool Guard(string label, Func<Task> action)
    {
        if (openChecklistItems == 0 || guardPassed)
        {
            guardPassed = false;
            return false;
        }

        guardedLabel = label;
        guardedAction = action;
        return true;
    }

    private bool guardPassed;

    private async Task ContinueGuardedAsync()
    {
        Func<Task>? action = guardedAction;
        guardedAction = null;
        guardPassed = true;

        if (action is not null)
        {
            await action();
        }
    }

    private IEnumerable<TextModule> MatchingModules()
    {
        string q = moduleQuery.Trim();
        return offeredModules.Where(m =>
            m.Name.Contains(q, StringComparison.OrdinalIgnoreCase) || m.Keywords.Contains(q, StringComparison.OrdinalIgnoreCase)).Take(10);
    }

    /// <summary>Adds the module, its placeholders filled from this ticket, to the end of the note.</summary>
    private void InsertModule(TextModule module)
    {
        Dictionary<string, string?> values = TextModuleRenderer.ValuesFor(
            ticket!, ticket!.Customer?.Name, null, References.For(ticket.Number), Actor, DateTime.UtcNow);

        string text = TextModuleRenderer.Render(module.Content, values);
        formReason = string.IsNullOrWhiteSpace(formReason) ? text : formReason.TrimEnd() + "\n\n" + text;
        moduleQuery = "";
    }

    private async Task RunMacroAsync()
    {
        if (!Guid.TryParse(macroChoice, out Guid macroId) || macros.All(m => m.Id != macroId))
        {
            Toasts.Error("Choose a macro.");
            return;
        }

        SupportTechnician? me = roster?.Cast<SupportTechnician?>().FirstOrDefault(t => t!.Value.Name == Actor);

        try
        {
            MacroRun? run = await Macros.RunAsync(TenantId, TicketId, macroId, Actor, (Actor, me?.UserId, me?.Email), DateTime.UtcNow);
            macroChoice = "";

            if (run is not { } done)
            {
                Toasts.Error("That macro or ticket is no longer there.");
                return;
            }

            if (done.AfterRun == MacroAfterRun.BackToQueue)
            {
                Toasts.Success($"Done: {string.Join(", ", done.Applied)}.");
                await OnBack.InvokeAsync();
                await OnChanged.InvokeAsync();
                return;
            }

            await AfterChangeAsync($"Done: {string.Join(", ", done.Applied)}.");
        }
        catch (InvalidOperationException ex)
        {
            Toasts.Error(ex.Message);
        }
    }

    private async Task ReloadAfterWorkAsync()
    {
        await LoadAsync();
        await OnChanged.InvokeAsync();
    }

    /// <summary>
    /// Who is acting. Left null until the component is given the signed-in user — the
    /// history records "unattributed" rather than guessing a name, because §14.6 makes
    /// these entries evidence.
    /// </summary>
    /// <summary>
    /// Overrides who is recorded, for a caller that knows better. Normally null, and the
    /// signed-in user is used — it was a parameter alone, and the ticket queue never
    /// passed one, so every confirmation and resolution was filed under nobody.
    /// </summary>
    [Parameter] public string? CurrentActor { get; set; }

    private string? resolvedActor;

    /// <summary>
    /// Who can be handed a ticket: enrolled, active and with an address to write to. Null
    /// until it has loaded, which is what the select waits for.
    /// </summary>
    private List<SupportTechnician>? roster;

    /// <summary>Who this is being done by. Resolved once, used everywhere below.</summary>
    private string Actor => CurrentActor ?? resolvedActor ?? EntKube.Web.Services.CurrentActor.Unattributed;

    private RenderFragment ClockCard(string label, ClockStatus clock, string note) => builder =>
    {
        int seq = 0;
        string text;
        string css;

        if (!clock.Budget.Exists)
        {
            (text, css) = ("no target", "text-muted");
        }
        else if (clock.MetAt is not null)
        {
            (text, css) = clock.Breached
                ? (clock.MetAt.Value.ToLocalTime().ToString("MMM d HH:mm") + " — late", "text-danger")
                : (clock.MetAt.Value.ToLocalTime().ToString("MMM d HH:mm"), "text-success");
        }
        else if (clock.Paused)
        {
            (text, css) = ("paused", "text-muted");
        }
        else if (clock.Deadline is not null)
        {
            (text, css) = clock.Breached
                ? (clock.Deadline.Value.ToLocalTime().ToString("MMM d HH:mm") + " — over", "text-danger")
                : ("due " + clock.Deadline.Value.ToLocalTime().ToString("MMM d HH:mm"), "");
        }
        else
        {
            (text, css) = ("—", "text-muted");
        }

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "border rounded p-3 h-100");
        builder.AddAttribute(seq++, "title", note);

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "small text-muted");
        builder.AddContent(seq++, label);
        builder.CloseElement();

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", $"fs-6 fw-semibold {css}");
        builder.AddContent(seq++, text);
        builder.CloseElement();

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "small text-muted");
        builder.AddContent(seq++, $"{(int)clock.Elapsed.TotalHours} h {clock.Elapsed.Minutes} min counted");
        builder.CloseElement();

        builder.CloseElement();
    };

    private static string PriorityClass(TicketPriority priority) => priority switch
    {
        TicketPriority.P1 => "bg-danger",
        TicketPriority.P2 => "bg-warning text-dark",
        TicketPriority.P3 => "bg-info text-dark",
        _ => "bg-secondary",
    };

    private static string EventClass(TicketEventKind kind) => kind switch
    {
        TicketEventKind.Reprioritised or TicketEventKind.Escalated => "bg-warning text-dark",
        TicketEventKind.Resolved or TicketEventKind.Closed => "bg-success",
        TicketEventKind.Rejected => "bg-dark",
        TicketEventKind.PauseStarted or TicketEventKind.PauseEnded => "bg-secondary",
        TicketEventKind.Responded => "bg-primary",
        _ => "bg-light text-dark border",
    };
}
