@using EntKube.Web.Data
@using EntKube.Web.Services
@using EntKube.Web.Services.Support
@using EntKube.Web.Services.Time
@inject TimeService Time

@* ═══════════════════════════════════════════════════════════════════
   A month of hours: what the timbank has left, and what has been
   committed. The numbers the billing system is handed, at the
   granularity §20 says the customer may validate them at.
   ═══════════════════════════════════════════════════════════════════ *@

<LoadingPanel Loading="@loading" Error="@error">
@if (!loading)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h6 class="mb-0">Hours — @month.ToString("MMMM yyyy")</h6>
            <div class="text-muted small">
                Billing happens elsewhere; these are the figures it is given.
            </div>
        </div>
        <div class="btn-group btn-group-sm">
            <button class="btn btn-outline-secondary" @onclick="() => ShiftMonth(-1)">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button class="btn btn-outline-secondary" @onclick="() => ShiftMonth(1)"
                    disabled="@(month >= DateTime.UtcNow.Date.AddDays(1 - DateTime.UtcNow.Day))">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>

    @if (bank.EntitledHours is not null)
    {
        <div class="row g-3 mb-3">
            <div class="col-sm-3">
                <div class="border rounded text-center p-3">
                    <div class="fs-4 fw-bold">@Hours(bank.EntitledHours.Value)</div>
                    <div class="small text-muted">Timbank</div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="border rounded text-center p-3">
                    <div class="fs-4 fw-bold text-primary">@Hours(bank.DrawnHours)</div>
                    <div class="small text-muted">Drawn</div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="border rounded text-center p-3">
                    <div class="fs-4 fw-bold @(bank.IsExhausted ? "text-danger" : "text-success")">
                        @Hours(bank.RemainingHours)
                    </div>
                    <div class="small text-muted">
                        @(bank.IsExhausted ? "Spent" : "Left — expires at month end")
                    </div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="border rounded text-center p-3 @(bank.OverspillHours > 0 ? "bg-warning-subtle" : "")">
                    <div class="fs-4 fw-bold">@Hours(bank.OverspillHours)</div>
                    <div class="small text-muted">Beyond the bank</div>
                </div>
            </div>
        </div>

        @if (bank.ByCategory.Count > 0)
        {
            <div class="mb-3 small">
                <span class="text-muted me-2">Drawn at:</span>
                @foreach ((SupportTimeCategory category, decimal hours) in bank.ByCategory.OrderBy(c => c.Key))
                {
                    <span class="badge bg-light text-dark border me-1">
                        @category @Hours(hours)
                        <span class="text-muted">×@category.BankFactor()</span>
                    </span>
                }
            </div>
        }
    }
    else
    {
        <div class="alert alert-light border py-2 small mb-3">
            <i class="bi bi-info-circle me-1"></i>
            Modell B — löpande räkning. There is no timbank; every hour below is billed.
        </div>
    }

    @if (committed.UnauthorisedHours > 0m)
    {
        <div class="alert alert-warning py-2 small">
            <i class="bi bi-exclamation-triangle me-1"></i>
            <strong>@Hours(committed.UnauthorisedHours) worked past the timbank with no recorded
            approval.</strong>
            §11.1 wants the customer's go-ahead before work beyond the bank, except for P1 and P2.
            Get it recorded before this reaches an invoice.
        </div>
    }

    <h6 class="mb-2">Committed hours</h6>
    @if (committed.Lines.Count == 0)
    {
        <EmptyState Icon="bi-stopwatch" Title="Nothing logged" Message="No time was booked this month." />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Day</th>
                        <th>Application</th>
                        <th>Ärende</th>
                        <th>Kind</th>
                        <th>Category</th>
                        <th class="text-end">Billed</th>
                        <th class="text-end">From bank</th>
                        <th>What</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (BillingLine line in committed.Lines.OrderBy(l => l.Day).ThenBy(l => l.TicketNumber))
                    {
                        <tr>
                            <td class="small text-nowrap">@line.Day.ToString("MMM d")</td>
                            <td class="small">@(line.AppName ?? "—")</td>
                            <td class="small text-muted">@(line.TicketNumber is int n ? $"#{n}" : "—")</td>
                            <td class="small text-muted">@line.Kind</td>
                            <td class="small">@line.Category</td>
                            <td class="text-end small fw-semibold">@Hours(line.BilledHours)</td>
                            <td class="text-end small text-muted">
                                @(line.BankHours > 0m ? Hours(line.BankHours) : "—")
                            </td>
                            <td class="small text-muted">@line.Description</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <th colspan="5" class="text-end small">Total</th>
                        <th class="text-end small">@Hours(committed.TotalHours)</th>
                        <th class="text-end small">@Hours(committed.Lines.Sum(l => l.BankHours))</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
}
</LoadingPanel>

@code {
    [Parameter, EditorRequired] public Guid CustomerId { get; set; }

    private bool loading = true;
    private string? error;

    private DateTime month = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1, 0, 0, 0, DateTimeKind.Utc);
    private TimebankStatement bank;
    private CommittedHoursStatement committed;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task ShiftMonth(int months)
    {
        month = month.AddMonths(months);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;

        try
        {
            bank = await Time.GetTimebankAsync(CustomerId, month);

            (DateTime from, DateTime to) = TimeService.MonthBounds(month);
            committed = await Time.GetCommittedHoursAsync(CustomerId, from, to);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private static string Hours(decimal hours) => $"{hours:0.##} h";
}
