@using EntKube.Web.Data
@using EntKube.Web.Services
@inject PrometheusService PrometheusService

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <select class="form-select form-select-sm" style="width:auto" @bind="filterState" @bind:after="ApplyFilter">
            <option value="">All states</option>
            <option value="firing">Firing</option>
            <option value="pending">Pending</option>
            <option value="inactive">Inactive</option>
        </select>
        <select class="form-select form-select-sm" style="width:auto" @bind="filterSeverity" @bind:after="ApplyFilter">
            <option value="">All severities</option>
            <option value="critical">Critical</option>
            <option value="warning">Warning</option>
            <option value="info">Info</option>
            <option value="none">None</option>
        </select>
        <input class="form-control form-control-sm" style="width:200px" placeholder="Search rules…"
               value="@filterSearch" @oninput="OnSearchInput" />
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="text-muted small">@filtered.Count of @rules.Count rules</span>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Load" disabled="@isLoading">
            <span class="bi bi-arrow-clockwise @(isLoading ? "spin" : "")"></span>
        </button>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-4 text-muted">
        <span class="bi bi-hourglass-split me-1"></span> Loading rules…
    </div>
}
else if (errorMessage is not null)
{
    <div class="alert alert-warning small py-2">
        <span class="bi bi-exclamation-triangle me-1"></span>@errorMessage
    </div>
}
else if (filtered.Count == 0)
{
    <div class="text-center py-4 text-muted">No rules match the filter.</div>
}
else
{
    @* Summary counts *@
    <div class="d-flex gap-3 mb-3 flex-wrap">
        @{
            int firingCount  = rules.Count(r => r.State == "firing");
            int pendingCount = rules.Count(r => r.State == "pending");
        }
        @if (firingCount > 0)
        {
            <span class="badge bg-danger px-2 py-1">@firingCount firing</span>
        }
        @if (pendingCount > 0)
        {
            <span class="badge bg-warning text-dark px-2 py-1">@pendingCount pending</span>
        }
        <span class="badge bg-success px-2 py-1">@rules.Count(r => r.State == "inactive") inactive</span>
    </div>

    @foreach (IGrouping<string, AlertRule> group in filtered.GroupBy(r => r.GroupName).OrderBy(g => g.Key))
    {
        <div class="mb-3">
            <div class="text-muted small fw-semibold mb-1 text-uppercase" style="letter-spacing:.05em">
                <span class="bi bi-collection me-1"></span>@group.Key
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <tbody>
                        @foreach (AlertRule rule in group.OrderBy(r => r.Name))
                        {
                            <tr style="cursor:pointer" @onclick="() => ToggleExpanded(rule)"
                                title="Show the rule's query">
                                <td style="width:90px">
                                    @StateIndicator(rule.State)
                                </td>
                                <td>
                                    <div class="fw-semibold small">@rule.Name</div>
                                    @if (!string.IsNullOrEmpty(rule.Summary))
                                    {
                                        <div class="text-muted" style="font-size:0.77rem">@rule.Summary</div>
                                    }
                                </td>
                                <td style="width:80px">
                                    @if (!string.IsNullOrEmpty(rule.Severity))
                                    {
                                        @SeverityBadge(rule.Severity)
                                    }
                                </td>
                                <td style="width:90px" class="text-muted small text-end">
                                    @if (rule.DurationSeconds > 0)
                                    {
                                        <span title="Fires after this duration">@FormatDuration(rule.DurationSeconds)</span>
                                    }
                                </td>
                                <td style="width:36px" class="text-end">
                                    @if (!string.IsNullOrEmpty(rule.RunbookUrl))
                                    {
                                        @* stopPropagation: the row toggles the query, so without this
                                           opening the runbook also expands the row behind it. *@
                                        <a href="@rule.RunbookUrl" target="_blank" class="btn btn-sm btn-link p-0" title="Runbook"
                                           @onclick:stopPropagation="true">
                                            <span class="bi bi-book"></span>
                                        </a>
                                    }
                                </td>
                            </tr>
                            @if (expandedRule == RuleKey(rule))
                            {
                                <tr>
                                    <td colspan="5" class="bg-light py-2 px-3">
                                        <div class="font-monospace small text-muted">@rule.Query</div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    /// <summary>
    /// Whose cluster this is. Every metric read goes through PrometheusService, which resolves the
    /// cluster tenant-first — a panel holding only a cluster id could name any cluster in the
    /// installation.
    /// </summary>
    [Parameter] public required Guid TenantId { get; set; }

    [Parameter] public required Guid ClusterId { get; set; }

    private List<AlertRule> rules = [];
    private List<AlertRule> filtered = [];
    private string filterState = "";
    private string filterSeverity = "";
    private string filterSearch = "";
    private string? expandedRule;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync() => await Load();

    private async Task Load()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        KubernetesOperationResult<List<AlertRule>> result = await PrometheusService.GetAlertRulesAsync(TenantId, ClusterId);
        if (result.IsSuccess)
        {
            rules = result.Data ?? [];
            ApplyFilter();
        }
        else
        {
            errorMessage = result.Error;
            rules = [];
            filtered = [];
        }
        isLoading = false;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        filterSearch = e.Value?.ToString() ?? string.Empty;
        ApplyFilter();
    }

    /// <summary>
    /// ⭐ Clicking a row shows that rule's PromQL. Nothing used to assign
    /// <see cref="expandedRule"/> at all.
    ///
    /// <para>The expand row was already written — <c>@if (expandedRule == …)</c> around
    /// <c>rule.Query</c> — but no row carried a click handler and no code path ever set the
    /// field, so the compiler said so plainly: <c>warning CS0649: Field
    /// 'AlertRulesPanel.expandedRule' is never assigned to, and will always have its default
    /// value null</c>. The condition was therefore constantly false and the query was dead
    /// markup: an operator looking at a rule they do not recognise had no way to see what it
    /// actually asks, because the click they would try did nothing.</para>
    ///
    /// <para>⚠️ The key is <c>group/name</c>, not the old condition's <c>Name + GroupName</c>.
    /// Bare concatenation of two free-form strings can collide — group "node" + rule "down" and
    /// group "no" + rule "dedown" both yield "nodedown" — and expanding one rule would then
    /// expand another. A separator that cannot appear in a Prometheus rule group name makes the
    /// key unambiguous.</para>
    /// </summary>
    private static string RuleKey(AlertRule rule) => $"{rule.GroupName}/{rule.Name}";

    /// <summary>Opens this rule's query, or closes it if it is the one already open.</summary>
    private void ToggleExpanded(AlertRule rule)
    {
        string key = RuleKey(rule);
        expandedRule = expandedRule == key ? null : key;
    }

    private void ApplyFilter()
    {
        filtered = rules.Where(r =>
            (string.IsNullOrEmpty(filterState)    || r.State == filterState) &&
            (string.IsNullOrEmpty(filterSeverity) || r.Severity == filterSeverity || (filterSeverity == "none" && string.IsNullOrEmpty(r.Severity))) &&
            (string.IsNullOrEmpty(filterSearch)   || r.Name.Contains(filterSearch, StringComparison.OrdinalIgnoreCase)
                                                  || r.Summary.Contains(filterSearch, StringComparison.OrdinalIgnoreCase))
        ).ToList();
    }

    /// <summary>
    /// The rule's <c>for:</c> window, with the remainder kept.
    ///
    /// <para>This used to collapse to the largest unit alone —
    /// <c>seconds >= 3600 ? $"{(int)(seconds / 3600)}h" : …</c> — which truncates rather than
    /// rounds and never shows what was dropped. A rule written <c>for: 90m</c> rendered as
    /// <b>"1h"</b> and <c>for: 2m30s</c> as <b>"2m"</b>, losing up to 59 minutes with no sign
    /// that anything was lost. The column is tooltipped "Fires after this duration", so the
    /// number is presented as the rule's actual pre-fire window, and this panel is the only
    /// place in EntKube that window is shown at all: the expanded row carries only the query,
    /// and the rules API is read-only, so there is no second surface to check it against.</para>
    ///
    /// <para>⚠️ Coarse single-unit truncation <em>is</em> right elsewhere in the repo — every
    /// "age" formatter (ClusterNodes, WorkloadsTab, ResourceTreePanel) does it, kubectl-style,
    /// because an age is approximate by nature. A <em>configured</em> duration is not: it is a
    /// number somebody chose, and the house treatment for one of those is
    /// <c>IdentityTab.FormatSeconds</c>, which carries the remainder and collapses to a single
    /// unit only when the remainder is zero. That is what this now does.</para>
    /// </summary>
    private static string FormatDuration(double seconds)
    {
        int total = (int)Math.Round(seconds);
        if (total < 60) return $"{total}s";

        int minutes = total / 60;
        if (minutes < 60) return total % 60 == 0 ? $"{minutes}m" : $"{minutes}m {total % 60}s";

        return minutes % 60 == 0 ? $"{minutes / 60}h" : $"{minutes / 60}h {minutes % 60}m";
    }

    /// <summary>
    /// ⭐ Only the state Prometheus actually calls quiet is painted as quiet.
    ///
    /// <para>The final arm used to be a bare <c>_ =></c> onto the green "OK" badge, so every
    /// state string that was not <c>firing</c> or <c>pending</c> — including an empty one —
    /// came out as a green check reading "OK". <c>ParseAlertRules</c> defaults
    /// <see cref="AlertRule.State"/> to <c>""</c> when the rules API omits the field, and the
    /// catch-all turned that absence of information into a positive reassurance. "I do not know
    /// what this rule is doing" and "this rule is fine" are not the same answer, and the green
    /// one is the one nobody investigates.</para>
    ///
    /// <para>⚠️ <b>This does not cover a rule whose evaluation is failing.</b> Prometheus
    /// reports two orthogonal things per alerting rule: <c>state</c> (inactive|pending|firing)
    /// and <c>health</c> (ok|err|unknown) with <c>lastError</c>. A rule with bad PromQL — after
    /// a metric rename, say — has <c>health: "err"</c> and <c>state: "inactive"</c>, because a
    /// rule that cannot be evaluated can never fire. So it still renders here as a legitimate
    /// "Inactive" and still lands in the green "inactive" badge above, while the alert it was
    /// written for can no longer fire at all. Fixing that needs the parser, not this method:
    /// <c>ParseAlertRules</c> (PrometheusService.cs) reads name/query/state/duration/labels/
    /// annotations and never reads <c>health</c> or <c>lastError</c>, and
    /// <see cref="AlertRule"/> has no field to put them in, so the information is discarded at
    /// the parse boundary and is not recoverable from this component. The sibling panel on the
    /// same page already shows what it should look like: <c>ParseScrapeTargets</c> reads both,
    /// and <c>ScrapeTargetsPanel</c> paints a red DOWN badge, a <c>table-danger</c> row and a
    /// panel-level "N targets down" banner.</para>
    /// </summary>
    private static RenderFragment StateIndicator(string state) => state switch
    {
        "firing"   => @<span class="badge bg-danger"><span class="bi bi-fire me-1"></span>Firing</span>,
        "pending"  => @<span class="badge bg-warning text-dark"><span class="bi bi-hourglass me-1"></span>Pending</span>,
        "inactive" => @<span class="badge bg-success-subtle text-success border"><span class="bi bi-check me-1"></span>OK</span>,
        ""         => @<span class="badge bg-secondary-subtle text-secondary border" title="Prometheus reported no state for this rule"><span class="bi bi-question-circle me-1"></span>Unknown</span>,
        _          => @<span class="badge bg-secondary-subtle text-secondary border" title="Unrecognised rule state: @state"><span class="bi bi-question-circle me-1"></span>@state</span>
    };

    private static RenderFragment SeverityBadge(string sev) => sev switch
    {
        "critical" => @<span class="badge bg-danger-subtle text-danger border">critical</span>,
        "warning"  => @<span class="badge bg-warning-subtle text-warning border">warning</span>,
        "info"     => @<span class="badge bg-info-subtle text-info border">info</span>,
        _          => @<span class="badge bg-secondary-subtle text-secondary border">@sev</span>
    };
}
