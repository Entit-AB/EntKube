@using EntKube.Web.Data
@using EntKube.Web.Services
@using EntKube.Web.Services.Support
@using EntKube.Web.Services.Tickets
@implements IAsyncDisposable
@inject KnowledgeBaseService KnowledgeBase
@inject TicketTemplateService Templates
@inject CurrentActor ActorService
@inject IJSRuntime JS
@inject ToastService Toasts
@inject TenantRoleService Roles
@inject UserAccessService Access
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthState
@inject NavigationManager Nav

@* The help-answer library (docs/helpdesk.md, phase 5). Public answers appear in customers'
   portals; internal ones are offered to agents only (?? in a reply). Bodies are sanitised on save. *@

<LoadingPanel Loading="@loading" Error="@error">
@if (!loading)
{
    @if (!mayEdit)
    {
        <div class="alert alert-light border py-2 small" data-test="kb-read-only">
            <i class="bi bi-lock me-1"></i>Only roles granted <strong>Support knowledge base: Edit</strong> change answers in this tenant. You can read them.
        </div>
    }
    <div class="row g-3" data-test="knowledge-base">
        <div class="col-lg-3 small">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <strong>Categories</strong>
                <button class="btn btn-sm btn-link p-0" @onclick="() => SelectCategory(null)">all answers</button>
            </div>
            <ul class="list-unstyled mb-2">
                @foreach ((KbCategory c, int depth) in Tree())
                {
                    <li style="padding-left: @(depth)rem" class="d-flex justify-content-between">
                        <button class="btn btn-sm btn-link p-0 text-start @(c.Id == categoryId ? "fw-semibold" : "")" @onclick="() => SelectCategory(c.Id)">@c.Name</button>
                        <button class="btn btn-sm btn-link text-muted p-0" title="Rename or move" @onclick="() => EditCategory(c)"><i class="bi bi-pencil"></i></button>
                    </li>
                }
                @if (categories.Count == 0) { <li class="text-muted">none yet</li> }
            </ul>
            @if (mayEdit)
            {
            <div class="border rounded p-2">
                <input class="form-control form-control-sm mb-1" placeholder="Category name" @bind="categoryName" />
                <select class="form-select form-select-sm mb-1" @bind="categoryParent" aria-label="Parent category">
                    <option value="">at the top</option>
                    @foreach ((KbCategory c, int depth) in Tree().Where(t => t.Category.Id != editingCategory))
                    {
                        <option value="@c.Id">@(new string('·', depth * 2)) @c.Name</option>
                    }
                </select>
                <AsyncButton CssClass="btn-sm btn-outline-primary" OnClick="SaveCategoryAsync">@(editingCategory is null ? "Add category" : "Save category")</AsyncButton>
                @if (editingCategory is Guid id)
                {
                    <button class="btn btn-sm btn-link" @onclick="() => { editingCategory = null; categoryName = string.Empty; categoryParent = string.Empty; }">Cancel</button>
                    <button class="btn btn-sm btn-link text-danger" @onclick="() => DeleteCategoryAsync(id)">Delete</button>
                }
            </div>
            }
        </div>

        <div class="col-lg-9">
            @if (answer is null)
            {
                <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
                    <strong class="small">@(categoryId is null ? "All answers" : categories.FirstOrDefault(c => c.Id == categoryId)?.Name)</strong>
                    @* Phase 11: one knowledge base — help answers and every application's runbook. *@
                    <select class="form-select form-select-sm w-auto" aria-label="Application" value="@appFilter" @onchange="e => appFilter = e.Value?.ToString() ?? string.Empty" data-test="kb-app-filter">
                        <option value="">Everything</option>
                        <option value="none">Help answers only</option>
                        @foreach ((Guid id, string name) in appNames.OrderBy(a => a.Value))
                        {
                            <option value="@id">@name</option>
                        }
                    </select>
                    @if (mayEdit)
                    {
                        <button class="btn btn-sm btn-primary" @onclick="NewAnswer" disabled="@(categories.Count == 0)"><i class="bi bi-plus me-1"></i>New answer</button>
                    }
                </div>
                <table class="table table-sm small align-middle">
                    <thead class="table-light"><tr><th>Title</th><th>Application</th><th>State</th><th>For</th><th>Updated</th></tr></thead>
                    <tbody>
                        @foreach (KbAnswer a in Shown())
                        {
                            <tr style="cursor: pointer" @onclick="() => OpenAnswerAsync(a)">
                                <td>@a.Title</td>
                                <td>@(a.AppId is Guid appOf ? appNames.GetValueOrDefault(appOf, "an application") + (a.Section is { } kind ? " · " + EntKube.Web.Services.Knowledge.KnowledgeService.SectionName(kind) : "") : "—")</td>
                                <td><span class="badge @StateClass(KnowledgeBaseService.StateOf(a, DateTime.UtcNow))">@KnowledgeBaseService.StateOf(a, DateTime.UtcNow)</span></td>
                                <td>@(a.CustomerId is Guid c ? customers.FirstOrDefault(x => x.Id == c).Name : "everyone")</td>
                                <td class="text-muted">@a.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd") @a.UpdatedBy</td>
                            </tr>
                        }
                        @if (!Shown().Any()) { <tr><td colspan="5" class="text-muted">No answers here yet.</td></tr> }
                    </tbody>
                </table>
            }
            else
            {
                <div class="border rounded p-3 small" data-test="answer-editor">
                    @if (answer.AppId is Guid editingApp)
                    {
                        <div class="alert alert-dark py-2 small" data-test="kb-app-answer">
                            <i class="bi bi-shield-lock me-1"></i>
                            <strong>@appNames.GetValueOrDefault(editingApp, "An application")</strong>'s knowledge — agents only.
                            Never shown in the portal, never offered by <code>??</code>.
                        </div>
                    }
                    @if (move is { Verdict: not MoveVerdict.Exact } moved)
                    {
                        <div class="alert alert-warning py-2 small" data-test="kb-move-verdict">
                            <i class="bi bi-arrow-left-right me-1"></i>
                            Moved from the application's runbook (@moved.Verdict.ToString().ToLowerInvariant()). @moved.Notes
                            The markdown it was written in is under <strong>History</strong>.
                        </div>
                    }
                    <div class="row g-2 mb-2">
                        <div class="col-md-6"><label class="form-label text-muted">Title</label><input class="form-control form-control-sm" @bind="answer.Title" /></div>
                        <div class="col-md-3">
                            <label class="form-label text-muted">Category</label>
                            <select class="form-select form-select-sm" value="@answer.CategoryId" @onchange="e => answer.CategoryId = Guid.TryParse(e.Value?.ToString(), out Guid g) ? g : answer.CategoryId">
                                @foreach ((KbCategory c, int depth) in Tree())
                                {
                                    <option value="@c.Id">@(new string('·', depth * 2)) @c.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted">Language</label>
                            <input class="form-control form-control-sm" list="kb-languages" @bind="answer.Language" />
                            <datalist id="kb-languages"><option value="sv"></option><option value="en"></option><option value="fi"></option><option value="no"></option><option value="da"></option></datalist>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted">Who sees it</label>
                            <select class="form-select form-select-sm" @bind="answer.Visibility">
                                @if (answer.AppId is not null)
                                {
                                    <option value="@KbVisibility.Operations">Operations — agents only</option>
                                    <option value="@KbVisibility.Archived">Archived — nobody</option>
                                }
                                else
                                {
                                <option value="@KbVisibility.Draft">Draft — nobody yet</option>
                                <option value="@KbVisibility.Internal">Internal — agents may insert it into replies to customers (??)</option>
                                <option value="@KbVisibility.Operations">Operations — our own operating knowledge; never offered in replies, never shown to customers</option>
                                <option value="@KbVisibility.Public">Public — customers too</option>
                                <option value="@KbVisibility.Archived">Archived — nobody</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted">Publish from (Swedish time)</label>
                            <input class="form-control form-control-sm" type="datetime-local" @bind="publishLocal" @bind:format="yyyy-MM-ddTHH:mm"
                                   disabled="@(answer.Visibility != KbVisibility.Public || answer.AppId is not null)" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted">@(answer.AppId is null ? "For" : "Section")</label>
                            @if (answer.AppId is not null)
                            {
                                <select class="form-select form-select-sm" @bind="answer.Section" aria-label="Section">
                                    @foreach (KnowledgeSectionKind kind in Enum.GetValues<KnowledgeSectionKind>())
                                    {
                                        <option value="@kind">@EntKube.Web.Services.Knowledge.KnowledgeService.SectionName(kind)</option>
                                    }
                                </select>
                            }
                            else
                            {
                            <select class="form-select form-select-sm" @bind="customerChoice">
                                <option value="">every customer</option>
                                @foreach ((Guid customerOptionId, string name) in customers)
                                {
                                    <option value="@customerOptionId">@name only</option>
                                }
                            </select>
                            }
                        </div>
                        <div class="col-md-3"><label class="form-label text-muted">Keywords</label><input class="form-control form-control-sm" @bind="answer.Keywords" /></div>
                    </div>
                    @* Keyed per opening: Quill puts its toolbar BESIDE the element, where Blazor cannot
                       see it, so reopening (Restore does, in one handler) must replace the wrapper. *@
                    <div @key="editorSession">
                        <div @ref="editor" style="min-height: 12rem" class="bg-white mb-2"></div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-8">
                            <input class="form-control form-control-sm" placeholder="What changed and why (optional, kept in the history)" @bind="changeSummary" aria-label="Change summary" />
                        </div>
                        <div class="col-md-4 text-muted d-flex align-items-center gap-2">
                            @if (answer.Id != Guid.Empty)
                            {
                                <span data-test="kb-review">Confirmed @(answer.ReviewedAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "never")@(answer.ReviewedBy is { } by ? $" by {by}" : "")</span>
                                @if (MayEditThis)
                                {
                                    <AsyncButton CssClass="btn-sm btn-outline-success" OnClick="StillTrueAsync">Still true</AsyncButton>
                                }
                            }
                        </div>
                    </div>

                    @if (revisions.Count > 0)
                    {
                        <details class="mb-2" data-test="kb-history">
                            <summary class="text-muted">History (@revisions.Count earlier version@(revisions.Count == 1 ? "" : "s"))</summary>
                            <ul class="list-unstyled mt-2 mb-0">
                                @foreach (KbAnswerRevision r in revisions)
                                {
                                    <li class="border-top py-2">
                                        <div class="d-flex justify-content-between">
                                            <span class="text-muted">@r.SavedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · @(r.SavedBy ?? "unknown")@(r.Summary is { } why ? $" — {why}" : "")</span>
                                            @if (MayEditThis)
                                            {
                                                <AsyncButton CssClass="btn-sm btn-link p-0" OnClick="() => RestoreAsync(r)">Restore</AsyncButton>
                                            }
                                        </div>
                                        <div class="kb-prose border rounded p-2 mt-1 bg-white">
                                            @if (r.BodyFormat == KbBodyFormat.Markdown)
                                            {
                                                @EntKube.Web.Services.Knowledge.KnowledgeMarkdown.Render(r.Body)
                                            }
                                            else
                                            {
                                                @((MarkupString)RichText.Sanitize(r.Body))
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                        </details>
                    }

                    @* Phase 10: related answers, shown on both; customers see only those they could open. *@
                    <div class="mb-2" data-test="related-answers">
                        <span class="text-muted me-1">Related answers:</span>
                        @foreach (KbAnswer r in related)
                        {
                            <span class="badge bg-light text-dark border me-1">
                                @r.Title
                                @if (mayEdit)
                                {
                                    <button class="btn btn-sm btn-link p-0 ms-1 text-muted" aria-label="@($"Unrelate {r.Title}")" @onclick="() => related.Remove(r)"><i class="bi bi-x"></i></button>
                                }
                            </span>
                        }
                        @if (related.Count == 0) { <span class="text-muted">none</span> }
                        @if (mayEdit)
                        {
                            <select class="form-select form-select-sm d-inline-block w-auto ms-2" aria-label="Add a related answer" value="" @onchange="AddRelated">
                                <option value="">add one…</option>
                                @foreach (KbAnswer other in allAnswers.Where(o => o.Id != answer.Id && related.All(r => r.Id != o.Id)))
                                {
                                    <option value="@other.Id">@other.Title</option>
                                }
                            </select>
                        }
                    </div>

                    @if (usedOn.Count > 0)
                    {
                        <div class="mb-2" data-test="answer-used-on">
                            <span class="text-muted me-1">Given on tickets:</span>
                            @foreach ((Guid _, int number, string title) in usedOn)
                            {
                                <a class="me-2" href="@Nav.GetUriWithQueryParameters(new Dictionary<string, object?> { ["section"] = "tickets", ["ticket"] = number, ["answer"] = null })" title="@title">#@number</a>
                            }
                        </div>
                    }

                    <div class="d-flex justify-content-between">
                        <span>
                            @if (answer.Id != Guid.Empty && MayEditThis)
                            {
                                <button class="btn btn-sm btn-link text-danger p-0" @onclick="DeleteAnswerAsync">Delete</button>
                            }
                        </span>
                        <span>
                            <button class="btn btn-sm btn-link" @onclick="CloseAnswer">@(MayEditThis ? "Cancel" : "Close")</button>
                            @if (MayEditThis)
                            {
                                <AsyncButton CssClass="btn-sm btn-primary" OnClick="SaveAnswerAsync">Save</AsyncButton>
                            }
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
}
</LoadingPanel>

@code {
    [Parameter, EditorRequired] public Guid TenantId { get; set; }

    /// <summary>An answer to open on arrival — quick search links here. Only this tenant's opens.</summary>
    [Parameter] public Guid? OpenAnswerId { get; set; }

    private Guid? openedFromAddress;
    private bool loading = true;

    // Phase 10. mayEdit: the opt-in editor permission (TenantFeature.KnowledgeBase); checked in
    // every write handler too, since those run on the server whatever the page shows.
    private bool mayEdit = true;
    private List<KbAnswer> allAnswers = [];

    // Phase 11: applications' knowledge in the same list.
    private Dictionary<Guid, string> appNames = [];
    private string appFilter = "";
    private List<KbAnswerRevision> revisions = [];
    private KnowledgeSectionMove? move;
    private string? changeSummary;

    /// <summary>
    /// The user's two rules (2026-11-18): help answers follow the knowledge-base editor permission;
    /// an application's runbook stays editable by anyone who can open the application.
    /// </summary>
    private bool MayEditThis => mayEdit || answer?.AppId is not null;

    private IEnumerable<KbAnswer> Shown() => appFilter switch
    {
        "" => answers,
        "none" => answers.Where(a => a.AppId is null),
        _ => Guid.TryParse(appFilter, out Guid only) ? answers.Where(a => a.AppId == only) : answers,
    };
    private List<KbAnswer> related = [];
    private List<(Guid Id, int Number, string Title)> usedOn = [];
    private string? error;
    private List<KbCategory> categories = [];
    private List<KbAnswer> answers = [];
    private List<(Guid Id, string Name)> customers = [];
    private Guid? categoryId;
    private Guid? editingCategory;
    private string categoryName = "";
    private string categoryParent = "";
    private KbAnswer? answer;
    private DateTime? publishLocal;
    private string customerChoice = "";
    private ElementReference editor;
    private IJSObjectReference? module;
    private DotNetObjectReference<KnowledgeBaseTab>? self;
    private bool editorPending;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            categories = await KnowledgeBase.CategoriesAsync(TenantId);
            customers = await Templates.CustomersAsync(TenantId);
            answers = await KnowledgeBase.AnswersAsync(TenantId, categoryId);
            allAnswers = await KnowledgeBase.AnswersAsync(TenantId, null);
            appNames = await KnowledgeBase.AppNamesAsync(TenantId);
            mayEdit = await MayEditAsync();

            if (OpenAnswerId is Guid wanted && wanted != openedFromAddress)
            {
                openedFromAddress = wanted;

                if (await KnowledgeBase.GetAsync(TenantId, wanted) is { } found)
                {
                    await OpenAnswerAsync(found);
                }
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!editorPending || answer is null)
        {
            return;
        }

        editorPending = false;

        // Taken before the first await: clicks are handled while Quill loads, so the answer may
        // have been closed, or another opened on a new element, by the time it is ready.
        Guid session = editorSession;
        ElementReference element = editor;
        string body = RichText.Sanitize(answer.BodyHtml);

        try
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/ticket-editor.js");

            if (session != editorSession || answer is null)
            {
                return;
            }

            self ??= DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("create", element, self, "Write the answer…", new { tables = true });

            if (session != editorSession || answer is null)
            {
                await module.InvokeVoidAsync("dispose", element);
                return;
            }

            await module.InvokeVoidAsync("setHtml", element, body);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
            if (ex is JSException)
            {
                Toasts.Error($"The editor could not start: {ex.Message}");
            }
        }
    }

    // The shared editor module reports its triggers; this editor has no use for them.
    [JSInvokable] public Task OnTextModuleTrigger(string? query) => Task.CompletedTask;
    [JSInvokable] public Task OnKnowledgeTrigger(string? query) => Task.CompletedTask;

    /// <summary>The categories as a tree, depth-first, each with its depth.</summary>
    private IEnumerable<(KbCategory Category, int Depth)> Tree()
    {
        IEnumerable<(KbCategory, int)> Walk(Guid? parent, int depth) =>
            categories.Where(c => c.ParentId == parent).SelectMany(c => new[] { (c, depth) }.Concat(Walk(c.Id, depth + 1)));
        return Walk(null, 0);
    }

    private async Task SelectCategory(Guid? id)
    {
        categoryId = id;
        answers = await KnowledgeBase.AnswersAsync(TenantId, categoryId);
    }

    private void EditCategory(KbCategory c)
    {
        editingCategory = c.Id;
        categoryName = c.Name;
        categoryParent = c.ParentId?.ToString() ?? "";
    }

    /// <summary>
    /// Whether this person may change the knowledge base: always, until some role in the tenant is
    /// granted "Support knowledge base: Edit"; after that, members of such roles and global admins.
    /// </summary>
    private async Task<bool> MayEditAsync()
    {
        string? userId = (await AuthState.GetAuthenticationStateAsync()).User
            .FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        (bool anyRoleGrants, bool granted) = await Roles.FeatureGrantAsync(TenantId, userId, TenantFeature.KnowledgeBase, AccessLevel.Edit);

        return !anyRoleGrants || granted || (userId is not null && await Access.IsGlobalAdminAsync(userId));
    }

    private bool Refused()
    {
        if (MayEditThis)
        {
            return false;
        }

        Toasts.Error("Only knowledge-base editors can change the knowledge base here.");
        return true;
    }

    private void AddRelated(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out Guid id) && allAnswers.FirstOrDefault(a => a.Id == id) is { } other
            && related.All(r => r.Id != id))
        {
            related.Add(other);
        }
    }

    private async Task SaveCategoryAsync()
    {
        if (Refused()) return;

        Guid? parent = Guid.TryParse(categoryParent, out Guid p) && categories.Any(c => c.Id == p) ? p : null;

        try
        {
            await KnowledgeBase.SaveCategoryAsync(TenantId, editingCategory, categoryName, parent);
            editingCategory = null;
            categoryName = "";
            categoryParent = "";
            categories = await KnowledgeBase.CategoriesAsync(TenantId);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Toasts.Error(ex.Message);
        }
    }

    private async Task DeleteCategoryAsync(Guid id)
    {
        if (Refused()) return;

        try
        {
            await KnowledgeBase.DeleteCategoryAsync(TenantId, id);
            editingCategory = null;
            categoryName = "";
            categories = await KnowledgeBase.CategoriesAsync(TenantId);
            if (categoryId == id) await SelectCategory(null);
        }
        catch (InvalidOperationException ex)
        {
            Toasts.Error(ex.Message);
        }
    }

    private void NewAnswer()
    {
        OpenAnswer(new KbAnswer
        {
            Title = "", CategoryId = categoryId ?? Tree().First().Category.Id, Visibility = KbVisibility.Draft, Language = "sv",
        });
        related = [];
        usedOn = [];
    }

    private async Task OpenAnswerAsync(KbAnswer a)
    {
        OpenAnswer(a);
        related = a.Id == Guid.Empty ? [] : await KnowledgeBase.RelatedAsync(TenantId, a.Id);
        usedOn = a.Id == Guid.Empty ? [] : await KnowledgeBase.TicketsUsingAsync(TenantId, a.Id);
        revisions = a.Id == Guid.Empty ? [] : await KnowledgeBase.RevisionsAsync(TenantId, a.Id);
        move = a.Id == Guid.Empty ? null : await KnowledgeBase.MoveOfAsync(TenantId, a.Id);
        changeSummary = null;
    }

    private void OpenAnswer(KbAnswer a)
    {
        answer = new KbAnswer
        {
            Id = a.Id, Title = a.Title, CategoryId = a.CategoryId, BodyHtml = a.BodyHtml, Language = a.Language,
            Visibility = a.Visibility, PublishAt = a.PublishAt, CustomerId = a.CustomerId, Keywords = a.Keywords,
            AppId = a.AppId, Section = a.Section, ReviewedAt = a.ReviewedAt, ReviewedBy = a.ReviewedBy,
        };
        publishLocal = a.PublishAt is DateTime p ? BusinessCalendar.ToLocal(p) : null;
        customerChoice = a.CustomerId?.ToString() ?? "";
        editorSession = Guid.NewGuid();
        editorPending = true;
    }

    private Guid editorSession;

    private async Task CloseAnswer()
    {
        if (module is not null)
        {
            await module.InvokeVoidAsync("dispose", editor);
        }

        answer = null;
    }

    private async Task SaveAnswerAsync()
    {
        if (Refused()) return;

        answer!.BodyHtml = module is null ? answer.BodyHtml : await module.InvokeAsync<string>("html", editor);
        answer.PublishAt = publishLocal is DateTime local
            ? TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(local, DateTimeKind.Unspecified), BusinessCalendar.SwedishTime)
            : null;
        answer.CustomerId = Guid.TryParse(customerChoice, out Guid c) && customers.Any(x => x.Id == c) ? c : null;

        try
        {
            KbAnswer saved = await KnowledgeBase.SaveAnswerAsync(TenantId, answer, await ActorService.NameAsync(), default, changeSummary);
            await KnowledgeBase.SetRelatedAsync(TenantId, saved.Id, [.. related.Select(r => r.Id)]);
            Toasts.Success("Saved.");
            await CloseAnswer();
            answers = await KnowledgeBase.AnswersAsync(TenantId, categoryId);
            allAnswers = await KnowledgeBase.AnswersAsync(TenantId, null);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Toasts.Error(ex.Message);
        }
    }

    private async Task StillTrueAsync()
    {
        if (answer is null || Refused()) return;

        await KnowledgeBase.MarkReviewedAsync(TenantId, answer.Id, await ActorService.NameAsync(), DateTime.UtcNow);
        answer.ReviewedAt = DateTime.UtcNow;
        answer.ReviewedBy = await ActorService.NameAsync();
        Toasts.Success("Confirmed as still true.");
    }

    private async Task RestoreAsync(KbAnswerRevision r)
    {
        if (answer is null || Refused()) return;

        if (await KnowledgeBase.RestoreAsync(TenantId, answer.Id, r.Id, await ActorService.NameAsync()) is { } restored)
        {
            Toasts.Success("Earlier version restored; what it said before is kept in the history.");
            await CloseAnswer();
            await OpenAnswerAsync(restored);
            answers = await KnowledgeBase.AnswersAsync(TenantId, categoryId);
        }
    }

    private async Task DeleteAnswerAsync()
    {
        if (Refused()) return;

        await KnowledgeBase.DeleteAnswerAsync(TenantId, answer!.Id);
        await CloseAnswer();
        answers = await KnowledgeBase.AnswersAsync(TenantId, categoryId);
    }

    private static string StateClass(string state) => state switch
    {
        "public" => "bg-success",
        "scheduled" => "bg-info text-dark",
        "internal" => "bg-warning text-dark",
        "archived" => "bg-secondary",
        "operations" => "bg-dark",
        _ => "bg-light text-dark border",
    };

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (module is not null)
            {
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }

        self?.Dispose();
    }
}
