@using System.ComponentModel.DataAnnotations
@using EntKube.Web.Data
@using EntKube.Web.Services
@using Microsoft.EntityFrameworkCore
@inject IncidentService IncidentService
@inject IDbContextFactory<EntKube.Web.Data.Modules.SupportDbContext> DbFactory
@inject EntKube.Contracts.Delivery.IDeliveryApi Delivery
@inject ToastService Toasts

<ConfirmDialog Visible="@(pendingConfirm is not null)"
               Message="@(pendingConfirm?.Message ?? "")"
               ConfirmText="@(pendingConfirm?.ConfirmText ?? "Delete")"
               IsBusy="confirmBusy"
               OnConfirm="RunPendingConfirmAsync"
               OnCancel="() => pendingConfirm = null" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h6 class="mb-0">SLA Targets</h6>
    <button class="btn btn-sm btn-primary" @onclick="ShowAdd">
        <span class="bi bi-plus-lg"></span> Add Target
    </button>
</div>

<div class="text-muted small mb-3">
    Define uptime targets per customer or app. More specific targets (app > customer) take precedence.
</div>

@if (targets.Count == 0)
{
    <EmptyState Icon="bi-shield"
                Title="No SLA targets"
                Message="Add one to track uptime compliance." />
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>Scope</th>
                    <th>Target</th>
                    <th>Window</th>
                    <th>Compliance (30d)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (SlaTargetRow row in targets)
                {
                    <tr>
                        <td>
                            @if (row.AppName is not null)
                            {
                                <span><span class="bi bi-app me-1 text-muted"></span>@row.AppName</span>
                                <div class="text-muted small">@row.CustomerName</div>
                            }
                            else if (row.CustomerName is not null)
                            {
                                <span><span class="bi bi-person me-1 text-muted"></span>@row.CustomerName</span>
                            }
                            else
                            {
                                <span class="text-muted">All customers (tenant default)</span>
                            }
                        </td>
                        <td class="fw-semibold">@row.Target.TargetPercent.ToString("F1")%</td>
                        <td class="text-muted small">@row.Target.MeasurementWindowDays days</td>
                        <td>
                            @if (row.CompliancePercent.HasValue)
                            {
                                bool met = row.CompliancePercent.Value >= row.Target.TargetPercent;
                                <span class="@(met ? "text-success" : "text-danger") fw-semibold">
                                    <span class="bi bi-@(met ? "check-circle" : "exclamation-circle") me-1"></span>
                                    @row.CompliancePercent.Value.ToString("F2")%
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">No data</span>
                            }
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-danger"
                                    aria-label="@($"Delete SLA target for {row.AppName ?? row.CustomerName ?? "all customers"}")"
                                    @onclick='() => pendingConfirm = new PendingConfirm($"Delete the SLA target for \"{row.AppName ?? row.CustomerName ?? "all customers (tenant default)"}\"? This cannot be undone.", "Delete target", () => Delete(row.Target))'>
                                <span class="bi bi-trash"></span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (showAdd)
{
    <div class="card mt-3 border-primary">
        <div class="card-header d-flex justify-content-between align-items-center py-2">
            <h6 class="mb-0">Add SLA Target</h6>
            <button class="btn-close btn-sm" @onclick="() => showAdd = false"></button>
        </div>
        <div class="card-body">
            <EditForm Model="slaForm" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small">Customer (optional)</label>
                        <InputSelect class="form-select form-select-sm" @bind-Value="slaForm.CustomerId" @bind-Value:after="OnCustomerChanged">
                            <option value="">All customers (tenant default)</option>
                            @foreach (Customer c in customers)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small">App (optional)</label>
                        <InputSelect class="form-select form-select-sm" @bind-Value="slaForm.AppId" disabled="@(filteredApps.Count == 0)">
                            <option value="">All apps for selected customer</option>
                            @foreach (EntKube.Web.Data.App a in filteredApps)
                            {
                                <option value="@a.Id">@a.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">Uptime Target (%)</label>
                        <InputNumber class="form-control form-control-sm" step="0.1" @bind-Value="slaForm.TargetPercent" />
                        <ValidationMessage For="() => slaForm.TargetPercent" class="text-danger small" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">Measurement Window (days)</label>
                        <InputSelect class="form-select form-select-sm" @bind-Value="slaForm.WindowDays">
                            <option value="7">7 days</option>
                            <option value="30">30 days</option>
                            <option value="90">90 days</option>
                        </InputSelect>
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary" disabled="@saving">
                        @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Save Target
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => showAdd = false">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    // What the person may do here, handed down by the support desk. Every write below asks
    // SupportGuard first; nothing handed down means nothing allowed.
    [CascadingParameter] public EffectivePermissions? Permissions { get; set; }

    [Parameter] public required Guid TenantId { get; set; }

    private List<SlaTargetRow> targets = [];
    private List<Customer> customers = [];
    private List<EntKube.Web.Data.App> filteredApps = [];
    private bool showAdd;
    private bool saving;
    private SlaTargetForm slaForm = new();

    private sealed class SlaTargetForm
    {
        public Guid? CustomerId { get; set; }

        public Guid? AppId { get; set; }

        [Range(50, 100, ErrorMessage = "Target must be between 50% and 100%.")]
        public double TargetPercent { get; set; } = 99.9;

        public int WindowDays { get; set; } = 30;
    }

    // A destructive action awaiting user confirmation.
    private sealed record PendingConfirm(string Message, string ConfirmText, Func<Task> Action);
    private PendingConfirm? pendingConfirm;
    private bool confirmBusy;

    private async Task RunPendingConfirmAsync()
    {
        if (pendingConfirm is null) return;
        confirmBusy = true;
        try { await pendingConfirm.Action(); }
        finally { confirmBusy = false; pendingConfirm = null; }
    }

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        // ⚠️ Support's own context. This page was on ApplicationDbContext because it needed three
        // modules at once: Support's SlaTargets, Delivery's deployments and health snapshots, and
        // the Customers hub. Delivery's two are asked through IDeliveryApi now, and Customers is a
        // hub — exposed as a read-only IQueryable on every module context — so what is left is
        // Support's own table. docs/decomposition.md §4.0.2.
        using EntKube.Web.Data.Modules.SupportDbContext db = DbFactory.CreateDbContext();

        customers = await db.Customers
            .Include(c => c.Apps)
            .Where(c => c.TenantId == TenantId)
            .OrderBy(c => c.Name)
            .ToListAsync();

        List<SlaTarget> slaTargets = await db.SlaTargets
            .Include(s => s.Customer)
            .Include(s => s.App)
            .Where(s => s.TenantId == TenantId)
            .OrderBy(s => s.Customer!.Name).ThenBy(s => s.App!.Name)
            .ToListAsync();

        // Every deployment of this tenant's, once. This was a query PER TARGET: the scope
        // predicate differs per target, but the set it filters does not.
        List<EntKube.Contracts.Delivery.DeploymentSummary> allDeployments =
            [.. await Delivery.GetDeploymentsForTenantAsync(TenantId)];

        // DeploymentSummary carries no CustomerId, because a deployment reaches its customer
        // through its app — Delivery's own traversal, and not something the contract needs to
        // expose for this. The customers above are already loaded with their apps, so the map is
        // free rather than another query.
        Dictionary<Guid, Guid> customerOfApp = customers
            .SelectMany(c => c.Apps.Select(a => new { AppId = a.Id, CustomerId = c.Id }))
            .ToDictionary(x => x.AppId, x => x.CustomerId);

        // One health-ratio call per DISTINCT window rather than per target, which is what
        // ErrorBudgetService does with the same contract and for the same reason. Targets on the
        // same window — and 30 days is the default — share a call.
        DateTime now = DateTime.UtcNow;
        List<Guid> allIds = [.. allDeployments.Select(d => d.Id)];

        Dictionary<int, Dictionary<Guid, EntKube.Contracts.Delivery.DeploymentHealthRatio>> byWindow = [];

        foreach (int window in slaTargets.Select(t => t.MeasurementWindowDays).Distinct())
        {
            byWindow[window] =
                (await Delivery.GetHealthRatiosAsync(TenantId, allIds, now.AddDays(-window), now))
                    .ToDictionary(r => r.DeploymentId);
        }

        targets = [];
        foreach (SlaTarget t in slaTargets)
        {
            List<Guid> deploymentIds = [.. allDeployments
                .Where(d => (t.AppId == null || d.AppId == t.AppId)
                         && (t.CustomerId == null
                             || (customerOfApp.TryGetValue(d.AppId, out Guid owner)
                                 && owner == t.CustomerId)))
                .Select(d => d.Id)];

            double? compliance = null;

            if (deploymentIds.Count > 0)
            {
                Dictionary<Guid, EntKube.Contracts.Delivery.DeploymentHealthRatio> ratios =
                    byWindow[t.MeasurementWindowDays];

                // ⚠️ POOLED, not the mean of per-deployment ratios. The two give different answers
                // and this page has always pooled: every sample in scope counted once, so a busy
                // deployment weighs more than a quiet one. Summing HealthySamples and
                // TotalSamples across the scope is the same arithmetic the removed snapshot query
                // did, with the counting left in the database.
                int healthy = 0, total = 0;

                foreach (Guid id in deploymentIds)
                {
                    if (ratios.TryGetValue(id, out EntKube.Contracts.Delivery.DeploymentHealthRatio? r))
                    {
                        healthy += r.HealthySamples;
                        total += r.TotalSamples;
                    }
                }

                if (total > 0)
                {
                    compliance = Math.Round((double)healthy / total * 100, 2);
                }
            }

            targets.Add(new SlaTargetRow(t, t.Customer?.Name, t.App?.Name, compliance));
        }
    }

    private void OnCustomerChanged()
    {
        filteredApps = [];
        slaForm.AppId = null;
        if (slaForm.CustomerId is not Guid cid) return;
        Customer? customer = customers.FirstOrDefault(c => c.Id == cid);
        if (customer is not null)
            filteredApps = customer.Apps.OfType<EntKube.Web.Data.App>().OrderBy(a => a.Name).ToList();
    }

    private void ShowAdd()
    {
        slaForm = new SlaTargetForm();
        filteredApps = [];
        showAdd = true;
    }

    private async Task Save()
    {
        if (SupportGuard.Refuses(Permissions, TenantFeature.ServiceLevels, AccessLevel.Edit, Toasts))
        {
            return;
        }

        saving = true;
        try
        {
            await IncidentService.UpsertSlaTargetAsync(
                TenantId, slaForm.CustomerId, slaForm.AppId, slaForm.TargetPercent, slaForm.WindowDays);

            showAdd = false;
            await Load();
            Toasts.Success("SLA target saved.");
        }
        catch (Exception ex)
        {
            Toasts.Error($"Failed to save SLA target: {ex.Message}");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task Delete(SlaTarget target)
    {
        if (SupportGuard.Refuses(Permissions, TenantFeature.ServiceLevels, AccessLevel.Edit, Toasts))
        {
            return;
        }

        try
        {
            using EntKube.Web.Data.Modules.SupportDbContext db = DbFactory.CreateDbContext();

            // ⚠️ Scoped by tenant as well as id. This was FindAsync(target.Id) — the id was the
            // whole authorization for a delete. Unreachable from this page, whose list is loaded
            // with the tenant predicate, but an id is not permission and the check costs nothing.
            SlaTarget? found = await db.SlaTargets
                .FirstOrDefaultAsync(s => s.Id == target.Id && s.TenantId == TenantId);

            if (found is not null) db.SlaTargets.Remove(found);
            await db.SaveChangesAsync();
            await Load();
            Toasts.Success("SLA target deleted.");
        }
        catch (Exception ex)
        {
            Toasts.Error($"Failed to delete SLA target: {ex.Message}");
        }
    }

    private record SlaTargetRow(SlaTarget Target, string? CustomerName, string? AppName, double? CompliancePercent);
}
