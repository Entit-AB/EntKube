@using EntKube.Web.Data
@using EntKube.Web.Services
@inject StorageService StorageService
@inject ToastService Toasts

@*
    Cloud connections — how EntKube reaches an OpenStack cloud, and the egress
    routes that make that reachable when the cloud is behind an IP allowlist.

    Both entities are TENANT-scoped. This panel used to live inline in the
    environment-scoped StorageTab, which meant the same tenant-wide list rendered
    identically under every environment and editing it under one environment
    silently changed all of them. It is now a component with one canonical home
    (Platform -> Cloud connections) that StorageTab and the cluster provisioning
    wizard both render, so there is exactly one implementation of the form. The
    wizard previously carried its OWN eight-field copy that omitted the proxy and
    egress-route fields entirely, which produced connections that could not reach
    an IP-allowlisted cloud.
*@

<ConfirmDialog Visible="@(pendingConfirm is not null)"
               Message="@(pendingConfirm?.Message ?? "")"
               ConfirmText="@(pendingConfirm?.ConfirmText ?? "Delete")"
               IsBusy="confirmBusy"
               OnConfirm="RunPendingConfirmAsync"
               OnCancel="() => pendingConfirm = null" />

    @* ── OpenStack connections ── *@
    <div class="mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="d-flex align-items-center gap-2 mb-0">
                <i class="bi bi-cloud-haze2 text-info"></i>OpenStack Connections
                @if (openStackConnections.Count > 0)
                {
                    <span class="badge bg-info rounded-pill">@openStackConnections.Count</span>
                }
            </h5>
            <button class="btn btn-sm btn-outline-info" @onclick="ShowOpenStackForm">
                <i class="bi bi-plus-lg me-1"></i>Add Connection
            </button>
        </div>

        <p class="text-muted small mb-3">
            Used to provision OpenStack Kubernetes clusters and to manage Cleura S3 buckets and credentials. Connections belong to the tenant, not to a single environment.
        </p>

        @if (openStackConnections.Count == 0 && !showOsForm)
        {
            <EmptyState Icon="bi-cloud-haze2" Title="No OpenStack connections"
                        Message="Add one to provision OpenStack clusters or manage Cleura S3 storage."
                        ActionLabel="Add Connection" OnAction="ShowOpenStackForm" />
        }
        else
        {
            <div class="row g-3 mb-3">
                @foreach (OpenStackConnection conn in openStackConnections)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-header bg-white d-flex align-items-center justify-content-between py-2">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-cloud-haze2 text-info"></i>
                                    <strong class="small">@conn.Name</strong>
                                </div>
                                <button class="btn btn-sm btn-outline-danger border-0 py-0"
                                        @onclick='() => pendingConfirm = new PendingConfirm($"Delete the OpenStack connection \"{conn.Name}\"? Cleura S3 buckets and credentials that rely on it can no longer be managed. This cannot be undone.", "Delete", () => DeleteOpenStackConnection(conn.Id))'
                                        title="Delete"
                                        aria-label="@($"Delete OpenStack connection {conn.Name}")">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                            <div class="card-body py-2">
                                <div class="row small text-muted">
                                    @if (conn.Region is not null)
                                    {
                                        <div class="col-6 mb-1">
                                            <i class="bi bi-geo-alt me-1"></i>@conn.Region
                                        </div>
                                    }
                                    @if (conn.ProjectName is not null)
                                    {
                                        <div class="col-6 mb-1">
                                            <i class="bi bi-folder me-1"></i>@conn.ProjectName
                                        </div>
                                    }
                                    @if (conn.Username is not null)
                                    {
                                        <div class="col-6 mb-1">
                                            <i class="bi bi-person me-1"></i>@conn.Username
                                        </div>
                                    }
                                    <div class="col-12 mb-1">
                                        <i class="bi bi-link-45deg me-1"></i><code class="small text-break">@conn.AuthUrl</code>
                                    </div>
                                    @if (conn.RouteViaAgentId is not null)
                                    {
                                        <div class="col-12 mb-1">
                                            <i class="bi bi-hdd-network me-1 text-info"></i>via agent
                                            <strong>@(egressAgents.FirstOrDefault(a => a.Id == conn.RouteViaAgentId)?.Name ?? "(removed)")</strong>
                                            @if (conn.RouteViaAgentId is { } routedAgentId && !StorageService.IsEgressAgentConnected(routedAgentId))
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis ms-1">offline</span>
                                            }
                                        </div>
                                    }
                                    else if (conn.RouteViaClusterId is not null)
                                    {
                                        <div class="col-12 mb-1">
                                            <i class="bi bi-signpost-split me-1 text-info"></i>via cluster
                                            <strong>@(routableClusters.FirstOrDefault(c => c.Id == conn.RouteViaClusterId)?.Name ?? "(removed)")</strong>
                                        </div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(conn.ProxyUrl))
                                    {
                                        <div class="col-12 mb-1">
                                            <i class="bi bi-shuffle me-1 text-info"></i>via <code class="small text-break">@conn.ProxyUrl</code>
                                        </div>
                                    }
                                </div>
                                @if (osTestResults.TryGetValue(conn.Id, out (bool Ok, string Message) result))
                                {
                                    <div class="alert @(result.Ok ? "alert-success" : "alert-danger") py-1 px-2 small mt-2 mb-0 text-break">
                                        <i class="bi @(result.Ok ? "bi-check-circle" : "bi-exclamation-triangle") me-1"></i>@result.Message
                                    </div>
                                }
                            </div>
                            <div class="card-footer bg-white py-1 d-flex align-items-center justify-content-between">
                                <small class="text-muted">Added @conn.CreatedAt.ToString("yyyy-MM-dd")</small>
                                <div class="d-flex gap-1">
                                    @if (conn.RouteViaClusterId is not null && conn.RouteViaAgentId is null)
                                    {
                                        <button class="btn btn-sm btn-outline-info border-0 py-0"
                                                @onclick="() => DeployEgressRelay(conn.Id)"
                                                disabled="@(osTesting == conn.Id)">
                                            @if (osTesting == conn.Id)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                            }
                                            Deploy relay
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-outline-secondary border-0 py-0"
                                            @onclick="() => TestOpenStackConnection(conn.Id)"
                                            disabled="@(osTesting == conn.Id)">
                                        Test
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (showOsForm)
        {
            <div class="card shadow-sm border-info mb-3">
                <div class="card-header bg-white">
                    <h6 class="mb-0"><i class="bi bi-plus-circle me-2 text-info"></i>Add OpenStack Connection</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Connection Name</label>
                            <input type="text" class="form-control form-control-sm" @bind="osFormName" placeholder="e.g. Cleura Production" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Auth URL (Keystone)</label>
                            <input type="text" class="form-control form-control-sm" @bind="osFormAuthUrl" placeholder="https://identity.c2.citycloud.com:5000/v3" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Region</label>
                            <input type="text" class="form-control form-control-sm" @bind="osFormRegion" placeholder="e.g. Kna1" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Project Name</label>
                            <input type="text" class="form-control form-control-sm" @bind="osFormProjectName" placeholder="Project/tenant name" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Project ID</label>
                            <input type="text" class="form-control form-control-sm" @bind="osFormProjectId" placeholder="Optional project ID" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">User Domain Name</label>
                            <input type="text" class="form-control form-control-sm" @bind="osFormUserDomain" placeholder="Default" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Project Domain Name</label>
                            <input type="text" class="form-control form-control-sm" @bind="osFormProjectDomain" placeholder="Default" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Username</label>
                            <input type="text" class="form-control form-control-sm" @bind="osFormUsername" placeholder="OpenStack username" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Password</label>
                            <input type="password" class="form-control form-control-sm" @bind="osFormPassword" placeholder="Stored in vault" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">S3 Endpoint <span class="text-muted fw-normal">(optional)</span></label>
                            <input type="text" class="form-control form-control-sm" @bind="osFormS3Endpoint"
                                   placeholder="Leave empty — read from the Keystone service catalog" />
                            <div class="form-text small">
                                Only set this if the catalog advertises no object store, or advertises one that is not
                                the S3 host. Use <strong>Test</strong> to see what the catalog reports.
                            </div>
                        </div>
                    </div>

                    @* ── How EntKube reaches this cloud ── *@
                    <hr class="my-3" />
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi bi-signpost-split text-info"></i>
                        <span class="small fw-semibold">How EntKube reaches this cloud</span>
                    </div>
                    <p class="small text-muted mb-2">
                        Only change this if the cloud's API rejects EntKube by IP. The EntKube server's own
                        address must be allowed for the direct option to work.
                    </p>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" id="osRouteDirect"
                               checked="@(osFormRoute == OsRoute.Direct)"
                               @onchange="() => osFormRoute = OsRoute.Direct" />
                        <label class="form-check-label small" for="osRouteDirect">
                            <strong>Direct</strong>
                            <span class="text-muted"> — EntKube connects straight to the cloud. Use this unless it fails.</span>
                        </label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" id="osRouteCluster"
                               checked="@(osFormRoute == OsRoute.Cluster)"
                               @onchange="() => osFormRoute = OsRoute.Cluster" />
                        <label class="form-check-label small" for="osRouteCluster">
                            <strong>Through one of your clusters</strong>
                            <span class="text-muted"> — for a provider IP allowlist that excludes this server.</span>
                        </label>
                    </div>

                    @if (osFormRoute == OsRoute.Cluster)
                    {
                        <div class="ms-4 mt-2">
                            <p class="small text-muted mb-2">
                                EntKube deploys a small nginx relay into the cluster you pick and reaches it over that
                                cluster's API server — nothing is published inbound anywhere. Calls to the cloud then
                                leave from the cluster's address, which the provider already trusts because the cluster
                                runs in their environment. Pick a cluster hosted by the same provider as this cloud.
                            </p>
                            @if (routableClusters.Count == 0)
                            {
                                <div class="alert alert-warning py-2 px-3 small mb-0">
                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                    No registered cluster has a kubeconfig, so there is nothing to route through.
                                </div>
                            }
                            else
                            {
                                <select class="form-select form-select-sm" @bind="osFormRouteClusterId">
                                    <option value="">-- Select a cluster --</option>
                                    @foreach (KubernetesCluster cluster in routableClusters)
                                    {
                                        <option value="@cluster.Id">@cluster.Name</option>
                                    }
                                </select>
                                <div class="form-text small">
                                    After saving, use <strong>Deploy relay</strong> on the connection to install it and verify the route.
                                </div>
                            }
                        </div>
                    }

                    <div class="form-check">
                        <input class="form-check-input" type="radio" id="osRouteAgent"
                               checked="@(osFormRoute == OsRoute.Agent)"
                               @onchange="() => osFormRoute = OsRoute.Agent" />
                        <label class="form-check-label small" for="osRouteAgent">
                            <strong>Through an EntKube agent</strong>
                            <span class="text-muted"> — when neither this server nor any cluster can reach the cloud.</span>
                        </label>
                    </div>

                    @if (osFormRoute == OsRoute.Agent)
                    {
                        <div class="ms-4 mt-2">
                            <p class="small text-muted mb-2">
                                A small process you run inside a network that <em>is</em> allowed to reach the cloud.
                                It dials out to EntKube and holds the connection open, so nothing is published inbound
                                on your network. The agent decides for itself which hosts it will reach, from its own
                                local config — EntKube cannot widen that.
                            </p>
                            @if (egressAgents.Count == 0)
                            {
                                <div class="alert alert-warning py-2 px-3 small mb-0">
                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                    No agents registered yet. Add one below, then run it inside the permitted network.
                                </div>
                            }
                            else
                            {
                                <select class="form-select form-select-sm" @bind="osFormRouteAgentId">
                                    <option value="">-- Select an agent --</option>
                                    @foreach (EgressAgent agent in egressAgents)
                                    {
                                        <option value="@agent.Id">@agent.Name</option>
                                    }
                                </select>
                            }
                        </div>
                    }

                    <div class="form-check">
                        <input class="form-check-input" type="radio" id="osRouteProxy"
                               checked="@(osFormRoute == OsRoute.Proxy)"
                               @onchange="() => osFormRoute = OsRoute.Proxy" />
                        <label class="form-check-label small" for="osRouteProxy">
                            <strong>Through a proxy I run</strong>
                            <span class="text-muted"> — only if you already have one on an allowed network that this server can reach.</span>
                        </label>
                    </div>

                    @if (osFormRoute == OsRoute.Proxy)
                    {
                        <div class="row g-3 ms-1 mt-1">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Proxy URL</label>
                                <input type="text" class="form-control form-control-sm" @bind="osFormProxyUrl"
                                       placeholder="socks5://10.0.0.5:1080" />
                                <div class="form-text small">
                                    http, https, socks4, socks4a or socks5. No credentials in the URL. The EntKube
                                    server must be able to open a connection to this address.
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Proxy Username</label>
                                <input type="text" class="form-control form-control-sm" @bind="osFormProxyUsername" placeholder="Only if required" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Proxy Password</label>
                                <input type="password" class="form-control form-control-sm" @bind="osFormProxyPassword" placeholder="Stored in vault" />
                            </div>
                        </div>
                    }

                    @if (osFormError is not null)
                    {
                        <div class="alert alert-danger py-2 px-3 small mt-3 mb-0">
                            <i class="bi bi-exclamation-triangle me-1"></i>@osFormError
                        </div>
                    }
                    <div class="mt-3 d-flex gap-2">
                        <button class="btn btn-sm btn-info text-white" @onclick="SaveOpenStackConnection" disabled="@savingOs">
                            @if (savingOs)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Save Connection
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="CancelOpenStackForm">Cancel</button>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (ShowEgressAgents)
    {
        @* ── Egress agents ── *@
        <div class="mt-4">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h6 class="mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-hdd-network text-info"></i>Egress Agents
                    @if (egressAgents.Count > 0)
                    {
                        <span class="badge bg-info rounded-pill">@egressAgents.Count</span>
                    }
                </h6>
                <button class="btn btn-sm btn-outline-info" @onclick="() => showAgentForm = true">
                    <i class="bi bi-plus-lg me-1"></i>Add Agent
                </button>
            </div>
            <p class="small text-muted">
                For clouds that only accept traffic from a network EntKube is not on. You run the agent inside
                that network; it connects out to EntKube and relays connections to hosts you allow in its config.
            </p>

            @if (newAgentToken is not null)
            {
                <div class="alert alert-success py-2 px-3 small">
                    <div class="fw-semibold mb-1"><i class="bi bi-key me-1"></i>Enrolment token — copy it now</div>
                    <div>This is shown once and is not stored. Put it in the agent's <code>agent.json</code>.</div>
                    <code class="d-block mt-2 text-break">@newAgentToken</code>
                    <button class="btn btn-sm btn-outline-secondary mt-2" @onclick="() => newAgentToken = null">Done</button>
                </div>
            }

            @if (showAgentForm)
            {
                <div class="card shadow-sm border-info mb-3">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Agent Name</label>
                                <input type="text" class="form-control form-control-sm" @bind="agentFormName" placeholder="e.g. Head office network" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small fw-semibold">Description</label>
                                <input type="text" class="form-control form-control-sm" @bind="agentFormDescription" placeholder="Which network it runs in, who operates it" />
                            </div>
                        </div>
                        <div class="mt-3 d-flex gap-2">
                            <button class="btn btn-sm btn-info text-white" @onclick="CreateEgressAgent" disabled="@savingAgent">Create Agent</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelAgentForm">Cancel</button>
                        </div>
                    </div>
                </div>
            }

            @if (egressAgents.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr class="small text-muted">
                                <th>Name</th><th>Status</th><th>Last seen</th><th>Will reach</th><th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (EgressAgent agent in egressAgents)
                            {
                                <tr>
                                    <td class="small">
                                        <strong>@agent.Name</strong>
                                        @if (!string.IsNullOrWhiteSpace(agent.Description))
                                        {
                                            <div class="text-muted">@agent.Description</div>
                                        }
                                    </td>
                                    <td class="small">
                                        @if (StorageService.GetEgressAgentStatus(agent.Id) is { } status)
                                        {
                                            <span class="badge bg-success-subtle text-success-emphasis">Connected</span>
                                            <div class="text-muted">from @status.RemoteAddress, @status.ActiveStreams stream(s)</div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary-emphasis">Offline</span>
                                        }
                                    </td>
                                    <td class="small text-muted">
                                        @(agent.LastSeenAt?.ToString("yyyy-MM-dd HH:mm") ?? "never")
                                    </td>
                                    <td class="small text-muted text-break">
                                        @(string.IsNullOrWhiteSpace(agent.ReportedAllowlist) ? "—" : agent.ReportedAllowlist)
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-danger border-0 py-0"
                                                @onclick="() => DeleteEgressAgent(agent.Id)" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (agentError is not null)
                {
                    <div class="alert alert-danger py-2 px-3 small">@agentError</div>
                }
            }
        </div>
    }

@code {
    [Parameter] public Guid TenantId { get; set; }

    /// <summary>
    /// Raised after a connection or agent is created or deleted, so a host that keeps
    /// its own copy of the connection list (StorageTab uses one to populate the Cleura
    /// S3 storage-link dropdown) can reload it.
    /// </summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>
    /// Whether to render the egress agent registry below the connections. The cluster
    /// provisioning wizard turns this off: registering an agent is a separate setup task
    /// that needs a process started outside EntKube, not something to start mid-wizard.
    /// </summary>
    [Parameter] public bool ShowEgressAgents { get; set; } = true;

    private List<OpenStackConnection> openStackConnections = [];
    private List<EgressAgent> egressAgents = [];
    private List<KubernetesCluster> routableClusters = [];

    private bool showOsForm;
    private bool savingOs;

    // OpenStack form fields
    private string osFormName = "";
    private string osFormAuthUrl = "";
    private string osFormRegion = "";
    private string osFormProjectName = "";
    private string osFormProjectId = "";
    private string osFormUserDomain = "";
    private string osFormProjectDomain = "";
    private string osFormUsername = "";
    private string osFormPassword = "";
    private string osFormS3Endpoint = "";

    /// <summary>How a connection reaches its cloud — mutually exclusive options in the form.</summary>
    private enum OsRoute { Direct, Cluster, Agent, Proxy }

    private OsRoute osFormRoute = OsRoute.Direct;
    private string osFormRouteClusterId = "";
    private string osFormRouteAgentId = "";
    private string osFormProxyUrl = "";
    private string osFormProxyUsername = "";
    private string osFormProxyPassword = "";
    private string? osFormError;
    private Guid? osTesting;
    private readonly Dictionary<Guid, (bool Ok, string Message)> osTestResults = [];

    // Egress agent registry
    private bool showAgentForm;
    private bool savingAgent;
    private string agentFormName = "";
    private string agentFormDescription = "";
    private string? newAgentToken;
    private string? agentError;

    // A destructive action awaiting user confirmation via the ConfirmDialog banner.
    private sealed record PendingConfirm(string Message, string ConfirmText, Func<Task> Action);

    private PendingConfirm? pendingConfirm;
    private bool confirmBusy;

    private async Task RunPendingConfirmAsync()
    {
        if (pendingConfirm is null) return;
        confirmBusy = true;
        try
        {
            await pendingConfirm.Action();
        }
        finally
        {
            confirmBusy = false;
            pendingConfirm = null;
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        openStackConnections = await StorageService.GetOpenStackConnectionsAsync(TenantId);
        egressAgents = await StorageService.GetEgressAgentsAsync(TenantId);
        routableClusters = await StorageService.GetRoutableClustersAsync(TenantId);
    }

    /// <summary>Reloads this panel's lists, then lets the host reload whatever it owns.</summary>
    private async Task ReloadAsync()
    {
        await LoadAsync();
        await OnChanged.InvokeAsync();
    }

    // ── OpenStack Connection Form ──

    private void ShowOpenStackForm()
    {
        showOsForm = true;
    }

    private void CancelOpenStackForm()
    {
        showOsForm = false;
        ResetOsForm();
    }

    private async Task SaveOpenStackConnection()
    {
        if (string.IsNullOrWhiteSpace(osFormName) || string.IsNullOrWhiteSpace(osFormAuthUrl))
        {
            return;
        }

        savingOs = true;
        osFormError = null;
        StateHasChanged();

        try
        {
            await StorageService.CreateOpenStackConnectionAsync(
                TenantId,
                osFormName.Trim(),
                osFormAuthUrl.Trim(),
                string.IsNullOrWhiteSpace(osFormRegion) ? null : osFormRegion.Trim(),
                string.IsNullOrWhiteSpace(osFormProjectName) ? null : osFormProjectName.Trim(),
                string.IsNullOrWhiteSpace(osFormProjectId) ? null : osFormProjectId.Trim(),
                string.IsNullOrWhiteSpace(osFormUserDomain) ? null : osFormUserDomain.Trim(),
                string.IsNullOrWhiteSpace(osFormProjectDomain) ? null : osFormProjectDomain.Trim(),
                string.IsNullOrWhiteSpace(osFormUsername) ? null : osFormUsername.Trim(),
                string.IsNullOrWhiteSpace(osFormPassword) ? null : osFormPassword.Trim(),
                string.IsNullOrWhiteSpace(osFormS3Endpoint) ? null : osFormS3Endpoint.Trim(),
                osFormRoute == OsRoute.Proxy && !string.IsNullOrWhiteSpace(osFormProxyUrl) ? osFormProxyUrl.Trim() : null,
                osFormRoute == OsRoute.Proxy && !string.IsNullOrWhiteSpace(osFormProxyUsername) ? osFormProxyUsername.Trim() : null,
                osFormRoute == OsRoute.Proxy && !string.IsNullOrWhiteSpace(osFormProxyPassword) ? osFormProxyPassword.Trim() : null,
                osFormRoute == OsRoute.Cluster && Guid.TryParse(osFormRouteClusterId, out Guid routeCluster) ? routeCluster : null,
                osFormRoute == OsRoute.Agent && Guid.TryParse(osFormRouteAgentId, out Guid routeAgent) ? routeAgent : null);

            showOsForm = false;
            ResetOsForm();
            await ReloadAsync();
        }
        catch (InvalidOperationException ex)
        {
            // Proxy URL validation and other save-time rejections belong on the form.
            osFormError = ex.Message;
        }
        finally
        {
            savingOs = false;
        }
    }

    private void CancelAgentForm()
    {
        showAgentForm = false;
        agentFormName = "";
        agentFormDescription = "";
    }

    private async Task CreateEgressAgent()
    {
        if (string.IsNullOrWhiteSpace(agentFormName)) return;

        savingAgent = true;
        agentError = null;

        try
        {
            (EgressAgent _, string token) = await StorageService.CreateEgressAgentAsync(
                TenantId, agentFormName.Trim(),
                string.IsNullOrWhiteSpace(agentFormDescription) ? null : agentFormDescription.Trim());

            newAgentToken = token;
            CancelAgentForm();
            await ReloadAsync();
        }
        finally
        {
            savingAgent = false;
        }
    }

    private async Task DeleteEgressAgent(Guid agentId)
    {
        agentError = null;
        (bool deleted, string? reason) = await StorageService.DeleteEgressAgentAsync(TenantId, agentId);

        if (!deleted) agentError = reason;

        egressAgents = await StorageService.GetEgressAgentsAsync(TenantId);
    }

    private async Task DeployEgressRelay(Guid connectionId)
    {
        osTesting = connectionId;
        osTestResults.Remove(connectionId);
        StateHasChanged();

        try
        {
            osTestResults[connectionId] = await StorageService.DeployEgressRelayAsync(TenantId, connectionId);
        }
        finally
        {
            osTesting = null;
        }
    }

    private async Task TestOpenStackConnection(Guid connectionId)
    {
        osTesting = connectionId;
        osTestResults.Remove(connectionId);
        StateHasChanged();

        try
        {
            osTestResults[connectionId] = await StorageService.TestOpenStackConnectionAsync(TenantId, connectionId);
        }
        finally
        {
            osTesting = null;
        }
    }

    private async Task DeleteOpenStackConnection(Guid connectionId)
    {
        try
        {
            bool deleted = await StorageService.DeleteOpenStackConnectionAsync(TenantId, connectionId);

            if (deleted)
            {
                await ReloadAsync();
                Toasts.Success("OpenStack connection deleted.");
            }
            else
            {
                Toasts.Warning("OpenStack connection could not be deleted.");
            }
        }
        catch (Exception ex)
        {
            Toasts.Error($"Failed to delete OpenStack connection: {ex.Message}");
        }
    }

    private void ResetOsForm()
    {
        osFormName = "";
        osFormAuthUrl = "";
        osFormRegion = "";
        osFormProjectName = "";
        osFormProjectId = "";
        osFormUserDomain = "";
        osFormProjectDomain = "";
        osFormUsername = "";
        osFormPassword = "";
        osFormS3Endpoint = "";
        osFormRoute = OsRoute.Direct;
        osFormRouteClusterId = "";
        osFormRouteAgentId = "";
        osFormProxyUrl = "";
        osFormProxyUsername = "";
        osFormProxyPassword = "";
        osFormError = null;
    }
}
