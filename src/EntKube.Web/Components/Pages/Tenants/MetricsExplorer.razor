@using EntKube.Web.Services
@using EntKube.Web.Services.Telemetry
@inject IMetricsQuery Metrics

@if (!string.IsNullOrEmpty(discoveryError) && !isLoading)
{
    @* ⭐ "The backend said no metrics" and "the backend could not be asked" are different answers
       and get different screens. For as long as this component has existed they shared one: the
       reassuring empty state below, because discovery was a bool and every failure of it — no
       prometheus component on the cluster, no kubeconfig, no ready Prometheus pod, a 401/403 on
       the API-server proxy, a WAN timeout — collapsed into the same false as a healthy, empty
       Prometheus. An operator read an outage as an un-instrumented cluster and went off to
       install a collector. Load() one method down has always shown res.Error; so does
       ClusterMonitoring, AlertPanel and RabbitMQMonitoringPanel. This is the same house rule,
       and TraceExplorer's banner carries the same lesson for spans. *@
    <div class="alert alert-warning small py-2">
        <span class="bi bi-exclamation-triangle me-1"></span>
        <strong>Could not read this cluster's metrics.</strong>
        <div class="mt-1 font-monospace">@discoveryError</div>
        <div class="mt-1">
            That is this cluster's Prometheus failing to answer — missing, unreachable through the
            API-server proxy, or refusing the request. It says nothing about your apps'
            instrumentation, so there is nothing to install until it is fixed.
        </div>
    </div>
}
else if (!available && !isLoading)
{
    @* Reached only when Prometheus answered. The text used to send the reader to the EntKube
       Telemetry Collector and OTLP, which is the logs/traces path: this view reads the cluster's
       own Prometheus over PromQL and EntKube stores no metrics of its own, so installing the
       collector would not have changed a pixel of it. *@
    <div class="alert alert-light border text-muted small py-2">
        <span class="bi bi-graph-up me-1"></span>
        <strong>No metrics for this cluster yet.</strong>
        <div class="mt-1">
            This view queries the cluster's own <strong>Prometheus</strong>, and it knows no metric
            names in this scope for the last 24 hours. Check that your apps expose a metrics
            endpoint and that Prometheus is scraping them (ServiceMonitor / PodMonitor).
        </div>
    </div>
}
else
{
    <div class="row g-2 align-items-end mb-3">
        <div class="col-md-4">
            <label class="form-label small text-muted mb-1">Metric</label>
            <select class="form-select form-select-sm font-monospace" @bind="selectedMetric">
                <option value="">— select a metric —</option>
                @foreach (string m in metricNames)
                {
                    <option value="@m">@m</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted mb-1">Service</label>
            <select class="form-select form-select-sm" @bind="selectedService">
                <option value="">All services</option>
                @foreach (string s in services)
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted mb-1">Break down by</label>
            <select class="form-select form-select-sm" @bind="breakdown">
                <option value="">None (total)</option>
                <option value="pod">Pod</option>
                <option value="service">Service</option>
                <option value="namespace">Namespace</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted mb-1">Time range</label>
            <select class="form-select form-select-sm" @bind="timeRangeMinutes">
                <option value="15">Last 15 minutes</option>
                <option value="60">Last 1 hour</option>
                <option value="180">Last 3 hours</option>
                <option value="720">Last 12 hours</option>
                <option value="1440">Last 24 hours</option>
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-sm btn-primary w-100" @onclick="Load"
                    disabled="@(isQuerying || string.IsNullOrEmpty(selectedMetric))">
                @if (isQuerying) { <span class="spinner-border spinner-border-sm me-1"></span> }
                <span class="bi bi-graph-up me-1"></span>Chart
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(queryError))
    {
        <div class="alert alert-warning small py-2"><span class="bi bi-exclamation-triangle me-1"></span>@queryError</div>
    }

    @if (grouped.Count > 0)
    {
        <div class="card card-body">
            <div class="small text-muted mb-1 font-monospace">@selectedMetric — by @breakdown</div>
            <MultiSeriesChart Series="grouped" HeightPx="240" />
        </div>
    }
    else if (series.Count > 0)
    {
        <div class="card card-body">
            <MetricChart Title="@selectedMetric" DataPoints="series" Color="#4a90d9" HeightPx="220" ShowAxes="true" />
        </div>
    }
    else if (charted && !isQuerying)
    {
        <div class="text-center py-4 text-muted">
            <span class="bi bi-graph-up display-6 d-block mb-2 opacity-25"></span>
            No data points for this metric in the selected range.
        </div>
    }
}

@code {
    /// <summary>The tenant asking; every query below is authorized as them, not as the cluster.</summary>
    [Parameter] public required Guid TenantId { get; set; }

    [Parameter] public required Guid ClusterId { get; set; }
    /// <summary>Optional namespace scope (customer portal). When set, metric queries are restricted to
    /// these namespaces so a customer only sees their own apps' metrics. Null = cluster-wide (tenant view).</summary>
    [Parameter] public IReadOnlyList<string>? Namespaces { get; set; }
    /// <summary>Optional deployment scope: a "^(workload1|workload2)-" pod regex narrowing to one
    /// deployment's pods within the namespace scope. Null = all deployments.</summary>
    [Parameter] public string? PodPattern { get; set; }

    private bool available;
    private bool isLoading = true;
    private List<string> metricNames = [];
    private List<string> services = [];
    private string selectedMetric = "";
    private string selectedService = "";
    private string breakdown = "";
    private int timeRangeMinutes = 60;

    private List<TimeSeriesDataPoint> series = [];
    private List<MetricSeriesGroup> grouped = [];
    private bool isQuerying;
    private bool charted;
    private string? queryError;
    /// <summary>Why discovery failed, when it failed. Null = Prometheus answered (possibly with nothing).</summary>
    private string? discoveryError;
    private Guid _lastCluster;

    // The metric-name/service lists depend only on the cluster, so load them once per cluster rather than
    // re-running the two label-value scans on every parameter set.
    protected override async Task OnParametersSetAsync()
    {
        if (ClusterId == _lastCluster) return;
        _lastCluster = ClusterId;

        // ⚠️ Everything derived from the cluster we are leaving has to go, not only what is visible.
        // selectedService used to survive the switch: the <select> re-renders with the new cluster's
        // options and shows no selection (a Blazor <select> only takes its selection from options
        // rendered in the same batch), so the box reads as "All services" while the field still holds
        // cluster A's service name — and Load() puts it straight into the PromQL as
        // service_name="<cluster A's service>". The chart then came back empty on a cluster that was
        // emitting the metric perfectly well, or, if cluster B happened to run a service of the same
        // name, silently narrowed to that one service with nothing on screen to say so.
        // TenantMetricsTab passes no @key, so the same component instance is reused across the switch
        // and this reset is the only thing standing between the two clusters.
        series = []; grouped = []; charted = false; selectedMetric = ""; selectedService = "";
        queryError = null; discoveryError = null;

        isLoading = true;

        // The name and service dropdowns are independent label-value queries — run them
        // concurrently so the load waits on the slower, not the sum. The names query is also the
        // availability probe: IMetricsQuery.HasDataAsync answers the same question as a bool that
        // cannot carry an error, and one query fewer is a bonus.
        Task<KubernetesOperationResult<List<string>>> namesTask =
            Metrics.GetMetricNamesAsync(TenantId, ClusterId, namespaces: Namespaces, podPattern: PodPattern);
        Task<KubernetesOperationResult<List<string>>> servicesTask =
            Metrics.GetServicesAsync(TenantId, ClusterId, namespaces: Namespaces, podPattern: PodPattern);
        await Task.WhenAll(namesTask, servicesTask);

        if (!namesTask.Result.IsSuccess)
        {
            discoveryError = namesTask.Result.Error;
            metricNames = []; services = []; available = false;
        }
        else
        {
            metricNames = namesTask.Result.Data ?? [];
            services = servicesTask.Result.IsSuccess ? servicesTask.Result.Data ?? [] : [];
            available = metricNames.Count > 0;
        }

        isLoading = false;
    }

    private async Task Load()
    {
        isQuerying = true;
        queryError = null;
        StateHasChanged();

        DateTime to = DateTime.UtcNow;
        DateTime from = to.AddMinutes(-timeRangeMinutes);
        string? svc = string.IsNullOrEmpty(selectedService) ? null : selectedService;
        series = []; grouped = [];

        if (string.IsNullOrEmpty(breakdown))
        {
            KubernetesOperationResult<List<TimeSeriesDataPoint>> res = await Metrics.GetSeriesAsync(TenantId, ClusterId, selectedMetric, svc, from, to, namespaces: Namespaces, podPattern: PodPattern);
            if (res.IsSuccess && res.Data is not null) series = res.Data;
            else queryError = res.Error;
        }
        else
        {
            KubernetesOperationResult<List<MetricSeriesGroup>> res = await Metrics.GetSeriesByAsync(TenantId, ClusterId, selectedMetric, svc, breakdown, from, to, namespaces: Namespaces, podPattern: PodPattern);
            if (res.IsSuccess && res.Data is not null) grouped = res.Data;
            else queryError = res.Error;
        }

        charted = true;
        isQuerying = false;
    }
}
