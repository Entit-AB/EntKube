@using EntKube.Web.Services

@* ═══════════════════════════════════════════════════════════════════════════
   MultiSeriesChart — overlays N named time-series as colored polylines on a
   shared time + value axis, with a value (y) scale, a start/end time (x) axis,
   faint gridlines, and a legend. Points are positioned by real timestamp (not
   index) so series with different sampling still line up. Server-rendered SVG,
   no JS. Geometry is emitted through Coord() in the invariant culture; the VALUE
   LABELS are deliberately localized. See Coord().
   ═══════════════════════════════════════════════════════════════════════════ *@

<div class="multi-series-chart">
    @if (drawable.Count > 0 && _maxVal > 0)
    {
        <div style="display:grid;grid-template-columns:auto 1fr;grid-template-rows:@(HeightPx)px auto;column-gap:6px;">
            <div class="chart-axis-y" style="grid-column:1;grid-row:1;">
                <span>@AxisLabel(_maxVal)</span>
                <span>@AxisLabel(_maxVal / 2)</span>
                <span>0</span>
            </div>
            <div style="grid-column:2;grid-row:1;min-width:0;">
                <svg viewBox="0 0 @W @H" preserveAspectRatio="none"
                     style="width:100%; height:@(HeightPx)px; display:block;">
                    @foreach (double gy in GridLines)
                    {
                        <line x1="0" y1="@gy.ToString("F1", Inv)" x2="@W" y2="@gy.ToString("F1", Inv)"
                              stroke="currentColor" stroke-opacity="0.12" stroke-width="1" vector-effect="non-scaling-stroke" />
                    }
                    @for (int i = 0; i < drawable.Count; i++)
                    {
                        <polyline points="@LinePoints(drawable[i])" fill="none"
                                  stroke="@ColorAt(i)" stroke-width="1.5"
                                  stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
                    }
                </svg>
            </div>
            <div class="chart-axis-x" style="grid-column:2;grid-row:2;">
                <span>@TimeLabel(_minTime)</span>
                <span>@TimeLabel(_maxTime)</span>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-3 mt-2">
            @for (int i = 0; i < drawable.Count; i++)
            {
                <span class="d-inline-flex align-items-center small">
                    <span style="width:10px;height:10px;border-radius:2px;display:inline-block;margin-right:4px;background:@ColorAt(i);"></span>
                    <span class="font-monospace">@drawable[i].Name</span>
                    <span class="text-muted ms-1">@LastValue(drawable[i])</span>
                </span>
            }
        </div>
    }
    else
    {
        <div class="text-center py-4 text-muted"><small>Insufficient data to chart.</small></div>
    }
</div>

@code {
    [Parameter] public List<MetricSeriesGroup> Series { get; set; } = [];
    [Parameter] public int HeightPx { get; set; } = 220;
    /// <summary>Optional unit appended to the value-axis labels (e.g. "cores", "MiB", "%").</summary>
    [Parameter] public string? Unit { get; set; }

    private const int W = 600;
    private const int H = 200;
    private const int Pad = 3;

    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;
    private double[] GridLines => [Pad, H / 2.0, H - Pad];

    private static readonly string[] Palette =
        ["#4a90d9", "#f48771", "#7ab648", "#e0a458", "#9b7fd4", "#4bbfae", "#d46aa8", "#6c8ebf", "#c17f3a", "#5aa469"];

    private List<MetricSeriesGroup> drawable = [];
    private double _minTicks;
    private double _spanTicks = 1;
    private double _maxVal;
    private DateTime _minTime;
    private DateTime _maxTime;

    protected override void OnParametersSet()
    {
        drawable = Series.Where(s => s.Points.Count >= 2).ToList();
        List<TimeSeriesDataPoint> all = drawable.SelectMany(s => s.Points).ToList();
        if (all.Count == 0) { _maxVal = 0; return; }

        _minTime = all.Min(p => p.Timestamp);
        _maxTime = all.Max(p => p.Timestamp);
        _minTicks = _minTime.Ticks;
        _spanTicks = Math.Max(1, _maxTime.Ticks - _minTicks);
        _maxVal = Math.Max(all.Max(p => p.Value), double.Epsilon);
    }

    private string ColorAt(int i) => Palette[i % Palette.Length];

    private string AxisLabel(double v)
    {
        string s = v >= 100 ? v.ToString("F0") : v >= 10 ? v.ToString("F1") : v.ToString("F2");
        return string.IsNullOrEmpty(Unit) ? s : Unit == "%" ? s + "%" : $"{s} {Unit}";
    }

    private static string TimeLabel(DateTime t) => t.ToLocalTime().ToString("HH:mm");

    /// <summary>
    /// ⭐ One coordinate, in the invariant culture, because an SVG number is not a displayed
    /// number.
    ///
    /// <para><b>This file's header used to claim it "Mirrors MetricChart's invariant-culture
    /// coords", and it did not.</b> The gridlines above do
    /// (<c>gy.ToString("F1", Inv)</c>), but <see cref="LinePoints"/> built its pairs with plain
    /// interpolation — <c>$"{x:F1},{y:F1}"</c> — which formats with
    /// <see cref="System.Globalization.CultureInfo.CurrentCulture"/>. EntKube.Web pins no
    /// culture, so on this product's own Swedish hosts the pair <c>(2, 70.4)</c> was emitted as
    /// <c>2,0,70,4</c>.</para>
    ///
    /// <para>⚠️ <b>Nothing fails.</b> SVG's number grammar accepts a comma OR whitespace between
    /// numbers, so the renderer reads four coordinates where two were meant, every later pair
    /// shifts by one, and a smooth line appears that was never plotted from the data — while the
    /// gridlines and axis labels stay correct, which is what makes it look like a real
    /// measurement. A dot-decimal host hides it entirely; a comma-decimal host corrupts every
    /// point. That is why a comment could claim the opposite for this long.</para>
    ///
    /// <para>The value labels (<see cref="AxisLabel"/>, <c>LastValue</c>) are left localized on
    /// purpose: those are read by a person, and a Swedish operator should see <c>50,0</c>. The
    /// distinction is geometry versus text, not one culture for the whole file.</para>
    /// </summary>
    private static string Coord(double value) => value.ToString("F1", Inv);

    private string LinePoints(MetricSeriesGroup s)
    {
        List<string> pts = [];
        foreach (TimeSeriesDataPoint p in s.Points)
        {
            double x = Pad + (p.Timestamp.Ticks - _minTicks) / _spanTicks * (W - 2 * Pad);
            double y = H - Pad - (p.Value / _maxVal) * (H - 2 * Pad);
            pts.Add($"{Coord(x)},{Coord(y)}");
        }
        return string.Join(" ", pts);
    }

    private static string LastValue(MetricSeriesGroup s)
    {
        double v = s.Points[^1].Value;
        return v >= 100 ? v.ToString("F0") : v.ToString("F2");
    }
}
