@using System.ComponentModel.DataAnnotations
@using EntKube.Web.Data
@using EntKube.Web.Services
@using EntKube.Web.Services.Mail
@inject SupportMailboxService Mailboxes
@inject SmtpSettingsResolver Smtp
@inject ToastService Toasts

@* ═══════════════════════════════════════════════════════════════════
   Where support mail comes from. §14.3 accepts e-mail as a reporting
   channel for P3 and P4, and in practice everything arrives there
   first — so a mailbox that is quietly broken looks exactly like a
   quiet week, which is why the last poll and its error are on screen.
   ═══════════════════════════════════════════════════════════════════ *@

<ConfirmDialog Visible="@confirmingDelete"
               Message="Remove the mailbox settings and the stored password? Messages already taken in are kept — this only stops new ones arriving."
               ConfirmText="Remove it"
               IsBusy="busy"
               OnConfirm="DeleteAsync"
               OnCancel="() => confirmingDelete = false" />

<LoadingPanel Loading="@loading" Error="@error">
@if (!loading)
{
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h6 class="mb-0">Support mailbox</h6>
            <div class="text-muted small">
                Fetched into the triage queue, where a person decides what each message
                becomes. A fault report from a recorded contact is the one exception: it
                opens its ticket as it arrives, so the sender gets a number to quote.
            </div>
        </div>
        @if (saved is not null)
        {
            <div class="text-nowrap">
                <AsyncButton CssClass="btn-sm btn-outline-secondary me-2" OnClick="TestAsync">
                    <span class="bi bi-plug me-1"></span>Test connection
                </AsyncButton>
                <AsyncButton CssClass="btn-sm btn-outline-primary me-2" OnClick="PollNowAsync">
                    <span class="bi bi-arrow-repeat me-1"></span>Fetch now
                </AsyncButton>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => confirmingDelete = true">
                    <span class="bi bi-trash"></span>
                </button>
            </div>
        }
    </div>

    @* ───────────── What the poller last saw ───────────── *@
    @if (saved is not null)
    {
        <div class="alert @StatusClass() py-2 small d-flex align-items-start gap-2">
            <span class="bi @StatusIcon() mt-1"></span>
            <div>
                <strong>@StatusTitle()</strong>
                <div>
                    @if (saved.LastPolledAt is DateTime polled)
                    {
                        <span>Last checked @polled.ToLocalTime().ToString("MMM d HH:mm").</span>
                    }
                    else
                    {
                        <span>Never checked.</span>
                    }
                    @if (saved.LastMessageAt is DateTime message)
                    {
                        <span class="ms-1">
                            Last message taken in @message.ToLocalTime().ToString("MMM d HH:mm").
                        </span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(saved.LastError))
                {
                    <div class="mt-1"><code>@saved.LastError</code></div>
                }
                @if (saved.ConsecutiveFailures >= SupportMailboxService.FailuresBeforeBackingOff)
                {
                    <div class="mt-1">
                        @saved.ConsecutiveFailures failures in a row, so fetching has stopped.
                        @* Why it stopped depends on what failed, and the old wording said "a server is
                           rejecting the password" for every failure — including ones where no password
                           was ever presented, such as a connection that never completed. Asserting a
                           cause it does not know sent two debugging sessions after the credential while
                           the error above said the connection had failed. *@
                        @if (saved.LastErrorWasRejection)
                        {
                            <text>
                                The credential was rejected, and presenting one a server refuses is how
                                an account gets locked.
                            </text>
                        }
                        else
                        {
                            <text>
                                Nothing was rejected — the attempt above did not get as far as
                                authenticating, so the fault is in reaching the server rather than in the
                                credential.
                            </text>
                        }
                        Saving these settings again starts it.
                    </div>
                }
                @if (!hasPassword)
                {
                    <div class="mt-1">No credential is stored, so nothing can be fetched.</div>
                }
            </div>
        </div>

        @* ───────────── The other direction ─────────────
           Fetching and sending are separate arrangements, and only one of them was ever
           configured here. A mailbox that reads perfectly and cannot answer looks entirely
           healthy from every screen — support mail arrives, tickets open, and the customer
           is told nothing. So sending gets its own line, whether it works or not. *@
        <div class="alert @(canSend ? "alert-light" : "alert-warning") py-2 small d-flex align-items-start gap-2">
            <span class="bi @(canSend ? "bi-send-check" : "bi-send-exclamation") mt-1"></span>
            <div>
                @if (canSend)
                {
                    <strong>Replies are sent from @sendingFrom.</strong>
                    <div>
                        Through @sendingHost — @sendingSource. Receipts, the §14.1 notice to the
                        customer's contact and every other ticket mail take this route.
                    </div>
                }
                else
                {
                    <strong>Nothing can be sent.</strong>
                    <div>
                        Mail is fetched and tickets are opened, but the receipt with the ticket
                        number never leaves — and nothing else says so. Either choose a mail
                        server EntKube manages above, so submission is taken from it the same way
                        the login is; or switch submission on for that server in its Mail tab and
                        apply it; or configure an SMTP provider for this tenant.
                    </div>
                }
            </div>
        </div>
    }

    <EditForm Model="form" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label small text-muted">Mail server</label>
                <select class="form-select form-select-sm" value="@form.StalwartComponentId?.ToString()"
                        @onchange="OnServerChanged">
                    <option value="">Another server — enter the connection below</option>
                    @foreach (SupportMailboxService.StalwartMailServerOption server in stalwartServers)
                    {
                        <option value="@server.ComponentId">@server.Label</option>
                    }
                </select>
                <div class="form-text small">
                    Choosing a mail server EntKube manages settles the rest: the address, the port,
                    TLS, the login and the credential are taken from the server itself, so a server
                    later renamed or moved is followed rather than remembered wrongly.
                </div>
            </div>

            @if (form.StalwartComponentId is not null)
            {
                <div class="col-md-6">
                    <label class="form-label small text-muted">Mailbox</label>
                    <select class="form-select form-select-sm" value="@form.StalwartAccountId?.ToString()"
                            @onchange="OnAccountChanged">
                        <option value="">-- choose a mailbox --</option>
                        @foreach (SupportMailboxService.StalwartMailboxOption account in stalwartAccounts)
                        {
                            <option value="@account.AccountId">@account.Address</option>
                        }
                    </select>
                    @if (stalwartAccounts.Count == 0)
                    {
                        <div class="form-text small text-warning">
                            That server has no mailboxes yet. Add one on its Mail tab, apply the
                            configuration, and it will appear here.
                        </div>
                    }
                </div>
                <div class="col-md-6 align-self-end">
                    <div class="small text-muted">
                        @if (selectedServerNeedsDirectoryPassword)
                        {
                            <span class="text-warning">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                That server authenticates against LDAP, so its mailbox passwords live
                                in the directory and EntKube cannot create one. Leave the server
                                unselected and enter the IMAP details and directory password by hand
                                instead.
                            </span>
                        }
                        else if (selectedServerUsesOidc)
                        {
                            <span>
                                <i class="bi bi-shield-lock me-1"></i>
                                That server authenticates against OIDC, which accepts only bearer
                                tokens — so saving creates a Keycloak service account for this mailbox
                                and mints tokens with it. There is no password to enter or keep.
                            </span>
                        }
                        else
                        {
                            <span>
                                <i class="bi bi-key me-1"></i>
                                That server validates passwords itself, so saving creates one for this
                                mailbox and stores it in the vault. Apply the mail server afterwards —
                                the password only reaches Stalwart with its configuration, and until it
                                does every login is answered with a temporary failure.
                            </span>
                        }
                    </div>
                </div>
            }

            @if (form.StalwartComponentId is null)
            {
            <div class="col-md-5">
                <label class="form-label small text-muted">IMAP server</label>
                <InputText class="form-control form-control-sm" @bind-Value="form.Host"
                           placeholder="imap.example.com" />
                <ValidationMessage For="() => form.Host" class="text-danger small" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Port</label>
                <InputNumber class="form-control form-control-sm" @bind-Value="form.Port" />
                <ValidationMessage For="() => form.Port" class="text-danger small" />
            </div>
            <div class="col-md-5 align-self-end">
                <div class="form-check">
                    <InputCheckbox class="form-check-input" id="mailbox-ssl" @bind-Value="form.UseSsl" />
                    <label class="form-check-label small" for="mailbox-ssl">
                        TLS on connect (port 993). Off means STARTTLS on port 143 —
                        never an unencrypted connection.
                    </label>
                </div>
            </div>

            <div class="col-md-4">
                <label class="form-label small text-muted">Username</label>
                <InputText class="form-control form-control-sm" @bind-Value="form.Username"
                           autocomplete="off" />
                <ValidationMessage For="() => form.Username" class="text-danger small" />
            </div>
            }
            <div class="col-md-4">
                <label class="form-label small text-muted">
                    Password
                    @if (hasPassword)
                    {
                        <span class="badge bg-light text-dark border ms-1">stored</span>
                    }
                </label>
                <InputText type="password" class="form-control form-control-sm"
                           @bind-Value="form.Password" autocomplete="new-password"
                           placeholder="@(hasPassword ? "unchanged" : "")" />
                <div class="form-text small">
                    Kept encrypted in the tenant's vault, never shown back. Leaving it
                    empty keeps the one already stored.
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted">Support address</label>
                <InputText class="form-control form-control-sm" @bind-Value="form.Address"
                           placeholder="support@example.com" />
                <div class="form-text small">What replies should come from.</div>
            </div>

            <div class="col-md-3">
                <label class="form-label small text-muted">Folder</label>
                <InputText class="form-control form-control-sm" @bind-Value="form.Folder" />
                <ValidationMessage For="() => form.Folder" class="text-danger small" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">Check every (seconds)</label>
                <InputNumber class="form-control form-control-sm" @bind-Value="form.PollIntervalSeconds" />
                <ValidationMessage For="() => form.PollIntervalSeconds" class="text-danger small" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">Once taken in</label>
                <InputSelect class="form-select form-select-sm" @bind-Value="form.Disposition">
                    <option value="@MailboxDisposition.MarkSeen">Mark it read</option>
                    <option value="@MailboxDisposition.MoveToFolder">Move it to a folder</option>
                    <option value="@MailboxDisposition.LeaveAlone">Leave the mailbox alone</option>
                </InputSelect>
            </div>
            <div class="col-md-3">
                @if (form.Disposition == MailboxDisposition.MoveToFolder)
                {
                    <label class="form-label small text-muted">Move to</label>
                    <InputText class="form-control form-control-sm" @bind-Value="form.MoveToFolder"
                               placeholder="Processed" />
                    <ValidationMessage For="() => form.MoveToFolder" class="text-danger small" />
                }
            </div>

            <div class="col-12">
                <label class="form-label small text-muted">
                    Trust the sender checks from
                </label>
                <InputText class="form-control form-control-sm"
                           @bind-Value="form.TrustedAuthenticationServer"
                           placeholder="mx.example.com" />
                <div class="form-text small">
                    The name your own mail server stamps on its <code>Authentication-Results</code>
                    header — usually its hostname. It is normally the first word of that header
                    on any message already in this mailbox.
                    @if (string.IsNullOrWhiteSpace(form.TrustedAuthenticationServer))
                    {
                        <span class="text-warning-emphasis">
                            Left empty, nothing checks who a message is from. A stranger writing
                            as one of a customer's named contacts is placed in that customer's
                            queue with no warning — because the From address is what places it,
                            and anybody can write that.
                        </span>
                    }
                    else
                    {
                        <span>
                            Only verdicts stamped by this name are believed. A sender can add
                            that header themselves, so one from any other server is read and
                            discarded.
                        </span>
                    }
                </div>
            </div>

            <div class="col-12">
                <div class="form-check">
                    <InputCheckbox class="form-check-input" id="mailbox-enabled"
                                   @bind-Value="form.IsEnabled" />
                    <label class="form-check-label small" for="mailbox-enabled">
                        <strong>Fetch mail from this mailbox.</strong>
                        Test the connection before switching this on.
                    </label>
                </div>
                <div class="form-check mt-2">
                    <InputCheckbox class="form-check-input" id="mailbox-acknowledge"
                                   @bind-Value="form.AcknowledgeOnArrival" />
                    <label class="form-check-label small" for="mailbox-acknowledge">
                        <strong>Answer a new report straight away with its ticket number.</strong>
                        A fault report from a recorded contact opens its ticket as it arrives, and
                        the sender is sent the number with the instruction to keep it in the
                        subject. Only that: the priority still reaches them as theirs and
                        unconfirmed, and a person still confirms it in writing. Mail we cannot
                        place, a sender our own server could not verify, and anything that says it
                        came from a program are all left in the queue as before.
                    </label>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-sm btn-primary" disabled="@busy">
                @if (busy)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                Save
            </button>
        </div>
    </EditForm>
}
</LoadingPanel>

@code {
    [Parameter] public required Guid TenantId { get; set; }

    private bool loading = true;
    private bool busy;

    // What the other direction looks like. Loaded beside the mailbox, because "can it fetch"
    // and "can it answer" are different questions with different remedies.
    private bool canSend;
    private string sendingHost = "";
    private string sendingFrom = "";
    private string sendingSource = "";
    private bool confirmingDelete;
    private string? error;

    private SupportMailbox? saved;
    private bool hasPassword;
    private MailboxForm form = new();

    private sealed class MailboxForm : IValidatableObject
    {
        /// <summary>
        /// The Stalwart server chosen, if any. Set, the connection fields below are neither shown nor
        /// required — they are derived from the server on every connection instead of copied here.
        /// </summary>
        public Guid? StalwartComponentId { get; set; }

        public Guid? StalwartAccountId { get; set; }

        [StringLength(256)]
        public string Host { get; set; } = "";

        [Range(1, 65535, ErrorMessage = "A port is between 1 and 65535.")]
        public int Port { get; set; } = 993;

        public bool UseSsl { get; set; } = true;

        [StringLength(256)]
        public string Username { get; set; } = "";

        /// <summary>Only ever written. An empty box means "keep what is stored".</summary>
        public string? Password { get; set; }

        [StringLength(256)]
        public string? Address { get; set; }

        [Required(ErrorMessage = "A folder is required.")]
        [StringLength(256)]
        public string Folder { get; set; } = "INBOX";

        public bool IsEnabled { get; set; }

        public bool AcknowledgeOnArrival { get; set; } = true;

        public int PollIntervalSeconds { get; set; } = 120;

        public MailboxDisposition Disposition { get; set; } = MailboxDisposition.MarkSeen;

        [StringLength(256)]
        public string? MoveToFolder { get; set; }

        [StringLength(256)]
        public string? TrustedAuthenticationServer { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext context)
        {
            int floor = (int)SupportMailPoller.MinimumInterval.TotalSeconds;

            if (PollIntervalSeconds < floor)
            {
                yield return new ValidationResult(
                    $"A server will start refusing connections long before this is useful — {floor} seconds is the floor.",
                    [nameof(PollIntervalSeconds)]);
            }

            if (Disposition == MailboxDisposition.MoveToFolder && string.IsNullOrWhiteSpace(MoveToFolder))
            {
                yield return new ValidationResult(
                    "Name the folder to move messages to.", [nameof(MoveToFolder)]);
            }

            // One shape or the other, and which one decides what is required. A chosen server derives
            // the host and login, so asking for them would be asking for something that is ignored;
            // an outside mailbox has nothing to derive them from, so they are the whole of it.
            if (StalwartComponentId is null)
            {
                if (string.IsNullOrWhiteSpace(Host))
                {
                    yield return new ValidationResult(
                        "The server is required, or choose a mail server above.", [nameof(Host)]);
                }

                if (string.IsNullOrWhiteSpace(Username))
                {
                    yield return new ValidationResult(
                        "The username is required, or choose a mail server above.", [nameof(Username)]);
                }
            }
            else if (StalwartAccountId is null)
            {
                yield return new ValidationResult(
                    "Choose which mailbox on that server to read.", [nameof(StalwartAccountId)]);
            }
        }
    }

    private List<SupportMailboxService.StalwartMailServerOption> stalwartServers = [];
    private List<SupportMailboxService.StalwartMailboxOption> stalwartAccounts = [];

    private bool selectedServerNeedsDirectoryPassword =>
        form.StalwartComponentId is Guid ldapId
        && stalwartServers.FirstOrDefault(s => s.ComponentId == ldapId)
            is { CredentialIsAutomatic: false };

    private bool selectedServerUsesOidc =>
        form.StalwartComponentId is Guid id
        && stalwartServers.FirstOrDefault(s => s.ComponentId == id)?.UsesOidc == true;

    private async Task OnServerChanged(ChangeEventArgs e)
    {
        form.StalwartComponentId = Guid.TryParse(e.Value?.ToString(), out Guid id) ? id : null;

        // The old mailbox belonged to the old server, so it cannot carry over.
        form.StalwartAccountId = null;
        stalwartAccounts = form.StalwartComponentId is Guid chosen
            ? await Mailboxes.GetStalwartMailboxesAsync(TenantId, chosen)
            : [];
    }

    private void OnAccountChanged(ChangeEventArgs e) =>
        form.StalwartAccountId = Guid.TryParse(e.Value?.ToString(), out Guid id) ? id : null;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        error = null;

        try
        {
            saved = await Mailboxes.GetAsync(TenantId);
            hasPassword = saved is not null && await Mailboxes.HasCredentialAsync(saved);

            stalwartServers = await Mailboxes.GetStalwartServersAsync(TenantId);
            stalwartAccounts = saved?.StalwartComponentId is Guid chosen
                ? await Mailboxes.GetStalwartMailboxesAsync(TenantId, chosen)
                : [];

            form = saved is null
                ? new MailboxForm()
                : new MailboxForm
                {
                    StalwartComponentId = saved.StalwartComponentId,
                    StalwartAccountId = saved.StalwartAccountId,
                    Host = saved.Host,
                    Port = saved.Port,
                    UseSsl = saved.UseSsl,
                    Username = saved.Username,
                    Address = saved.Address,
                    Folder = saved.Folder,
                    IsEnabled = saved.IsEnabled,
                    AcknowledgeOnArrival = saved.AcknowledgeOnArrival,
                    PollIntervalSeconds = saved.PollIntervalSeconds,
                    Disposition = saved.Disposition,
                    MoveToFolder = saved.MoveToFolder,
                    TrustedAuthenticationServer = saved.TrustedAuthenticationServer,
                };

            await LoadSendingAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    /// <summary>
    /// Whether outbound mail has anywhere to go, and where. Read through the same resolver the
    /// notifier uses, so the screen cannot claim one thing while the send does another. Only
    /// the host and where the answer came from are shown; the credential stays where it is.
    /// </summary>
    private async Task LoadSendingAsync()
    {
        try
        {
            SmtpSettings settings = await Smtp.ResolveAsync(TenantId);

            canSend = settings.IsConfigured;
            sendingHost = settings.Host ?? "";
            sendingFrom = saved?.Address ?? settings.From;
            sendingSource = settings.Source;
        }
        catch
        {
            // A screen that cannot answer the question says no rather than throwing: the
            // mailbox settings above are still worth showing and still worth editing.
            canSend = false;
        }
    }

    private async Task SaveAsync()
    {
        // Switching fetching on with nothing to authenticate with would only produce a
        // failure every couple of minutes, so say so here instead.
        // Only when there is a password to need. A mailbox on a server EntKube manages gets its
        // credential from the server's own auth mode — a token where the directory is OIDC, the
        // account's password otherwise — so demanding one here would block the case this exists for.
        if (form.IsEnabled && form.StalwartComponentId is null
            && !hasPassword && string.IsNullOrEmpty(form.Password))
        {
            Toasts.Error("A password is needed before mail can be fetched.");
            return;
        }

        busy = true;

        try
        {
            await Mailboxes.SaveAsync(
                new SupportMailbox
                {
                    TenantId = TenantId,
                    StalwartComponentId = form.StalwartComponentId,
                    StalwartAccountId = form.StalwartAccountId,
                    Host = form.Host.Trim(),
                    Port = form.Port,
                    UseSsl = form.UseSsl,
                    Username = form.Username.Trim(),
                    Address = string.IsNullOrWhiteSpace(form.Address) ? null : form.Address.Trim(),
                    Folder = form.Folder.Trim(),
                    IsEnabled = form.IsEnabled,
                    AcknowledgeOnArrival = form.AcknowledgeOnArrival,
                    PollIntervalSeconds = form.PollIntervalSeconds,
                    Disposition = form.Disposition,
                    TrustedAuthenticationServer =
                        string.IsNullOrWhiteSpace(form.TrustedAuthenticationServer)
                            ? null
                            : form.TrustedAuthenticationServer.Trim(),
                    MoveToFolder = string.IsNullOrWhiteSpace(form.MoveToFolder)
                        ? null
                        : form.MoveToFolder.Trim(),
                },
                form.Password);

            form.Password = null;
            Toasts.Success("Mailbox saved.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toasts.Error($"Could not save: {ex.Message}");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task TestAsync()
    {
        MailPollResult result = await Mailboxes.TestAsync(TenantId);

        if (result.Ok)
        {
            Toasts.Success($"Connected. {result.Seen} message(s) in {form.Folder}.");
        }
        else
        {
            Toasts.Error(result.Error ?? "The connection failed.");
        }

        await LoadAsync();
    }

    private async Task PollNowAsync()
    {
        MailPollResult result = await Mailboxes.PollAsync(TenantId);

        if (result.AlreadyRunning)
        {
            Toasts.Info("A fetch is already running for this mailbox.");
        }
        else if (result.Ok)
        {
            // The sweep was wanted and had nowhere to look, so the protection an operator believes is
            // in force is not. Said before the counts, because it is about every future message rather
            // than this fetch.
            if (result.JunkUnavailable)
            {
                Toasts.Warning(
                    "This mail server offers no Junk folder that can be found by its special-use "
                    + "attribute, so customer mail filed as spam cannot be rescued — a support request "
                    + "classified as spam would not be read. Everything else was fetched normally.");
            }

            // A rescue is not good news, it is a filter misclassifying a customer — so it is said out
            // loud rather than folded into the total, where nobody would notice it.
            if (result.FromJunk > 0)
            {
                Toasts.Warning(
                    $"Took in {result.Taken} message(s) — {result.FromJunk} of them from Junk, from a "
                    + "registered customer domain. The spam filter is classifying a customer's mail as "
                    + "spam; nothing was lost, but it is worth looking at why.");
            }
            else
            {
                Toasts.Success(result.Taken == 0
                    ? $"Nothing new — {result.Seen} message(s) looked at."
                    : $"Took in {result.Taken} message(s).");
            }
        }
        else
        {
            Toasts.Error(result.Error ?? "The fetch failed.");
        }

        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        busy = true;

        try
        {
            await Mailboxes.DeleteAsync(TenantId);
            Toasts.Success("Mailbox removed.");
            await LoadAsync();
        }
        finally
        {
            busy = false;
            confirmingDelete = false;
        }
    }

    private string StatusClass() =>
        saved is null ? "alert-secondary"
        : !string.IsNullOrWhiteSpace(saved.LastError) ? "alert-danger"
        : !saved.IsEnabled || !hasPassword ? "alert-secondary"
        : "alert-success";

    private string StatusIcon() =>
        saved is not null && !string.IsNullOrWhiteSpace(saved.LastError)
            ? "bi-exclamation-triangle"
            : saved?.IsEnabled == true && hasPassword ? "bi-check-circle" : "bi-pause-circle";

    private string StatusTitle() =>
        saved is null ? "Not configured"
        : !string.IsNullOrWhiteSpace(saved.LastError) ? "The last check failed"
        : !hasPassword ? "No credential stored"
        : !saved.IsEnabled ? "Fetching is switched off"
        : "Fetching";
}
