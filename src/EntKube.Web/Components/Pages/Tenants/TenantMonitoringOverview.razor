@using EntKube.Web.Data
@using EntKube.Web.Services
@using Microsoft.EntityFrameworkCore
@inject PrometheusService PrometheusService
@inject IncidentService IncidentService
@inject OnCallService OnCallService
@inject OperationsAdvisorService Advisor
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<div class="d-flex justify-content-end align-items-center mb-3">
    <AutoRefresh OnRefresh="Refresh" IntervalSeconds="60" Enabled="true"
                 LastRefreshed="lastRefreshed" />
</div>

@* ── First paint: the page has not yet read the tenant's own records ── *@
@if (isLoading && clusterSummaries.Count == 0)
{
    <div class="text-center py-4 text-muted">
        <span class="spinner-border spinner-border-sm me-2"></span>Loading…
    </div>
}

@* ── Tenant-level summary strip ── *@
@if (clusterSummaries.Count > 0)
{
    <div class="d-flex flex-wrap gap-2 mb-4">
        <div class="card border-0 bg-light text-center px-3 py-2">
            <div class="fw-bold fs-4">@clusterSummaries.Count</div>
            <div class="text-muted small">Clusters</div>
        </div>
        <div class="card border-0 bg-light text-center px-3 py-2">
            <div class="fw-bold fs-4">
                @clusterSummaries.Sum(s => s.Health?.TotalNodes ?? 0)@(StillMeasuring ? "…" : "")
            </div>
            <div class="text-muted small">Nodes</div>
        </div>
        <div class="card border-0 bg-light text-center px-3 py-2">
            <div class="fw-bold fs-4">
                @clusterSummaries.Sum(s => s.Health?.RunningPods ?? 0)@(StillMeasuring ? "…" : "")
            </div>
            <div class="text-muted small">Running Pods</div>
        </div>
        <div class="card border-0 text-center px-3 py-2 @(tenantCriticalAlerts > 0 ? "bg-danger-subtle" : tenantActiveAlerts > 0 ? "bg-warning-subtle" : "bg-light")"
             style="cursor:@(OnNavigateTab.HasDelegate ? "pointer" : "default")"
             @onclick='() => NavigateTo("alerts")'>
            <div class="fw-bold fs-4 @(tenantCriticalAlerts > 0 ? "text-danger" : tenantActiveAlerts > 0 ? "text-warning" : "text-success")">@tenantActiveAlerts</div>
            <div class="text-muted small d-flex align-items-center gap-1">
                Active Alerts
                @if (OnNavigateTab.HasDelegate)
                {
                    <span class="bi bi-arrow-right" style="font-size:.7rem"></span>
                }
            </div>
        </div>
        @if (criticalIncidents > 0)
        {
            <div class="card border-danger text-center px-3 py-2"
                 style="cursor:@(OnNavigateTab.HasDelegate ? "pointer" : "default")"
                 @onclick='() => NavigateTo("incidents")'>
                <div class="fw-bold fs-4 text-danger">@criticalIncidents</div>
                <div class="text-muted small d-flex align-items-center gap-1">
                    Critical
                    @if (OnNavigateTab.HasDelegate)
                    {
                        <span class="bi bi-arrow-right" style="font-size:.7rem"></span>
                    }
                </div>
            </div>
        }
        <div class="card border-0 text-center px-3 py-2 @(advisorActionable > 0 ? "bg-warning-subtle" : "bg-light")"
             style="cursor:@(OnNavigateTab.HasDelegate ? "pointer" : "default")"
             @onclick='() => NavigateTo("advisor")'>
            <div class="fw-bold fs-4 @(advisorActionable > 0 ? "text-warning-emphasis" : "text-success")">@advisorActionable</div>
            <div class="text-muted small d-flex align-items-center gap-1">
                <i class="bi bi-lightbulb"></i>Needs attention
                @if (OnNavigateTab.HasDelegate)
                {
                    <span class="bi bi-arrow-right" style="font-size:.7rem"></span>
                }
            </div>
        </div>
    </div>
}

@* ── Cluster cards ── *@
<div class="row g-3 mb-4">
    @foreach (ClusterSummaryVm vm in clusterSummaries)
    {
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 border-@ClusterBorderColor(vm)">
                <div class="card-header d-flex align-items-center gap-2 py-2">
                    <span class="bi bi-hdd-rack-fill text-@ClusterBorderColor(vm)"></span>
                    <strong class="me-auto">@vm.Cluster.Name</strong>
                    @if (vm.Firing.Critical > 0)
                    {
                        <span class="badge bg-danger">
                            @vm.Firing.Critical critical@(vm.Firing.Other > 0 ? $" + {vm.Firing.Other}" : "")
                        </span>
                    }
                    else if (vm.Firing.Other > 0)
                    {
                        @* Amber, and named. Saying "Healthy" here was the defect: a warning is
                           not an emergency, but it is not nothing, and the previous badge had
                           no state between red and a green claim of health. *@
                        <span class="badge bg-warning text-dark">
                            @vm.Firing.Other warning@(vm.Firing.Other == 1 ? "" : "s")
                        </span>
                    }
                    else if (vm.Loading)
                    {
                        <span class="badge bg-secondary">Checking…</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Healthy</span>
                    }
                </div>
                <div class="card-body py-2">
                    @if (vm.Loading)
                    {
                        @* Still measuring. Saying so matters: an empty tile here reads as
                           "this cluster has no metrics", which is a different and alarming
                           statement about a cluster that is merely slow to answer. *@
                        <div class="text-muted small text-center py-2">
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            Measuring…
                        </div>
                    }
                    else if (vm.Health is null)
                    {
                        <div class="text-muted small text-center py-2">
                            <span class="bi bi-exclamation-triangle me-1"></span>
                            @(vm.Error ?? "Prometheus not available")
                        </div>
                    }
                    else
                    {
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <div class="small text-muted">CPU</div>
                                <div class="progress" style="height:8px">
                                    <div class="progress-bar bg-@UtilColor(vm.Health.CpuUsagePercent)"
                                         style="width:@((int)Math.Min(vm.Health.CpuUsagePercent,100))%"></div>
                                </div>
                                <div class="small fw-semibold">@vm.Health.CpuUsagePercent.ToString("F1")%</div>
                            </div>
                            <div class="col-6">
                                <div class="small text-muted">Memory</div>
                                <div class="progress" style="height:8px">
                                    <div class="progress-bar bg-@UtilColor(vm.Health.MemoryUsagePercent)"
                                         style="width:@((int)Math.Min(vm.Health.MemoryUsagePercent,100))%"></div>
                                </div>
                                <div class="small fw-semibold">@vm.Health.MemoryUsagePercent.ToString("F1")%</div>
                            </div>
                        </div>
                        <div class="small text-muted">
                            <span class="bi bi-server me-1"></span>@vm.Health.ReadyNodes/@vm.Health.TotalNodes nodes ready
                            &nbsp;·&nbsp;
                            <span class="bi bi-box me-1"></span>@vm.Health.RunningPods pods running
                            @if (vm.Health.FailedPods > 0)
                            {
                                <span class="text-danger">&nbsp;·&nbsp;<span class="bi bi-exclamation-circle me-1"></span>@vm.Health.FailedPods failed</span>
                            }
                            @if (vm.Health.PendingPods > 0)
                            {
                                <span class="text-warning">&nbsp;·&nbsp;<span class="bi bi-hourglass me-1"></span>@vm.Health.PendingPods pending</span>
                            }
                        </div>
                    }
                </div>
                <div class="card-footer py-1 bg-transparent border-0 d-flex gap-3">
                    <a href="tenants/@TenantSlug/clusters/@vm.Cluster.Id/monitoring"
                       class="btn btn-sm btn-link p-0 text-decoration-none">
                        <span class="bi bi-graph-up me-1"></span>Monitoring
                    </a>
                    @if (vm.Firing.Total > 0 && OnNavigateTab.HasDelegate)
                    {
                        <button class="btn btn-sm btn-link p-0 text-decoration-none text-danger"
                                @onclick='() => NavigateTo("alerts")'>
                            <span class="bi bi-bell me-1"></span>View alerts
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>

@* ── On-call banner ── *@
@if (currentOnCall is not null)
{
    <div class="alert alert-success d-flex align-items-center gap-2 py-2 mb-3">
        <span class="bi bi-person-check-fill"></span>
        <span class="small">
            On call: <strong>@currentOnCall.AssigneeName</strong>
            @if (!string.IsNullOrEmpty(currentOnCall.AssigneeEmail))
            {
                <a href="mailto:@currentOnCall.AssigneeEmail" class="ms-1">@currentOnCall.AssigneeEmail</a>
            }
            — until @currentOnCall.EndsAt.ToLocalTime().ToString("MMM d HH:mm")
        </span>
        @if (OnNavigateTab.HasDelegate)
        {
            <button class="btn btn-sm btn-link p-0 ms-auto text-decoration-none small"
                    @onclick='() => NavigateTo("on-call")'>
                Schedule <span class="bi bi-arrow-right ms-1"></span>
            </button>
        }
    </div>
}

@* ── Active incidents ── *@
@if (activeIncidents.Count > 0)
{
    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="mb-0"><span class="bi bi-bell-fill text-danger me-1"></span>Active Incidents</h6>
            @if (OnNavigateTab.HasDelegate)
            {
                <button class="btn btn-sm btn-link p-0 text-decoration-none"
                        @onclick='() => NavigateTo("incidents")'>
                    View all <span class="bi bi-arrow-right ms-1"></span>
                </button>
            }
        </div>
        <div class="list-group">
            @foreach (AlertIncident incident in activeIncidents.Take(5))
            {
                <div class="list-group-item list-group-item-action py-2 px-3 d-flex align-items-center gap-2">
                    @SeverityDot(incident.Severity)
                    <div class="flex-grow-1">
                        <div class="fw-semibold small">@incident.AlertName</div>
                        @if (!string.IsNullOrEmpty(incident.Summary))
                        {
                            <div class="text-muted" style="font-size:.77rem">@incident.Summary</div>
                        }
                    </div>
                    <div class="text-end">
                        <div class="small text-muted">@incident.Cluster?.Name</div>
                        <div class="text-muted" style="font-size:.72rem">@FormatAge(incident.StartsAt)</div>
                    </div>
                    @if (incident.Status == IncidentStatus.Acknowledged)
                    {
                        <span class="badge bg-warning text-dark ms-1">Acked</span>
                    }
                </div>
            }
        </div>
        @if (activeIncidents.Count > 5)
        {
            <div class="text-center mt-1">
                <button class="btn btn-sm btn-link text-decoration-none"
                        @onclick='() => NavigateTo("incidents")'>
                    +@(activeIncidents.Count - 5) more
                </button>
            </div>
        }
    </div>
}

@* ── Upcoming maintenance ── *@
@if (upcomingMaintenance.Count > 0)
{
    <div class="alert alert-warning d-flex align-items-start gap-2 py-2 mb-3">
        <span class="bi bi-tools fs-5 mt-1"></span>
        <div>
            <strong class="small">Upcoming maintenance</strong>
            <div class="d-flex flex-column gap-1 mt-1">
                @foreach (MaintenanceWindow w in upcomingMaintenance)
                {
                    bool active = w.StartsAt <= DateTime.UtcNow && w.EndsAt >= DateTime.UtcNow;
                    <div class="small">
                        @if (active)
                        {
                            <span class="badge bg-warning text-dark me-1">Active now</span>
                        }
                        <strong>@w.Title</strong>
                        — @(w.Cluster?.Name ?? "All clusters")
                        <span class="text-muted ms-1">
                            @w.StartsAt.ToLocalTime().ToString("MMM d HH:mm") – @w.EndsAt.ToLocalTime().ToString("HH:mm")
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public required Guid TenantId { get; set; }
    [Parameter] public required string TenantSlug { get; set; }
    [Parameter] public EventCallback<string> OnNavigateTab { get; set; }

    private List<ClusterSummaryVm> clusterSummaries = [];
    private List<AlertIncident> activeIncidents = [];
    private List<MaintenanceWindow> upcomingMaintenance = [];
    private OnCallShift? currentOnCall;
    private int tenantActiveAlerts;

    @* Everything firing is what "Active Alerts" counts; the criticals decide the COLOUR, so a
       cluster with only warnings is neither hidden nor painted as an emergency. *@
    private int tenantCriticalAlerts;
    private int criticalIncidents;
    private int advisorActionable;

    /// <summary>
    /// Whether an advisor finding belongs in the "Needs attention" tile: due now or already
    /// late, and not suppressed by a decision that is still in force.
    ///
    /// <para>⭐ <b>A snooze expires; the status does not.</b>
    /// <see cref="AdvisorFindingStatus.Snoozed"/> is documented as "Hidden until
    /// <c>AdvisorFindingState.SnoozedUntil</c> passes", and nothing ever puts the row back:
    /// <c>AdvisorStateService</c> rewrites the status only on an explicit acknowledge,
    /// dismiss or reactivate, its <c>ReconcileAsync</c> prunes only rows whose finding has
    /// been <i>absent</i> for three days — so a finding that is still present keeps its
    /// stale Snoozed row forever — and <c>OperationsAdvisorService.MergeStateAsync</c>
    /// copies the status onto the finding with no comparison against now. The durations the
    /// Advisor tab offers are 1, 3 and 7 days, so expired-but-still-Snoozed is the ordinary
    /// steady state, not a corner case.</para>
    ///
    /// <para><b>What this used to do.</b> It tested the status alone —
    /// <c>f.State is not Dismissed and not Snoozed</c> — and so read an expired snooze as
    /// permanent suppression. An overdue finding snoozed until last week was listed by the
    /// Advisor tab that this very tile clicks through to (which renders a
    /// "Snoozed → &lt;past date&gt;" badge on it, with no <c>&gt; now</c> test), while the
    /// tile showed 0 in green. The strip claimed nothing needed attention and the tab
    /// behind it listed open overdue work.</para>
    ///
    /// <para>Both sites that render these findings as a list already pair the status with
    /// the date: <c>OperationsAdvisorTab.razor</c>'s default filter, and
    /// <c>FleetAdvisor.razor</c>'s <c>Visible</c> — whose <c>Priorities</c> list then
    /// filters the identical <c>Overdue or Today</c> horizons off that pairing, which is the
    /// same count as this tile, across the fleet instead of one tenant.</para>
    ///
    /// <para>⚠️ <c>AdvisorScanService.MaybeSendDigestAsync</c>
    /// (<c>src/EntKube.Web/Services/AdvisorScanService.cs</c>) still carries the unpaired
    /// predicate, so the notification digest goes on under-reporting expired snoozes and can
    /// stay quiet about overdue work. It is outside this change's files; the fix there is
    /// this same predicate.</para>
    ///
    /// <para>A Snoozed finding with no <c>SnoozedUntil</c> at all counts — <c>null &gt; now</c>
    /// is false — which is deliberate and matches both controls: a snooze with no end is not
    /// a snooze.</para>
    /// </summary>
    public static bool NeedsAttention(OperationsFinding f, DateTime now) =>
        f.Horizon is AdvisorHorizon.Overdue or AdvisorHorizon.Today
        && f.State != AdvisorFindingStatus.Dismissed
        && !(f.State == AdvisorFindingStatus.Snoozed && f.SnoozedUntil > now);
    private DateTime? lastRefreshed;
    /// <summary>True until the database-backed half of the page has loaded — phase one.</summary>
    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
    }

    /// <summary>
    /// Loads the page in two phases, and renders between them.
    ///
    /// <para>Everything here used to be awaited before the first render, so the page — the
    /// whole section, including the tabs out of it — appeared only once the last cluster
    /// had answered. Cluster health is the slow part by a wide margin: it is a WAN
    /// round-trip through each cluster's API server, where the rest is local database
    /// work. Waiting for it to show what is already known, and to let somebody click
    /// through to another tab, is the wrong trade in every case.</para>
    ///
    /// <para>So: the database-backed figures render first, then each cluster's tile fills
    /// in as that cluster answers. A slow or unreachable cluster now delays its own tile
    /// and nothing else.</para>
    /// </summary>
    private async Task Refresh()
    {
        isLoading = true;
        StateHasChanged();

        List<KubernetesCluster> clusters;
        using (ApplicationDbContext db = DbFactory.CreateDbContext())
        {
            clusters = await db.KubernetesClusters
                .Include(c => c.Components)
                .Where(c => c.TenantId == TenantId)
                .OrderBy(c => c.Name)
                .ToListAsync();
        }

        // ── Phase one: what the database already knows ──

        Dictionary<Guid, FiringCounts> perClusterCounts = await IncidentService
            .GetActiveCountsPerClusterAsync(clusters.Select(c => c.Id));

        // ⚠️ Everything firing, not just the criticals. The card below is captioned "Active
        // Alerts", and it used to sum a count that excluded both warnings and any incident
        // somebody had acknowledged — so acknowledging the last critical alert took this
        // headline to zero and turned the page green.
        tenantActiveAlerts = perClusterCounts.Values.Sum(c => c.Total);
        tenantCriticalAlerts = perClusterCounts.Values.Sum(c => c.Critical);

        Task<List<AlertIncident>> incidentTask =
            IncidentService.GetActiveIncidentsForTenantAsync(TenantId);
        Task<List<MaintenanceWindow>> maintenanceTask =
            IncidentService.GetUpcomingMaintenanceAsync(TenantId);
        Task<OnCallShift?> onCallTask =
            OnCallService.GetCurrentOnCallAsync(TenantId);
        Task<AdvisorReport> advisorTask = Advisor.GetReportAsync(TenantId);

        await Task.WhenAll(incidentTask, maintenanceTask, onCallTask, advisorTask);

        activeIncidents = incidentTask.Result;
        criticalIncidents = activeIncidents.Count(i => i.Severity == "critical");
        upcomingMaintenance = maintenanceTask.Result;
        currentOnCall = onCallTask.Result;
        advisorActionable = advisorTask.Result.Findings.Count(
            f => NeedsAttention(f, DateTime.UtcNow));

        // The tiles are placed before their contents are known, so the page has its shape
        // — and its links — immediately. Each tile says it is still measuring rather than
        // claiming the cluster has no metrics, which is what an empty tile would imply.
        clusterSummaries =
            [.. clusters.Select(c => new ClusterSummaryVm(
                c, null, null, perClusterCounts.GetValueOrDefault(c.Id), Loading: true))];

        isLoading = false;
        StateHasChanged();

        // ── Phase two: the clusters themselves, each rendering as it answers ──

        await Task.WhenAll(clusters.Select(async cluster =>
        {
            ClusterSummaryVm vm =
                await LoadClusterSummaryAsync(cluster, perClusterCounts.GetValueOrDefault(cluster.Id));

            int index = clusterSummaries.FindIndex(s => s.Cluster.Id == cluster.Id);
            if (index >= 0)
            {
                clusterSummaries[index] = vm;
                await InvokeAsync(StateHasChanged);
            }
        }));

        lastRefreshed = DateTime.UtcNow;
        await InvokeAsync(StateHasChanged);
    }

    private async Task<ClusterSummaryVm> LoadClusterSummaryAsync(
        KubernetesCluster cluster, FiringCounts firing)
    {
        bool hasPrometheus = cluster.Components.Any(c =>
            c.HelmChartName == "kube-prometheus-stack" && c.Status == ComponentStatus.Installed);

        if (!hasPrometheus)
            return new ClusterSummaryVm(cluster, null, null, firing);

        KubernetesOperationResult<ClusterHealthSummary> result =
            await PrometheusService.GetClusterHealthAsync(TenantId, cluster.Id);

        return new ClusterSummaryVm(
            cluster,
            result.IsSuccess ? result.Data : null,
            result.IsSuccess ? null : result.Error,
            firing);
    }

    /// <summary>
    /// True while any cluster has yet to answer. The fleet totals are sums across tiles,
    /// so until then they are partial — shown with an ellipsis rather than as a settled
    /// number that would quietly climb while somebody was reading it.
    /// </summary>
    private bool StillMeasuring => clusterSummaries.Any(s => s.Loading);

    private async Task NavigateTo(string tab)
    {
        if (OnNavigateTab.HasDelegate)
            await OnNavigateTab.InvokeAsync(tab);
    }

    private static string UtilColor(double pct) =>
        pct >= 90 ? "danger" : pct >= 70 ? "warning" : "success";

    private static string ClusterBorderColor(ClusterSummaryVm vm)
    {
        if (vm.Firing.Critical > 0) return "danger";
        if (vm.Firing.Other > 0) return "warning";
        if (vm.Health is null) return "secondary";
        if (vm.Health.CpuUsagePercent >= 90 || vm.Health.MemoryUsagePercent >= 90) return "warning";
        return "success";
    }

    private static string FormatAge(DateTime t)
    {
        TimeSpan ago = DateTime.UtcNow - t;
        return ago switch
        {
            { TotalMinutes: < 60 } => $"{(int)ago.TotalMinutes}m",
            { TotalHours: < 24 }   => $"{(int)ago.TotalHours}h",
            _                      => $"{(int)ago.TotalDays}d"
        };
    }

    private static RenderFragment SeverityDot(string severity) => severity switch
    {
        "critical" => @<span class="bi bi-circle-fill text-danger" style="font-size:.55rem"></span>,
        "warning"  => @<span class="bi bi-circle-fill text-warning" style="font-size:.55rem"></span>,
        _          => @<span class="bi bi-circle-fill text-info" style="font-size:.55rem"></span>
    };

    private record ClusterSummaryVm(
        KubernetesCluster Cluster,
        ClusterHealthSummary? Health,
        string? Error,
        FiringCounts Firing,
        bool Loading = false);
}
