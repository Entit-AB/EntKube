@using EntKube.Web.Data
@using EntKube.Web.Data.Modules
@using EntKube.Web.Services
@using Microsoft.EntityFrameworkCore
@inject PrometheusService PrometheusService
@inject CnpgService CnpgService
@inject IDbContextFactory<DataServicesDbContext> DbFactory

@if (isLoading)
{
    <div class="text-muted small text-center py-2">
        <span class="bi bi-hourglass-split me-1"></span> Loading database metrics…
    </div>
}
else
{
    @if (errors.Count > 0)
    {
        <div class="alert alert-warning py-2 small">
            <i class="bi bi-exclamation-triangle me-1"></i>
            <strong>Could not read metrics from Prometheus.</strong>
            <ul class="mb-0 mt-1 ps-3">
                @foreach (string err in errors)
                {
                    <li>@err</li>
                }
            </ul>
        </div>
    }

    @if (summaries.Count == 0 && errors.Count == 0)
    {
        <div class="text-muted small text-center py-3">
            <span class="bi bi-bar-chart me-1"></span>
            No CNPG clusters on this Kubernetes cluster.
        </div>
    }

    @foreach ((CnpgRef database, CnpgMetricsSummary summary) in summaries)
    {
        <div class="card mb-3" @key="database.Id" data-database="@database.Namespace/@database.Name">
            <div class="card-header py-2 d-flex align-items-center gap-2">
                <span class="bi bi-database-fill-gear text-info"></span>
                <strong>@database.Name</strong>
                <span class="text-muted small font-monospace">@database.Namespace</span>
                <span class="ms-auto text-muted small">@summary.QueriedAt.ToLocalTime().ToString("HH:mm:ss")</span>
            </div>
            <div class="card-body py-2">
                @if (!summary.HasData)
                {
                    @* All-zero tiles look exactly like a healthy idle database, so say plainly
                       that nothing is being scraped rather than showing zeros as if measured. *@
                    <div class="alert alert-info py-2 small mb-0">
                        <div>
                            <i class="bi bi-info-circle me-1"></i>
                            <strong>Prometheus has no metrics for this database.</strong>
                            CNPG only publishes them when its Cluster resource asks for a PodMonitor.
                            Databases created before EntKube set that need their spec pushed again:
                        </div>
                        <div class="d-flex align-items-center gap-2 mt-2">
                            <button class="btn btn-sm btn-primary" disabled="@(reapplying is not null)"
                                    @onclick="() => ReapplySpec(database)">
                                @if (reapplying == database.Id)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                else
                                {
                                    <i class="bi bi-arrow-repeat me-1"></i>
                                }
                                Enable metrics for @database.Name
                            </button>
                            <span class="text-muted">
                                Re-applies this database's Cluster resource — you'll see the exact change before it lands.
                            </span>
                        </div>
                        @if (reapplyMessages.TryGetValue(database.Id, out (bool Ok, string Text) msg))
                        {
                            <div class="mt-2 @(msg.Ok ? "text-success" : "text-danger")">
                                <i class="bi @(msg.Ok ? "bi-check-circle" : "bi-x-circle") me-1"></i>@msg.Text
                            </div>
                        }
                        <div class="mt-2">
                            <button class="btn btn-sm btn-outline-secondary" disabled="@(diagnosing is not null)"
                                    @onclick="() => Diagnose(database)">
                                @if (diagnosing == database.Id)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                else
                                {
                                    <i class="bi bi-binoculars me-1"></i>
                                }
                                Why is it empty?
                            </button>
                            <span class="text-muted ms-2">Looks for the PodMonitors that select this database and for what Prometheus reads.</span>
                        </div>

                        @if (diagnoses.TryGetValue(database.Id, out ScrapeDiagnosis? diag))
                        {
                            <div class="mt-2 border-top pt-2">
                                @foreach (string finding in diag.Findings)
                                {
                                    <div class="@(diag.WiringIsRight ? "text-success" : "text-warning-emphasis")">
                                        <i class="bi @(diag.WiringIsRight ? "bi-check-circle" : "bi-exclamation-triangle") me-1"></i>@finding
                                    </div>
                                }
                                @if (diag.Remedy is not null)
                                {
                                    <pre class="small bg-body-secondary p-2 rounded mt-2 mb-0"
                                         style="white-space:pre-wrap;">@diag.Remedy</pre>
                                }
                            </div>
                        }
                        else if (diagnoseErrors.TryGetValue(database.Id, out string? diagErr))
                        {
                            <div class="text-danger mt-2"><i class="bi bi-x-circle me-1"></i>@diagErr</div>
                        }
                    </div>
                }
                else
                {
                <div class="row g-3 mb-3">
                    <div class="col-auto">
                        <div class="small text-muted">Replication Lag</div>
                        <div class="fw-semibold @(summary.ReplicationLagSeconds > 5 ? "text-danger" : summary.ReplicationLagSeconds > 1 ? "text-warning" : "text-success")">
                            @summary.ReplicationLagSeconds.ToString("F1")s
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="small text-muted">Backends</div>
                        <div class="fw-semibold">@summary.TotalBackends</div>
                    </div>
                    <div class="col-auto">
                        <div class="small text-muted">Active Queries</div>
                        <div class="fw-semibold">@summary.ActiveQueries</div>
                    </div>
                </div>

                @if (summary.DatabaseSizes.Count > 0)
                {
                    <div class="small text-muted mb-1">Database Sizes</div>
                    <table class="table table-sm mb-0">
                        <tbody>
                            @foreach (CnpgDatabaseSize db in summary.DatabaseSizes)
                            {
                                <tr>
                                    <td class="py-1">@db.DatabaseName</td>
                                    <td class="py-1 text-end text-muted">@db.SizeMiB.ToString("F1") MiB</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                }
            </div>
        </div>
    }
}

@code {
    [Parameter] public required Guid ClusterId { get; set; }

    private List<(CnpgRef Database, CnpgMetricsSummary Summary)> summaries = [];
    private List<string> errors = [];
    private bool isLoading = true;

    /// <summary>
    /// The CNPG row behind a card. Everything below is kept per <see cref="Id"/>: a name is unique
    /// only within its namespace, and kept per name the buttons on two databases of one name both
    /// acted on the first of them.
    /// </summary>
    private sealed record CnpgRef(Guid Id, Guid TenantId, string Name, string Namespace);

    private Guid? reapplying;
    private readonly Dictionary<Guid, (bool Ok, string Text)> reapplyMessages = [];

    private Guid? diagnosing;
    private readonly Dictionary<Guid, ScrapeDiagnosis> diagnoses = [];
    private readonly Dictionary<Guid, string> diagnoseErrors = [];

    protected override async Task OnParametersSetAsync() => await LoadMetrics();

    private async Task LoadMetrics()
    {
        isLoading = true;
        StateHasChanged();

        List<CnpgRef> databases;
        using (DataServicesDbContext db = DbFactory.CreateDbContext())
        {
            databases = await db.CnpgClusters
                .Where(c => c.KubernetesClusterId == ClusterId)
                .OrderBy(c => c.Name).ThenBy(c => c.Namespace)
                .Select(c => new CnpgRef(c.Id, c.TenantId, c.Name, c.Namespace))
                .ToListAsync();
        }

        // Over the refs, not their names: each already carries the tenant that owns it, which
        // is what PrometheusService now needs in order to resolve the cluster at all.

        List<(CnpgRef, CnpgMetricsSummary)> results = [];
        List<string> failures = [];
        foreach (CnpgRef database in databases)
        {
            KubernetesOperationResult<CnpgMetricsSummary> result =
                await PrometheusService.GetCnpgClusterMetricsAsync(
                    database.TenantId, ClusterId, database.Namespace, database.Name);

            if (result.IsSuccess && result.Data is not null)
                results.Add((database, result.Data));
            else
                // Swallowing this made an unreachable Prometheus indistinguishable from a
                // cluster with no databases — both rendered the same empty placeholder.
                failures.Add($"{database.Namespace}/{database.Name}: {result.Error}");
        }

        summaries = results;
        errors = failures;
        isLoading = false;
    }

    /// <summary>
    /// Reads both halves of the scrape path from the cluster and reports which one is missing,
    /// so the remaining step is stated rather than guessed at.
    /// </summary>
    private async Task Diagnose(CnpgRef database)
    {
        diagnosing = database.Id;
        diagnoses.Remove(database.Id);
        diagnoseErrors.Remove(database.Id);
        StateHasChanged();
        try
        {
            KubernetesOperationResult<ScrapeDiagnosis> result =
                await PrometheusService.DiagnoseCnpgScrapeAsync(
                    database.TenantId, ClusterId, database.Name, database.Namespace);

            if (result.IsSuccess && result.Data is not null)
                diagnoses[database.Id] = result.Data;
            else
                diagnoseErrors[database.Id] = result.Error ?? "Diagnosis failed.";
        }
        catch (Exception ex)
        {
            diagnoseErrors[database.Id] = ex.Message;
        }
        finally
        {
            diagnosing = null;
        }
    }

    /// <summary>
    /// Pushes the database's Cluster resource again so it gains the PodMonitor opt-in. The change
    /// gate shows the dry-run diff first, so this cannot alter anything unseen.
    /// </summary>
    private async Task ReapplySpec(CnpgRef database)
    {
        reapplying = database.Id;
        reapplyMessages.Remove(database.Id);
        StateHasChanged();
        try
        {
            await CnpgService.ReapplyClusterSpecAsync(database.TenantId, database.Id);
            reapplyMessages[database.Id] = (true,
                "Cluster resource applied. Prometheus needs a scrape cycle (about a minute) before metrics appear — then refresh.");
        }
        catch (OperationCanceledException)
        {
            reapplyMessages[database.Id] = (false, "Cancelled — nothing was changed.");
        }
        catch (Exception ex)
        {
            reapplyMessages[database.Id] = (false, ex.Message);
        }
        finally
        {
            reapplying = null;
        }
    }
}
