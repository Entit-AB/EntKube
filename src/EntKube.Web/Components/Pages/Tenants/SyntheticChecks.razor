@using EntKube.Web.Data
@using EntKube.Web.Data.Modules
@using EntKube.Web.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<TelemetryDbContext> DbFactory
@inject SyntheticCheckService Checks

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h6 class="mb-0">Synthetic checks</h6>
        <small class="text-muted">Request a public URL on a schedule and raise an incident when it stops answering as expected.</small>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-secondary" @onclick="ReloadAsync"><span class="bi bi-arrow-clockwise"></span> Refresh</button>
        <button class="btn btn-sm btn-primary" disabled="@(clusters.Count == 0)" @onclick="StartNew"><span class="bi bi-plus-lg me-1"></span>New check</button>
    </div>
</div>

@if (editing is not null)
{
    <div class="card card-body mb-3">
        <div class="row g-2">
            <div class="col-md-4">
                <label class="form-label small mb-1" for="check-name">Name</label>
                <input id="check-name" class="form-control form-control-sm" @bind="editing.Name" placeholder="e.g. Storefront home page" />
            </div>
            <div class="col-md-8">
                <label class="form-label small mb-1" for="check-url">URL</label>
                <input id="check-url" class="form-control form-control-sm font-monospace" @bind="editing.Url" placeholder="https://www.example.com/health" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1" for="check-status">Expected status</label>
                <input id="check-status" type="number" class="form-control form-control-sm" @bind="editing.ExpectedStatus" placeholder="any 2xx or 3xx" />
            </div>
            <div class="col-md-9">
                <label class="form-label small mb-1" for="check-text">Expected text (optional)</label>
                <input id="check-text" class="form-control form-control-sm" @bind="editing.ExpectedText" placeholder="Text the response must contain" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1" for="check-interval">Every</label>
                <select id="check-interval" class="form-select form-select-sm" @bind="editing.IntervalSeconds">
                    <option value="60">1 minute</option>
                    <option value="300">5 minutes</option>
                    <option value="900">15 minutes</option>
                    <option value="3600">1 hour</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1" for="check-failures">Alert after failures in a row</label>
                <input id="check-failures" type="number" min="1" class="form-control form-control-sm" @bind="editing.FailuresBeforeAlert" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1" for="check-severity">Severity</label>
                <select id="check-severity" class="form-select form-select-sm" @bind="editing.Severity">
                    <option value="critical">critical</option>
                    <option value="warning">warning</option>
                    <option value="info">info</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1" for="check-cluster">File incidents against</label>
                <select id="check-cluster" class="form-select form-select-sm" @bind="editing.ClusterId">
                    @foreach (ClusterOption c in clusters)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-12 d-flex align-items-center gap-2 mt-2">
                <button class="btn btn-sm btn-primary" @onclick="SaveAsync">Save</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => editing = null">Cancel</button>
                @if (problem is not null)
                {
                    <span class="small text-danger" role="alert">@problem</span>
                }
            </div>
        </div>
    </div>
}

@if (clusters.Count == 0)
{
    <div class="text-muted small py-3">Register a cluster first: incidents from a check are filed against one.</div>
}
else if (rows.Count == 0 && editing is null)
{
    <div class="text-center py-5 text-muted">
        <span class="bi bi-activity display-6 d-block mb-2 opacity-25"></span>
        No checks yet. Create one to find out when a site stops answering.
    </div>
}
else if (rows.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-sm align-middle small">
            <thead><tr><th>Name</th><th>URL</th><th>Status</th><th class="text-end">Uptime 24h</th><th class="text-end">Response</th><th>Last run</th><th>Enabled</th><th></th></tr></thead>
            <tbody>
                @foreach (SyntheticCheckRow row in rows)
                {
                    SyntheticCheck c = row.Check;
                    <tr class="@(c.IsEnabled ? "" : "text-muted")">
                        <td class="fw-semibold">@c.Name</td>
                        <td class="font-monospace text-truncate" style="max-width:280px" title="@c.Url">@c.Url</td>
                        <td>
                            <span class="badge @StateBadge(c.State)">@StateLabel(c.State)</span>
                            @if (c.State == SyntheticCheckState.Failing && c.LastFailure is not null)
                            {
                                <div class="text-danger">@c.LastFailure</div>
                            }
                        </td>
                        <td class="text-end">@Percent(row.UptimePercent)</td>
                        <td class="text-end text-nowrap">@(c.LastDurationMs is { } ms ? $"{ms} ms" : "—")</td>
                        <td class="text-nowrap">@(c.LastRunAt?.ToString("yyyy-MM-dd HH:mm") ?? "not yet")</td>
                        <td>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" aria-label="Enabled" checked="@c.IsEnabled" @onchange="e => ToggleAsync(c, (bool)e.Value!)" />
                            </div>
                        </td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-link p-0 me-2" @onclick="() => StartEdit(c)">Edit</button>
                            <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => DeleteAsync(c)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public required Guid TenantId { get; set; }

    private List<SyntheticCheckRow> rows = [];
    private List<ClusterOption> clusters = [];
    private SyntheticCheck? editing;
    private string? problem;

    protected override async Task OnInitializedAsync()
    {
        await using TelemetryDbContext db = await DbFactory.CreateDbContextAsync();
        clusters = await db.KubernetesClusters
            .Where(c => c.TenantId == TenantId)
            .OrderBy(c => c.Name)
            .Select(c => new ClusterOption(c.Id, c.Name))
            .ToListAsync();

        await ReloadAsync();
    }

    private async Task ReloadAsync() => rows = await Checks.ListAsync(TenantId);

    private void StartNew()
    {
        problem = null;
        editing = new SyntheticCheck { ClusterId = clusters[0].Id };
    }

    private void StartEdit(SyntheticCheck c)
    {
        problem = null;
        // A copy, so a cancelled edit leaves the row as it was.
        editing = new SyntheticCheck
        {
            Id = c.Id, ClusterId = c.ClusterId, Name = c.Name, Url = c.Url, ExpectedStatus = c.ExpectedStatus,
            ExpectedText = c.ExpectedText, IntervalSeconds = c.IntervalSeconds,
            FailuresBeforeAlert = c.FailuresBeforeAlert, Severity = c.Severity, IsEnabled = c.IsEnabled,
        };
    }

    private async Task SaveAsync()
    {
        if (editing is null) return;

        problem = await Checks.SaveAsync(TenantId, editing);

        if (problem is null)
        {
            editing = null;
            await ReloadAsync();
        }
    }

    private async Task ToggleAsync(SyntheticCheck c, bool enabled)
    {
        StartEdit(c);
        editing!.IsEnabled = enabled;
        problem = await Checks.SaveAsync(TenantId, editing);
        editing = problem is null ? null : editing;
        await ReloadAsync();
    }

    private async Task DeleteAsync(SyntheticCheck c)
    {
        await Checks.DeleteAsync(TenantId, c.Id);
        await ReloadAsync();
    }

    private static string StateLabel(SyntheticCheckState state) => state switch
    {
        SyntheticCheckState.Passing => "Passing",
        SyntheticCheckState.Failing => "Failing",
        _ => "Not run yet",
    };

    private static string StateBadge(SyntheticCheckState state) => state switch
    {
        SyntheticCheckState.Passing => "bg-success",
        SyntheticCheckState.Failing => "bg-danger",
        _ => "bg-secondary",
    };

    private static string Percent(double? value) =>
        value is { } p ? p.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%" : "—";

    private sealed record ClusterOption(Guid Id, string Name);
}
