@using EntKube.Web.Data
@using EntKube.Web.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<EntKube.Web.Data.Modules.TelemetryDbContext> DbFactory
@inject EntKube.Contracts.Delivery.IDeliveryApi Delivery
@inject IncidentService IncidentService

@* Health / uptime / SLA dashboard for a single customer. Self-loading so it can be
   dropped into the customer portal's Monitoring panel without the host wiring data. *@

@if (isLoading)
{
    <div class="text-center py-4">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <div class="text-muted small mt-2">Loading status…</div>
    </div>
}
else if (rows.Count == 0)
{
    <div class="text-muted small">No deployments to report on yet.</div>
}
else
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body py-3">
                    <div class="text-muted small text-uppercase">Applications</div>
                    <div class="display-6 fw-semibold">@rows.Count</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body py-3">
                    <div class="text-muted small text-uppercase">Healthy</div>
                    <div class="display-6 fw-semibold text-success">@HealthyCount</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body py-3">
                    <div class="text-muted small text-uppercase">Needs attention</div>
                    <div class="display-6 fw-semibold @(AttentionCount > 0 ? "text-danger" : "text-muted")">@AttentionCount</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body py-3">
                    <div class="text-muted small text-uppercase">Active alerts</div>
                    <div class="display-6 fw-semibold @(TotalAlerts > 0 ? "text-danger" : "text-muted")">@TotalAlerts</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Application</th>
                        <th>Health</th>
                        <th>Uptime (7d)</th>
                        <th>Uptime (30d)</th>
                        <th>SLA Target</th>
                        <th>Active Alerts</th>
                        <th>Last Sync</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (StatusRow row in rows)
                    {
                        <tr>
                            <td class="fw-semibold">@row.AppName</td>
                            <td>@HealthBadge(row.WorstHealth)</td>
                            <td>
                                @if (row.Uptime7d.HasValue)
                                {
                                    <span class="fw-semibold @UptimeColor(row.Uptime7d.Value, row.SlaTarget)">@row.Uptime7d.Value.ToString("F2")%</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (row.Uptime30d.HasValue)
                                {
                                    <span class="fw-semibold @UptimeColor(row.Uptime30d.Value, row.SlaTarget)">@row.Uptime30d.Value.ToString("F2")%</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-muted small">
                                @if (row.SlaTarget.HasValue)
                                {
                                    bool met30 = !row.Uptime30d.HasValue || row.Uptime30d.Value >= row.SlaTarget.Value;
                                    <span class="@(met30 ? "text-success" : "text-danger")">
                                        <i class="bi bi-@(met30 ? "check" : "exclamation-triangle") me-1"></i>@row.SlaTarget.Value.ToString("F1")%
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (row.ActiveAlerts > 0)
                                {
                                    <span class="badge bg-danger">@row.ActiveAlerts</span>
                                }
                                else
                                {
                                    <span class="text-success small"><i class="bi bi-check-circle me-1"></i>None</span>
                                }
                            </td>
                            <td class="text-muted small">
                                @(row.LastSync.HasValue ? row.LastSync.Value.ToLocalTime().ToString("MMM d HH:mm") : "—")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="text-muted small mt-2 text-end">
        Refreshed @lastRefreshed.ToLocalTime().ToString("HH:mm:ss") · Health snapshots every 5 minutes
    </div>
}

@code {
    [Parameter] public Customer Customer { get; set; } = null!;

    private List<StatusRow> rows = [];
    private bool isLoading = true;
    private DateTime lastRefreshed;
    private Guid loadedCustomerId;

    private int HealthyCount => rows.Count(r => r.WorstHealth == HealthStatus.Healthy);
    private int AttentionCount => rows.Count(r =>
        r.WorstHealth is HealthStatus.Degraded or HealthStatus.Missing or HealthStatus.Unknown);
    private int TotalAlerts => rows.Sum(r => r.ActiveAlerts);

    protected override async Task OnParametersSetAsync()
    {
        if (Customer is null || Customer.Id == loadedCustomerId) return;
        loadedCustomerId = Customer.Id;
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        // ⚠️ This page was on ApplicationDbContext for one reason: it needed Delivery's
        // deployments and health snapshots AND Telemetry's incidents, and no module context has
        // all three. Delivery's two are asked through IDeliveryApi now, so the only tables read
        // directly are Telemetry's own — which is what the context below is.
        // docs/decomposition.md §4.0.2.
        HashSet<Guid> appIds = Customer.Apps.Select(a => a.Id).ToHashSet();

        List<EntKube.Contracts.Delivery.DeploymentSummary> deployments =
            [.. (await Delivery.GetDeploymentsForTenantAsync(Customer.TenantId))
                .Where(d => appIds.Contains(d.AppId))];

        List<Guid> deploymentIds = deployments.Select(d => d.Id).ToList();

        DateTime now = DateTime.UtcNow;
        DateTime from30 = now.AddDays(-30);
        DateTime from7 = now.AddDays(-7);

        // One call per window, each counted in SQL. This used to pull every snapshot of the last
        // 30 days — one row per deployment per five minutes — and count them in memory, which is
        // what GetHealthRatiosAsync was added for.
        Dictionary<Guid, EntKube.Contracts.Delivery.DeploymentHealthRatio> ratio30 =
            (await Delivery.GetHealthRatiosAsync(Customer.TenantId, deploymentIds, from30, now))
                .ToDictionary(r => r.DeploymentId);

        Dictionary<Guid, EntKube.Contracts.Delivery.DeploymentHealthRatio> ratio7 =
            (await Delivery.GetHealthRatiosAsync(Customer.TenantId, deploymentIds, from7, now))
                .ToDictionary(r => r.DeploymentId);

        List<Guid> clusterIds = deployments.Select(d => d.ClusterId).Distinct().ToList();

        // Opened here rather than at the top: the only tables read through it are Telemetry's own,
        // and holding a context open across the contract calls above keeps a second DbContext on
        // the same connection for no reason.
        using EntKube.Web.Data.Modules.TelemetryDbContext db = DbFactory.CreateDbContext();
        List<(Guid ClusterId, string LabelsJson)> activeIncidentLabels = await db.AlertIncidents
            .Where(i => clusterIds.Contains(i.ClusterId)
                     && (i.Status == IncidentStatus.Active || i.Status == IncidentStatus.Acknowledged))
            .Select(i => new ValueTuple<Guid, string>(i.ClusterId, i.LabelsJson))
            .ToListAsync();

        rows = [];
        foreach (EntKube.Web.Data.App app in Customer.Apps.OrderBy(a => a.Name))
        {
            List<EntKube.Contracts.Delivery.DeploymentSummary> appDeployments =
                deployments.Where(d => d.AppId == app.Id).ToList();
            if (appDeployments.Count == 0) continue;

            // ⚠️ There are two HealthStatus enums — Data's and the Delivery contract's — and the
            // cast between them is safe only because ModuleApiTests pins Enum.GetNames of both to
            // be equal IN ORDER, which fixes the names and the ordinals together. Without that a
            // same-named enum with a reordered member would silently relabel every app's health.
            //
            // In memory, never inside an EF Expression: a cast on a string-stored enum emits
            // CAST(... AS integer), which is 22P02 on Postgres and a silent 0 on SQLite.
            // DeliveryApi carries the same note at its own mapping.
            HealthStatus worstHealth = (HealthStatus)(int)appDeployments
                .Select(d => d.HealthStatus)
                .OrderByDescending(h => (int)h)
                .FirstOrDefault();

            DateTime? lastSync = appDeployments
                .Where(d => d.LastSyncedAt.HasValue)
                .Max(d => d.LastSyncedAt);

            // ⚠️ A true mean across the app's deployments. This was a running pairwise mean —
            // `u = u.HasValue ? (u + pct) / 2 : pct` — which for three deployments gives
            // a/4 + b/4 + c/2: the last one counted double and the first a quarter. Correct for
            // one or two deployments and wrong for every app with more, on a figure a customer
            // reads as their own uptime. The order of Customer.Apps' deployments decided the
            // answer, which is why nobody could have noticed it from the number alone.
            List<double> pct7 = [], pct30 = [];

            foreach (EntKube.Contracts.Delivery.DeploymentSummary dep in appDeployments)
            {
                if (ratio7.TryGetValue(dep.Id, out EntKube.Contracts.Delivery.DeploymentHealthRatio? r7)
                    && r7.TotalSamples > 0)
                {
                    pct7.Add((double)r7.HealthySamples / r7.TotalSamples * 100);
                }

                if (ratio30.TryGetValue(dep.Id, out EntKube.Contracts.Delivery.DeploymentHealthRatio? r30)
                    && r30.TotalSamples > 0)
                {
                    pct30.Add((double)r30.HealthySamples / r30.TotalSamples * 100);
                }
            }

            double? uptime7d = pct7.Count > 0 ? pct7.Average() : null;
            double? uptime30d = pct30.Count > 0 ? pct30.Average() : null;

            HashSet<Guid> appClusterIds = appDeployments.Select(d => d.ClusterId).ToHashSet();
            // Namespace is nullable on the contract's summary where the entity's was not, so the
            // empties are dropped rather than matched against an incident label that cannot be "".
            HashSet<string> appNamespaces = [.. appDeployments
                .Select(d => d.Namespace)
                .Where(n => !string.IsNullOrEmpty(n))
                .Select(n => n!)];
            int activeAlerts = activeIncidentLabels
                .Where(x => appClusterIds.Contains(x.ClusterId))
                .Count(x =>
                {
                    try
                    {
                        using var doc = System.Text.Json.JsonDocument.Parse(x.LabelsJson);
                        return doc.RootElement.TryGetProperty("namespace", out var ns)
                               && appNamespaces.Contains(ns.GetString() ?? "");
                    }
                    catch { return false; }
                });

            SlaTarget? sla = await IncidentService.GetSlaTargetAsync(
                Customer.TenantId, Customer.Id, app.Id);

            rows.Add(new StatusRow(
                app.Name,
                worstHealth,
                uptime7d.HasValue ? Math.Round(uptime7d.Value, 2) : null,
                uptime30d.HasValue ? Math.Round(uptime30d.Value, 2) : null,
                sla?.TargetPercent,
                activeAlerts,
                lastSync));
        }

        lastRefreshed = DateTime.UtcNow;
        isLoading = false;
    }

    private static string UptimeColor(double pct, double? slaTarget)
    {
        double threshold = slaTarget ?? 99.0;
        if (pct >= threshold) return "text-success";
        if (pct >= threshold - 2) return "text-warning";
        return "text-danger";
    }

    private static RenderFragment HealthBadge(HealthStatus health) => health switch
    {
        HealthStatus.Healthy    => @<span class="badge bg-success">Healthy</span>,
        HealthStatus.Progressing => @<span class="badge bg-primary">Progressing</span>,
        HealthStatus.Degraded   => @<span class="badge bg-warning text-dark">Degraded</span>,
        HealthStatus.Suspended  => @<span class="badge bg-secondary">Suspended</span>,
        HealthStatus.Missing    => @<span class="badge bg-danger">Missing</span>,
        _ => @<span class="badge bg-secondary">Unknown</span>
    };

    private record StatusRow(
        string AppName,
        HealthStatus WorstHealth,
        double? Uptime7d,
        double? Uptime30d,
        double? SlaTarget,
        int ActiveAlerts,
        DateTime? LastSync);
}
