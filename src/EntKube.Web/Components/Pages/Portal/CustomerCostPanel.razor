@using EntKube.Web.Data
@using EntKube.Web.Services.Cost
@inject CostScanCache ScanCache
@inject CostLedgerService Ledger

@* Customer-facing consumption and cost. Reads the cached tenant report and shows
   ONLY this customer's rows — a customer must never see another's figures, nor the
   tenant's platform overhead as a line of its own. *@

@if (report is null)
{
    <div class="text-muted small">
        Consumption figures are not available yet. They are recalculated hourly.
    </div>
}
else if (apps.Count == 0 && shared.Count == 0)
{
    <div class="text-muted small">No consumption recorded for your workloads yet.</div>
}
else
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body py-3">
                    <div class="text-muted small text-uppercase">Monthly run rate</div>
                    <div class="display-6 fw-semibold">@Money(TotalMonthly)</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body py-3">
                    <div class="text-muted small text-uppercase">Spent, last 30 days</div>
                    @if (spent is null)
                    {
                        <div class="display-6 fw-semibold text-muted">—</div>
                        <div class="text-muted small">not recorded yet</div>
                    }
                    else
                    {
                        <div class="display-6 fw-semibold">@Spent(spent.TotalCost)</div>
                        <div class="text-muted small">
                            @if (spent.PreviousTotalCost > 0m)
                            {
                                <span class="@(spent.Change > 0m ? "text-danger" : spent.Change < 0m ? "text-success" : "")">
                                    @($"{(spent.Change > 0m ? "+" : "")}{spent.ChangeFraction * 100:N0}%")
                                </span>
                                <span>on the 30 days before</span>
                            }
                            else
                            {
                                <span>actually incurred</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body py-3">
                    <div class="text-muted small text-uppercase">CPU reserved</div>
                    <div class="display-6 fw-semibold">@TotalCpu.ToString("N1")</div>
                    <div class="text-muted small">cores</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body py-3">
                    <div class="text-muted small text-uppercase">Memory reserved</div>
                    <div class="display-6 fw-semibold">@TotalMemory.ToString("N0")</div>
                    <div class="text-muted small">GiB</div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr class="text-muted small">
                    <th>Application</th>
                    <th>Environment</th>
                    <th class="text-end">CPU</th>
                    <th class="text-end">Memory</th>
                    <th class="text-end">Storage</th>
                    <th class="text-end" title="What your own workloads consume.">Direct</th>
                    <th class="text-end" title="Your share of the shared platform these workloads run on — ingress, monitoring, backups and the cluster itself.">Platform</th>
                    <th class="text-end">Monthly</th>
                </tr>
            </thead>
            <tbody>
                @foreach (AppCost app in apps)
                {
                    <tr>
                        <td class="small">@app.AppName</td>
                        <td class="small text-muted">
                            @(app.Environments.Count > 0 ? string.Join(", ", app.Environments) : "—")
                        </td>
                        <td class="text-end small text-muted">@app.CpuCores.ToString("N2")</td>
                        <td class="text-end small text-muted">@app.MemoryGiB.ToString("N1") Gi</td>
                        <td class="text-end small text-muted">@app.StorageGiB.ToString("N0") Gi</td>
                        <td class="text-end small text-muted">@Money(app.DirectMonthlyCost)</td>
                        <td class="text-end small text-muted">@Money(app.SharedMonthlyCost)</td>
                        <td class="text-end fw-semibold">@Money(app.TotalMonthlyCost)</td>
                    </tr>
                }

                @* Namespaces running more than one application. Measurement is per
                   namespace, so these are shown as they are measured rather than split. *@
                @foreach (NamespaceCost row in shared)
                {
                    <tr>
                        <td class="small">
                            <code>@row.Namespace</code>
                            <div class="text-muted">@row.AppName</div>
                        </td>
                        <td class="small text-muted">@(row.EnvironmentName ?? "—")</td>
                        <td class="text-end small text-muted">@row.CpuCores.ToString("N2")</td>
                        <td class="text-end small text-muted">@row.MemoryGiB.ToString("N1") Gi</td>
                        <td class="text-end small text-muted">@row.StorageGiB.ToString("N0") Gi</td>
                        <td class="text-end small text-muted">@Money(row.DirectMonthlyCost)</td>
                        <td class="text-end small text-muted">@Money(row.SharedMonthlyCost)</td>
                        <td class="text-end fw-semibold">@Money(row.TotalMonthlyCost)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="7" class="text-end fw-semibold">Total</td>
                    <td class="text-end fw-semibold">@Money(TotalMonthly)</td>
                </tr>
            </tfoot>
        </table>
    </div>

    @if (spentMonths.Count > 1)
    {
        <h6 class="small text-muted fw-semibold mt-4">What your workloads cost, by month</h6>
        <table class="table table-sm mb-0" style="max-width:26rem">
            <tbody>
                @foreach (CostMonth month in spentMonths.AsEnumerable().Reverse())
                {
                    <tr>
                        <td class="small">@month.Label</td>
                        <td class="text-end small fw-medium">@Spent(month.Cost)</td>
                        <td class="small text-muted text-end">
                            @if (!month.IsComplete)
                            {
                                <span title="Part of this month was not measured, so this is lower than what ran.">
                                    partial
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <p class="text-muted small mt-3 mb-1">
        <strong>Platform</strong> is your share of the shared infrastructure your workloads run on —
        ingress, monitoring, logging and the cluster itself. It is apportioned by how much CPU,
        memory and storage you hold relative to everything else running there, so it moves with your
        own footprint rather than being a flat fee.
    </p>
    <p class="text-muted small mb-0">
        The <strong>run rate</strong> is what your current reservations project to over a 730-hour
        month, as of @report.GeneratedAt.ToString("yyyy-MM-dd HH:mm") UTC; it changes when workloads
        are scaled or redeployed. The <strong>spend</strong> figures are what your workloads actually
        consumed over the days shown. Neither is an invoice.
    </p>
}

@code {
    [Parameter] public required Customer Customer { get; set; }

    private CostReport? report;

    /// <summary>This customer's apps, largest first.</summary>
    private List<AppCost> apps = [];

    /// <summary>
    /// This customer's namespaces that run more than one of their apps. Billed to them,
    /// but not divisible between those apps, so they are listed by namespace instead of
    /// being folded into one app's figure.
    /// </summary>
    private List<NamespaceCost> shared = [];

    /// <summary>
    /// What this customer actually accrued over the last 30 days, as opposed to what
    /// their current reservations project to. Null until the ledger has recorded
    /// something — which reads as "not recorded yet" rather than as zero, because a
    /// customer told they spent nothing would reasonably expect no invoice.
    /// </summary>
    private CostHistoryReport? spent;

    private IReadOnlyList<CostMonth> spentMonths = [];

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            DateTime now = DateTime.UtcNow;

            // Scoped to this customer inside the query, not filtered afterwards: the
            // panel must never hold another customer's figures, even briefly.
            spent = await Ledger.HasAnyAsync(Customer.TenantId)
                ? await Ledger.GetHistoryAsync(
                    Customer.TenantId, now.AddDays(-29), now, CostGroupBy.App, now,
                    customerId: Customer.Id)
                : null;

            spentMonths = spent is null
                ? []
                : [.. (await Ledger.GetMonthlyAsync(Customer.TenantId, months: 6, now, customerId: Customer.Id))
                    .Where(m => m.Cost > 0m)];
        }
        catch
        {
            // Cost history is supplementary here; the run rate above is the panel's
            // purpose and must still render if the ledger cannot be read.
            spent = null;
            spentMonths = [];
        }
    }

    protected override void OnParametersSet()
    {
        report = ScanCache.Get(Customer.TenantId);

        // Filter to this customer only. Pooled platform namespaces are excluded as well
        // as other customers': this customer's share of them is already inside their own
        // rows, and the rest is not theirs to see.
        apps = report is null
            ? []
            : [.. report.ByApp
                .Where(a => a.CustomerId == Customer.Id)
                .OrderByDescending(a => a.TotalMonthlyCost)];

        shared = report is null
            ? []
            : [.. report.Billed
                .Where(n => n.CustomerId == Customer.Id && n.IsMultiApp)
                .OrderByDescending(n => n.TotalMonthlyCost)];
    }

    private decimal TotalMonthly =>
        apps.Sum(a => a.TotalMonthlyCost) + shared.Sum(n => n.TotalMonthlyCost);

    private double TotalCpu => apps.Sum(a => a.CpuCores) + shared.Sum(n => n.CpuCores);

    private double TotalMemory => apps.Sum(a => a.MemoryGiB) + shared.Sum(n => n.MemoryGiB);

    private string Money(decimal value) => $"{value:N2} {report?.Currency ?? ""}".Trim();

    /// <summary>
    /// Formats a historical amount in the currency the ledger recorded it in, which need
    /// not be the one the fleet is priced in today.
    /// </summary>
    private string Spent(decimal value) => $"{value:N2} {spent?.Currency ?? ""}".Trim();
}
