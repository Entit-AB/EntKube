@using EntKube.Web.Data
@using EntKube.Web.Services
@using EntKube.Web.Components.Pages.Shared
@inject PortalServiceScopeService Scope
@inject RedisService RedisService
@inject ToastService Toasts

@* ═══════════════════════════════════════════════════════════════════
   Portal → App → Cache.

   Read-only by design: a customer can see which cache service backs their app,
   how healthy it is and which secret carries the connection details, but the
   shape and lifecycle of a Redis cluster stays with the service provider.
   Re-syncing the credentials secret is the one action offered — it rewrites the
   app's own Kubernetes secret from the vault and changes nothing on the cache.
   ═══════════════════════════════════════════════════════════════════ *@

<div class="d-flex align-items-center mb-3">
    <i class="bi bi-lightning fs-4 me-2 text-warning"></i>
    <div>
        <h4 class="mb-0">Cache — @App.Name</h4>
        <small class="text-muted">@Environment.Name</small>
    </div>
    <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="Reload" disabled="@loading">
        <i class="bi bi-arrow-clockwise me-1"></i>Refresh
    </button>
</div>

@if (loading)
{
    <div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>
}
else if (loadError is not null)
{
    <div class="alert alert-danger py-2 small">
        <i class="bi bi-exclamation-triangle me-1"></i>Could not load your cache services: @loadError
    </div>
}
else if (scope is null || scope.IsEmpty)
{
    <EmptyState Icon="bi-lightning"
                Title="No cache service attached"
                Message="This app is not connected to a Redis cache in this environment. Ask your service provider to attach one." />
}
else
{
    @foreach (RedisCluster cluster in scope.Clusters)
    {
        RedisClusterDetail? detail = details.GetValueOrDefault(cluster.Id);
        List<CacheBinding> bindings = scope.Bindings.Where(b => b.RedisClusterId == cluster.Id).ToList();

        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white py-2">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <i class="bi bi-lightning text-warning"></i>
                    <strong>@cluster.Name</strong>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Redis @cluster.RedisVersion</span>
                    <span class="text-muted small">
                        <i class="bi bi-hdd-network me-1"></i>@cluster.KubernetesCluster?.Name
                        <i class="bi bi-box ms-2 me-1"></i>@cluster.Namespace
                    </span>
                    <span class="ms-auto">
                        @if (detail is null)
                        {
                            <span class="spinner-border spinner-border-sm text-muted"></span>
                        }
                        else
                        {
                            <span class="badge @PhaseClass(detail.Phase)">@detail.Phase</span>
                        }
                    </span>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-3 mb-3">
                    <div class="col-auto">
                        <div class="text-muted small">Nodes</div>
                        <div class="fw-medium">
                            @if (detail is null) { <span class="text-muted">—</span> }
                            else { @($"{detail.ReadyLeaders} leader(s), {detail.ReadyFollowers} follower(s)") }
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="text-muted small">Size</div>
                        <div class="fw-medium">@cluster.ClusterSize</div>
                    </div>
                    <div class="col-auto">
                        <div class="text-muted small">Storage</div>
                        <div class="fw-medium">@cluster.StorageSize @(cluster.PersistenceEnabled ? "" : "(ephemeral)")</div>
                    </div>
                </div>

                @if (detail is { Pods.Count: > 0 })
                {
                    <div class="table-responsive mb-3">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Pod</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th class="text-end">Restarts</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (RedisPodInfo pod in detail.Pods)
                                {
                                    <tr>
                                        <td><code class="small">@pod.Name</code></td>
                                        <td>@pod.Role</td>
                                        <td>
                                            <span class="badge @(pod.Ready ? "bg-success-subtle text-success border border-success-subtle" : "bg-warning text-dark") small">
                                                @pod.Status
                                            </span>
                                        </td>
                                        <td class="text-end">@pod.Restarts</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="small fw-medium mb-1"><i class="bi bi-key me-1 text-muted"></i>Connection secrets</div>
                @if (bindings.Count == 0)
                {
                    <p class="text-muted small mb-0">
                        This cache is available to your app but no deployment is wired to it yet.
                        Ask your service provider to connect it.
                    </p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Deployment</th>
                                    <th>Kubernetes secret</th>
                                    <th>Last synced</th>
                                    @if (CanSync) { <th class="text-end">Actions</th> }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (CacheBinding b in bindings)
                                {
                                    <tr>
                                        <td>
                                            <i class="bi bi-rocket-takeoff text-primary me-1"></i>@DeploymentName(b.AppDeploymentId)
                                            <br /><small class="text-muted">@DeploymentNamespace(b.AppDeploymentId)</small>
                                        </td>
                                        <td><code class="small">@b.KubernetesSecretName</code></td>
                                        <td>
                                            @if (b.LastSyncedAt is null)
                                            {
                                                <span class="badge bg-warning text-dark small">Never synced</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">@b.LastSyncedAt.Value.ToString("MMM d, HH:mm")</span>
                                            }
                                        </td>
                                        @if (CanSync)
                                        {
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-success" @onclick="() => SyncBinding(b)"
                                                        disabled="@syncing.Contains(b.Id)">
                                                    @if (syncing.Contains(b.Id)) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                                    else { <i class="bi bi-cloud-arrow-up me-1"></i> }
                                                    Sync
                                                </button>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

    <p class="text-muted small">
        <i class="bi bi-eye me-1"></i>Cache services are read-only here — attaching, resizing and upgrading them
        is handled by your service provider.
    </p>
}

@code {
    [Parameter, EditorRequired] public Data.App App { get; set; } = null!;
    [Parameter, EditorRequired] public Data.Environment Environment { get; set; } = null!;
    [Parameter, EditorRequired] public Guid TenantId { get; set; }
    [Parameter] public CustomerAccessRole AccessRole { get; set; } = CustomerAccessRole.Viewer;

    private bool CanSync => AccessRole >= CustomerAccessRole.Operator;

    private PortalCacheScope? scope;
    private bool loading = true;
    private string? loadError;
    private readonly Dictionary<Guid, RedisClusterDetail> details = [];
    private readonly HashSet<Guid> syncing = [];

    // The parent re-renders on every tree interaction, so only reload when the panel is
    // actually pointed at a different app or environment.
    private (Guid App, Guid Env)? loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == (App.Id, Environment.Id)) return;
        loadedFor = (App.Id, Environment.Id);
        await Reload();
    }

    private async Task Reload()
    {
        loading = true;
        details.Clear();
        StateHasChanged();

        loadError = null;
        try
        {
            scope = await Scope.GetCacheScopeAsync(TenantId, App.Id, Environment.Id);
        }
        catch (Exception ex)
        {
            // Surfaced in the panel rather than thrown: an unhandled exception in a
            // component lifecycle method tears down the whole portal circuit.
            scope = null;
            loadError = ex.Message;
        }
        loading = false;
        StateHasChanged();

        foreach (RedisCluster cluster in scope?.Clusters ?? [])
        {
            try
            {
                RedisClusterDetail? detail = await RedisService.GetClusterDetailAsync(TenantId, cluster.Id);
                if (detail is not null) details[cluster.Id] = detail;
            }
            catch
            {
                // A cluster we can't reach still shows its stored shape; the phase badge
                // simply stays on the spinner rather than failing the whole page.
            }
            StateHasChanged();
        }
    }

    private string DeploymentName(Guid id) =>
        scope?.Deployments.FirstOrDefault(d => d.Id == id)?.Name ?? "deployment";

    private string DeploymentNamespace(Guid id) =>
        scope?.Deployments.FirstOrDefault(d => d.Id == id)?.Namespace ?? "";

    private static string PhaseClass(string phase) => phase switch
    {
        "Ready" or "Healthy" => "bg-success-subtle text-success border border-success-subtle",
        "Failed" or "Error" => "bg-danger-subtle text-danger border border-danger-subtle",
        _ => "bg-secondary-subtle text-secondary border border-secondary-subtle",
    };

    private async Task SyncBinding(CacheBinding binding)
    {
        if (!CanSync || scope?.Bindings.Any(b => b.Id == binding.Id) != true) return;
        syncing.Add(binding.Id);
        try
        {
            await RedisService.SyncCacheBindingAsync(TenantId, binding.Id);
            Toasts.Success($"Connection secret '{binding.KubernetesSecretName}' synced.");
            scope = await Scope.GetCacheScopeAsync(TenantId, App.Id, Environment.Id);
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message, "Sync failed");
        }
        finally
        {
            syncing.Remove(binding.Id);
        }
    }
}
