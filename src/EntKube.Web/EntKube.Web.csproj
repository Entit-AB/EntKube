<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-EntKube_Web-ea23db09-ba7f-4040-8763-fa444f800e95</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
      <!-- Opts in to the System.Security.Cryptography.Pkcs pin (CVE-2026-84008); MailKit pulls it. -->
    <UsesMailKit>true</UsesMailKit>
</PropertyGroup>

  <ItemGroup>
    <!-- The segment engine moved to its own assembly (docs/telemetry-in-cluster.md). A global using
         keeps every existing consumer compiling against the new namespace without a per-file edit. -->
    <Using Include="EntKube.Telemetry" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\app.db" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.23.3" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Cronos" Version="0.8.4" />
    <PackageReference Include="HtmlSanitizer" Version="11.0.26" />
    <PackageReference Include="KubernetesClient" Version="19.0.2" />
    <PackageReference Include="Lucene.Net" Version="4.8.0-beta00017" />
    <PackageReference Include="Lucene.Net.Analysis.Common" Version="4.8.0-beta00017" />
    <PackageReference Include="LibGit2Sharp" Version="0.30.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.8" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <PackageReference Include="YamlDotNet" Version="17.1.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.1" />
    <ProjectReference Include="..\EntKube.Telemetry\EntKube.Telemetry.csproj" />
    <ProjectReference Include="..\EntKube.Contracts\EntKube.Contracts.csproj" />
    <ProjectReference Include="..\EntKube.Web.Client\EntKube.Web.Client.csproj" />
    <ProjectReference Include="..\EntKube.Agents.Protocol\EntKube.Agents.Protocol.csproj" />
    <!--
      ⚠️ 10.0.14, not 10.0.13, because of CVE-2026-102870 (GHSA-g27p-qf6j-c96c, high): the
      Blazor WebAssembly debug proxy compiles generated C# to evaluate debugger
      expressions, and embeds values from the app being debugged — ToString() results,
      descriptions, class names — without consistent escaping. A value that escapes the
      generated string literal runs code on the DEVELOPER's machine when they evaluate an
      expression. Fixed in 10.0.14; every 10.0.x before it is in range.

      It fires as an error rather than a warning because Directory.Build.props puts NU1903
      in WarningsAsErrors, and it started firing on 2026-11-03 — the day the advisory's
      affected range was updated, not the day anything here changed. A fresh restore of
      main could not complete from then until this bump.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.1" />
  </ItemGroup>


  <!--
    CVE-2025-6965 (GHSA-2m69-gcr7-jv3q, high): SQLitePCLRaw.lib.e_sqlite3 <= 2.1.11 ships a
    vulnerable SQLite, and it arrives here transitively through Microsoft.Data.Sqlite. The advisory
    records no patched package version and the nuspecs name no SQLite version, so the versions were
    read out of the shipped native libraries rather than inferred:

        2.1.11 -> SQLite 3.49.1   (vulnerable; the fix is in 3.50.2)
        2.1.14 -> SQLite 3.54.0   (fixed)
        3.50.3 -> SQLite 3.50.3   (fixed, but the 3.x line renumbers the package to track SQLite)

    2.1.14 keeps the native library on the same package line as the managed SQLitePCLRaw.core and
    bundle that Microsoft.Data.Sqlite depends on, so nothing else has to move.

    This bump is what exposed the AlertRoutingRules rebuild in
    20260611122519_AddClusterServers (SQLite); the two changes belong together, because the pin
    without that repair breaks every fresh SQLite install.
  -->
  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>
</Project>
